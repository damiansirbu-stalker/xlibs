; xinventory protected item classes. Sections/kinds/prefixes listed here classify as
; "untouchable" in xinventory.get_section_category, so EVERY policy-kernel consumer skips them:
; inventory culling, corpse-loot trimming, stash deposit/loot, NPC barter and trade, market
; recording. Protected items stay on their carrier and circulate by loot and combat only.
; DLTX-overridable; a modpack removes or extends a class by overriding the relevant section.
; Loaded once per session on first classification.

; kind key values (ini_sys <section>.kind)
[protected_kinds]
i_arty

; section-name prefixes (string match at position 1)
[protected_prefixes]
wpn_binoc
device_torch_nv

; exact section names
[protected_sections]
