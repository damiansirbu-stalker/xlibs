--- xmath: Math utilities (random selection, sampling, flat geometry)

local math_random, math_min, type = math.random, math.min, type

--- Squared flat (XZ) distance between two position vectors - the ground-plane displacement read.
--- Squared so a radius compare needs no sqrt; flat so a height difference (stairs, a ledge) does not read as movement.
--- @safety SAFE - pure Lua field reads
--- @cost O(1) | 0 luabind (vector field math)
--- @param a vector position
--- @param b vector position
--- @return number squared XZ distance in m^2
function get_flat_dist_sqr(a, b)
    local dx, dz = a.x - b.x, a.z - b.z
    return dx * dx + dz * dz
end

--- Validate a caller-supplied position argument at a public spatial-query boundary: true iff pos is a luabind vector (userdata).
--- A non-vector type is the signature of a foreign mod shadowing the C++ position member with a Lua method; returning false avoids the CTD.
--- @src xray-monolith class_rep.cpp(1216-1253) instance/class table lookup precedes m_getters; position is a def_readwrite member on cse_abstract
--- @safety SAFE - pure type() check
--- @cost O(1) | 0 luabind (type() is a VM primitive)
--- @param pos any value to validate
--- @return boolean true if pos is a vector
function check_pos(pos)
    return type(pos) == "userdata"
end

--- True if position `pos` is within `radius` metres of (x, z) on the ground plane.
--- Flat XZ (height ignored, so a ledge or stairs does not defeat it) and squared, so no sqrt.
--- @safety SAFE - pure Lua field reads
--- @cost O(1) | 0 luabind (vector field math)
--- @param pos vector position to test
--- @param x number target X coordinate
--- @param z number target Z coordinate
--- @param radius number range in metres
--- @return boolean true if within range
function is_in_range(pos, x, z, radius)
    local dx, dz = pos.x - x, pos.z - z
    return dx * dx + dz * dz <= radius * radius
end

--- Return a random element from an array (math.random index; assumes #t > 0).
--- @safety SAFE - pure Lua, crashes on empty table (caller's responsibility)
--- @cost O(1) | 0 luabind (pure Lua: math.random + table index)
--- @param t table Array to sample from
--- @return any Random element
function select(t)
    return t[math_random(#t)]
end

--- Shuffle the first n elements of an array in-place (Fisher-Yates partial: swap each position with a random later element).
--- @safety SAFE - pure Lua, mutates input table
--- @cost O(n) | 0 luabind (pure Lua loop + math.random per step)
--- @param t table Array to shuffle
--- @param n number|nil Number of elements to shuffle (default: all)
--- @return table Same array, shuffled
function shuffle_partial(t, n)
    n = n or #t
    for i = 1, n do
        local j = math_random(i, #t)
        t[i], t[j] = t[j], t[i]
    end
    return t
end

--- Select a uniformly random NUMBER of elements from an array: k = random(1, min(n, #t)), the random-sized take being the contract.
--- For an exact-count take, use shuffle_partial directly and slice.
--- @safety SAFE - pure Lua, mutates input table
--- @cost O(n) | 0 luabind (pure Lua loop + math.random per step)
--- @param t table Source array
--- @param n number Max elements to sample
--- @return table Same array (first k elements are the sample), number k
function select_n(t, n)
    if #t == 0 then return t, 0 end
    local available = math_min(#t, n)
    shuffle_partial(t, available)
    return t, math_random(1, available)
end

