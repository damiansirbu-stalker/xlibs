--- xlibs_mcm: MCM info page for xlibs

local type, tostring, math_floor, string_format = type, tostring, math.floor, string.format

-- Latest demonized build this release is verified against; drives the MCM verdict only, never a floor.
local LATEST_DEMONIZED_VERSION = 20260912

-- xray-monolith build (YYYYMMDD) as the themrdemonized tag style, no zero padding (20260912 -> "2026.9.12").
local function _build_tag(build)
    return math_floor(build / 10000) .. "." .. (math_floor(build / 100) % 100) .. "." .. (build % 100)
end

-- Platform status line and verdict for the xlibs info-page footer.
local function _get_platform_status()
    local line = "xlibs " .. xlibs.get_version()
    local has_build = type(get_modded_exes_version) == "function"
    if type(get_aoe_version) == "function" then
        line = line .. ", AOEngine " .. tostring(get_aoe_version())
        if has_build then line = line .. ", xray-monolith " .. _build_tag(get_modded_exes_version()) end
        return line .. " (partially compatible)", "fallback"
    elseif has_build then
        local build = get_modded_exes_version()
        line = line .. ", xray-monolith " .. _build_tag(build)
        if build < LATEST_DEMONIZED_VERSION then
            return line .. " (partially compatible)", "fallback"
        end
        return line .. " (fully compatible)", "full"
    end
    return line .. " (incompatible)", "blocked"
end

local _footer_clr = nil
-- MCM footer functor: the platform line plus xlibs's update notice, verdict-colored; colors build lazily (GetARGB absent under the validator).
-- @cost 1 small file read (the stored update check) + 1 luabind (translate_string) when an update is stored
local function _get_platform_functor()
    return function(_anchor, handlers)
        if not _footer_clr then
            _footer_clr = {
                full     = GetARGB(255, 170, 220, 170),
                fallback = GetARGB(255, 230, 210, 120),
                blocked  = GetARGB(255, 220, 120, 120),
            }
        end
        local line, level = _get_platform_status()
        local newer = xlibs.find_update(xlibs.get_manifest())
        if newer then line = line .. string_format(game.translate_string("st_xlibs_update_footer"), newer) end
        handlers.desc:SetText(line)
        handlers.desc:SetTextColor(_footer_clr[level])
    end
end

function on_mcm_load()
    return {
        id = "xlibs",
        sh = true,
        gr = {
            { id = "title", type = "slide", link = "xlibs_mcm_banner",
                text = "ui_mcm_xlibs_title", size = {512, 50}, spacing = 20 },
            { id = "desc", type = "desc", text = "ui_mcm_xlibs_desc" },
            { id = "div_footer", type = "line" },
            { id = "platform", type = "desc", text = "ui_mcm_xmcm_footer",
                ui_hook_functor = { _get_platform_functor() }, clr = {255, 212, 201, 168} },        },
    }
end
