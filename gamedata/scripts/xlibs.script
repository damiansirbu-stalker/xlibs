--- xlibs: Package metadata
local tonumber = tonumber
local _VERSION = "1.8.4"

--- The unreleased development build. Between releases every mod's own version reads this instead of
--- the last released number, so a log says at a glance whether a tester runs a release or a dev
--- build (release-standards.md, "The next Version").
local DEV_VERSION = "next"

--- Major of the API this build speaks. "next" carries no number for is_compatible to compare, so a
--- dev build would otherwise answer compatible even across a breaking change; this is what it
--- compares instead. Bumped in the same commit as any breaking rename or removal, together with
--- every downstream XLIBS_MIN_VERSION (Cross-Release API Coordination, release-standards.md).
local API_MAJOR = 1

--- Get xlibs package version string
--- Constant read from module-local _VERSION literal, set at file load
--- @safety SAFE - returns a constant string literal
--- @cost O(1) | 0 luabind (return local)
--- @return string Version string (e.g. "1.5.0", or "next" between releases)
function get_version()
    return _VERSION
end

--- Check if xlibs version is compatible with required minimum (semver: same major, actual >= required)
--- Parses both required and actual as major.minor.patch via Lua pattern; rejects on major mismatch, then compares minor then patch
--- "next" is the development build and sorts above every release within its API major: it satisfies
--- any numeric requirement on that major, and no released build satisfies a required "next". Without
--- this the semver pattern would not match, act_maj would be nil, and a dev xlibs would report
--- incompatible with every consumer at once -- blocking the whole family rather than loading it.
--- The major is still enforced in dev, against API_MAJOR rather than a parsed version, so a
--- consumer pinned to an older major is rejected exactly as it would be against a release.
--- @safety SAFE - tonumber returns nil for malformed patches (defaulted to 0); required must match "^%d+%.%d+" or tonumber crashes (caller passes valid semver)
--- @cost O(1) | 0 luabind (pure Lua string.match + tonumber + integer compares)
--- @param required string Minimum version ("1.2" or "1.2.2", or "next")
--- @return boolean True if compatible
function is_compatible(required)
    if _VERSION == DEV_VERSION then return tonumber(required:match("^(%d+)")) == API_MAJOR end
    if required == DEV_VERSION then return false end
    local req_maj, req_min, req_patch = required:match("^(%d+)%.(%d+)%.?(%d*)")
    local act_maj, act_min, act_patch = _VERSION:match("^(%d+)%.(%d+)%.?(%d*)")
    req_maj, req_min = tonumber(req_maj), tonumber(req_min)
    act_maj, act_min = tonumber(act_maj), tonumber(act_min)
    req_patch = tonumber(req_patch) or 0
    act_patch = tonumber(act_patch) or 0
    if act_maj ~= req_maj then return false end
    if act_min ~= req_min then return act_min > req_min end
    return act_patch >= req_patch
end
