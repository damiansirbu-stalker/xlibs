--- xlibs: Package metadata and the update check each published mod runs for itself
local tonumber, tostring, assert, type, ipairs, rawget = tonumber, tostring, assert, type, ipairs, rawget
local os_time, os_clock, os_date, math_floor, math_abs = os.time, os.clock, os.date, math.floor, math.abs
local string_format, table_concat = string.format, table.concat
local _VERSION = "1.10.1-snapshot"

local RELEASE_API = "https://api.github.com/repos/damiansirbu-stalker/%s/releases/latest"
local MODDB_ADDON_URL = "https://www.moddb.com/mods/stalker-anomaly/addons/"
local XLIBS_MANIFEST = { name = "xlibs", version = _VERSION, moddb = "xlibs-1001" }
-- Each mod's update state lives in its own <name>_update.txt on the appdata root, as jitprofiler_keep.txt does.
local UPDATE_FILE_SUFFIX = "_update.txt"
-- The keys a state file holds: a mod's tag and checked; xlibs_update.txt also holds the launch's offline mark and the PDA day.
local UPDATE_FIELDS = { "tag", "checked", "offline", "notified" }
-- A request blocks the game thread, so the automatic checks of one load share a 5 s budget, spent on the loading screen; a click gets its own.
local LOAD_BUDGET_MS = 5000
local CLICK_BUDGET_MS = 5000
local STEP_TIMEOUT_MS = 1500
local HTTP_NOT_FOUND = 404
local HTTP_LIMITED = { [403] = true, [429] = true }
-- Two launch stamps within this many seconds are one launch; os.time and os.clock round apart by up to a second.
local LAUNCH_TOLERANCE_S = 5
local TIP_MS = 8000

-- Player text ids, all in ui_st_mcm_xlibs.xml.
local ST_NEWS_CAPTION = "st_xlibs_update_news_caption"
local ST_NEWS = "st_xlibs_update_news"
local ST_NEWER = "st_xlibs_update_newer"
local ST_CURRENT = "st_xlibs_update_current"
local ST_FAILED = "st_xlibs_update_failed"
local ST_OFFLINE = "st_xlibs_update_offline"
local ST_LIMITED = "st_xlibs_update_limited"
local ST_NO_RELEASE = "st_xlibs_update_no_release"
local ST_UNAVAILABLE = "st_xlibs_update_unavailable"
local ST_OUT_OF_TIME = "st_xlibs_update_out_of_time"
local ST_NO_NETWORK = "st_xlibs_update_no_network"
local ST_STATUS_NEWER = "st_xlibs_update_status_newer"
local ST_STATUS_CURRENT = "st_xlibs_update_status_current"
local ST_STATUS_UNCHECKED = "st_xlibs_update_status_unchecked"
local ST_STATUS_OFFLINE = "st_xlibs_update_status_offline"
-- What one update check did, returned for the caller's trace: it asked GitHub, this launch already had, or the network is out.
local OUTCOME_CHECKED, OUTCOME_SAME_LAUNCH, OUTCOME_OFFLINE, OUTCOME_NO_NETWORK = "checked", "same_launch", "offline", "no_network"

-- The end of this load's shared budget, in os.clock seconds; each load builds a fresh Lua VM, so it starts unset on every load.
local _load_deadline = nil

-- A player text from its string id, with its %s slots filled.
-- @cost 1 luabind (translate_string) + 1 format
local function _format_text(id, ...)
    return string_format(game.translate_string(id), ...)
end

-- "x.y.z" or "x.y.z-snapshot" to three numbers; nil for anything else.
local function _parse_version(text)
    local major, minor, patch = (text or ""):match("^(%d+)%.(%d+)%.(%d+)")
    if not major then return nil end
    return tonumber(major), tonumber(minor), tonumber(patch)
end

-- Whether a release tag is a later x.y.z than the installed version; a snapshot counts as its release number.
local function _is_newer(tag, installed)
    local tag_maj, tag_min, tag_patch = _parse_version(tag)
    local cur_maj, cur_min, cur_patch = _parse_version(installed)
    if not (tag_maj and cur_maj) then return false end
    if tag_maj ~= cur_maj then return tag_maj > cur_maj end
    if tag_min ~= cur_min then return tag_min > cur_min end
    return tag_patch > cur_patch
end

-- The process start in epoch seconds. Each load builds a fresh Lua VM, so a launch is known only by this stamp.
local function _get_launch()
    return math_floor(os_time() - os_clock())
end

local function _is_same_launch(stamp)
    return stamp ~= nil and math_abs(stamp - _get_launch()) <= LAUNCH_TOLERANCE_S
end

local function _get_update_path(name)
    return (xfs.resolve_path("$app_data_root$", "") or "") .. name:lower() .. UPDATE_FILE_SUFFIX
end

-- One mod's state file as { tag, checked, offline, notified }, each "key value" on its own line; empty when the file is absent.
local function _read_update_file(name)
    local text = xfs.read_file(_get_update_path(name)) or ""
    return {
        tag = text:match("tag (%d+%.%d+%.%d+)"),
        checked = tonumber(text:match("checked (%d+)")),
        offline = tonumber(text:match("offline (%d+)")),
        notified = text:match("notified (%d+)"),
    }
end

local function _write_update_file(name, state)
    local lines = {}
    for _, key in ipairs(UPDATE_FIELDS) do
        if state[key] then lines[#lines + 1] = key .. " " .. tostring(state[key]) end
    end
    xfs.write_file(_get_update_path(name), table_concat(lines, "\n"))
end

-- One GitHub request for a mod's latest release tag within budget_ms: the tag, or nil and a reason id, then the HTTP code.
-- No status code means the network is unusable, which the caller records so the rest of the launch's automatic checks skip the request.
local function _read_release_tag(manifest, budget_ms)
    local reply = xnet.run_request({ url = string_format(RELEASE_API, manifest.name), timeout_ms = STEP_TIMEOUT_MS, budget_ms = budget_ms,
        headers = { Accept = "application/vnd.github+json", ["User-Agent"] = "xlibs" } })
    local code = reply.code
    if not code then return nil, ST_OFFLINE end
    if HTTP_LIMITED[code] then return nil, ST_LIMITED, code end
    if code == HTTP_NOT_FOUND then return nil, ST_NO_RELEASE, code end
    if not reply.ok then return nil, ST_UNAVAILABLE, code end
    local tag = reply.body:match('"tag_name"%s*:%s*"(%d+%.%d+%.%d+)"')
    if not tag then return nil, ST_NO_RELEASE, code end
    return tag, nil, code
end

-- xlibs plus every published mod whose manifest is already loaded. rawget never loads a script, so no other author's code runs here.
-- @cost 1 luabind (file_list_open over the scripts root) + O(scripts)
local function _collect_manifests()
    local list = { XLIBS_MANIFEST }
    for _, file in ipairs(xfs.read_files("$game_scripts$", "", ".script")) do
        local module = file:match("^_.+_manifest$") and rawget(_G, file)
        local manifest = type(module) == "table" and module.MANIFEST
        if type(manifest) == "table" and manifest.name and manifest.version and manifest.moddb then list[#list + 1] = manifest end
    end
    return list
end

-- The time left for one check: a click's own budget, or what remains of this load's shared one.
local function _get_check_budget_ms(force)
    if force then return CLICK_BUDGET_MS end
    _load_deadline = _load_deadline or (os_clock() + LOAD_BUDGET_MS / 1000)
    return math_floor((_load_deadline - os_clock()) * 1000)
end

-- Ask GitHub for one mod and store the answer in its own file, and the launch's network mark in xlibs's; the reason id on failure, then the HTTP code.
local function _save_release_check(manifest, state, shared, budget_ms)
    local tag, reason, code = nil, ST_OUT_OF_TIME, nil
    if budget_ms > 0 then tag, reason, code = _read_release_tag(manifest, budget_ms) end
    if tag then state.tag = tag end
    state.checked = _get_launch()
    local was_offline = shared.offline
    if reason == ST_OFFLINE then shared.offline = _get_launch() elseif tag then shared.offline = nil end
    if shared ~= state and shared.offline ~= was_offline then _write_update_file(XLIBS_MANIFEST.name, shared) end
    _write_update_file(manifest.name, state)
    return reason, code
end

--- Get the xlibs package version string (the module-local _VERSION literal set at file load).
--- @safety SAFE - returns a constant string literal
--- @cost O(1) | 0 luabind (return local)
--- @return string Version string (e.g. "1.9.0" at a tag, or "1.9.4-snapshot" between releases)
function get_version()
    return _VERSION
end

--- @return table the xlibs manifest { name, version, moddb }, the same shape a mod's MANIFEST has, for the update check.
--- @cost O(1)
function get_manifest()
    return XLIBS_MANIFEST
end

--- Check if the xlibs version satisfies a required minimum (semver: same major, actual >= required).
--- The x.y.z-snapshot suffix is ignored, so a snapshot compares equal to its release number.
--- @safety SAFE - asserts required is a full x.y.z string, so a malformed pin errors loudly at the gate
--- @cost O(1) | 0 luabind (pure Lua string.match + tonumber + integer compares)
--- @param required string Minimum version, full x.y.z (e.g. "1.8.5")
--- @return boolean True if compatible
function is_compatible(required)
    assert(type(required) == "string" and required:match("^%d+%.%d+%.%d+$"),
        "xlibs.is_compatible: required must be a full x.y.z version")
    local req_maj, req_min, req_patch = _parse_version(required)
    local act_maj, act_min, act_patch = _parse_version(_VERSION)
    if act_maj ~= req_maj then return false end
    if act_min ~= req_min then return act_min > req_min end
    return act_patch >= req_patch
end

--- Find a newer release of a mod in its stored update check, linked to its moddb page. It never makes a request.
--- @safety SAFE - a missing moddb slug, no stored tag or a malformed version returns nil.
--- @cost 1 small file read + string compares
--- @param manifest table { name, version, moddb } - name is the GitHub repo under damiansirbu-stalker, moddb the addon slug
--- @return string|nil the newer version
--- @return string|nil the moddb page of the mod
function find_update(manifest)
    if not (manifest and manifest.name and manifest.version and manifest.moddb) then return nil end
    local tag = _read_update_file(manifest.name).tag
    if tag and _is_newer(tag, manifest.version) then return tag, MODDB_ADDON_URL .. manifest.moddb end
    return nil
end

--- Determine whether a newer release of one mod exists: one GitHub request, stored in the mod's own <name>_update.txt.
--- A save load runs it once per launch within the load's shared 5 s budget; force (the button) always asks, within its own 5 s.
--- @src xray/xrGame/level_script.cpp:3356 (game.translate_string), xlibs/xnet.script run_request (GET /repos/{owner}/{repo}/releases/latest)
--- @safety SAFE - xnet contains every network failure; a failure comes back as the message text.
--- @cost 1 blocking HTTPS request (about 0.5 s measured; at most the time left in the budget) + 2 small file reads + 1 to 2 writes | 0 when skipped
--- @param manifest table { name, version, moddb } - a manifest without moddb is never checked
--- @param force boolean|nil true to ask even when this launch already did
--- @return string|nil the result for the player, nil for a mod with no moddb page
--- @return string|nil the outcome for a trace: checked, same_launch, offline or no_network
--- @return number|nil the HTTP status when it asked GitHub
--- @return string|nil the failure's string id
function run_update_check(manifest, force)
    if not (manifest and manifest.name and manifest.version and manifest.moddb) then return nil end
    if not (xnet and xnet.is_ready and xnet.is_ready()) then
        return _format_text(ST_FAILED, game.translate_string(ST_NO_NETWORK)), OUTCOME_NO_NETWORK, nil, ST_NO_NETWORK
    end
    local state = _read_update_file(manifest.name)
    local is_xlibs = manifest.name == XLIBS_MANIFEST.name
    local shared = is_xlibs and state or _read_update_file(XLIBS_MANIFEST.name)
    local outcome = OUTCOME_SAME_LAUNCH
    local reason, code
    if not force and _is_same_launch(shared.offline) and not _is_same_launch(state.checked) then outcome = OUTCOME_OFFLINE end
    if force or not (_is_same_launch(state.checked) or _is_same_launch(shared.offline)) then
        outcome = OUTCOME_CHECKED
        reason, code = _save_release_check(manifest, state, shared, _get_check_budget_ms(force))
        if reason then return _format_text(ST_FAILED, game.translate_string(reason)), outcome, code, reason end
    end
    if state.tag and _is_newer(state.tag, manifest.version) then
        return _format_text(ST_NEWER, manifest.name, state.tag, MODDB_ADDON_URL .. manifest.moddb), outcome, code
    end
    return _format_text(ST_CURRENT, manifest.name), outcome, code
end

--- The Check for update button of a mod: run its check now, close MCM, then show the answer on the menu's message line and as a tip in game.
--- MCM hides the main menu that owns the message line while it is open, so the answer shows once MCM closes, as the xmcm reset does.
--- @src anomaly/ui_mcm.script:1435 (functor_ui passes the UI_MCM instance), xlibs/xmcm.script reset (SetMsg, On_Cancel, show_tip)
--- @cost 1 blocking HTTPS request within a 5 s budget, through run_update_check
--- @param manifest table the mod's MANIFEST
--- @param gui userdata|nil the UI_MCM instance the button passes
--- @return string|nil, string|nil, number|nil, string|nil what run_update_check returned, for the caller's trace
function show_update_check(manifest, gui)
    local msg, outcome, code, reason = run_update_check(manifest, true)
    if not msg then return end
    if gui and gui.owner and gui.owner.SetMsg then gui.owner:SetMsg(msg, TIP_MS / 1000) end
    if gui and gui.On_Cancel then gui:On_Cancel() end
    xpda.show_tip(msg, TIP_MS)
    return msg, outcome, code, reason
end

--- The update status of one mod for its MCM row, from its stored check; it never makes a request.
--- Newer on moddb, up to date with both versions, no network this launch, or not checked yet.
--- @safety SAFE - a mod without a moddb page returns nil; a missing state file reads as not checked
--- @cost 2 small file reads + 1 translate_string
--- @src xray/xrGame/level_script.cpp:3356 (game.translate_string)
--- @param manifest table the mod's MANIFEST
--- @return string|nil the row's text
--- @return string|nil the state for its color: newer, current, offline or unchecked
function get_update_status(manifest)
    if not (manifest and manifest.name and manifest.version and manifest.moddb) then return nil end
    local state = _read_update_file(manifest.name)
    if state.tag and _is_newer(state.tag, manifest.version) then
        return _format_text(ST_STATUS_NEWER, state.tag, MODDB_ADDON_URL .. manifest.moddb), "newer"
    end
    local shared = manifest.name == XLIBS_MANIFEST.name and state or _read_update_file(XLIBS_MANIFEST.name)
    if _is_same_launch(shared.offline) and not _is_same_launch(state.checked) then
        return game.translate_string(ST_STATUS_OFFLINE), "offline"
    end
    if state.tag then return _format_text(ST_STATUS_CURRENT, manifest.version, state.tag), "current" end
    return game.translate_string(ST_STATUS_UNCHECKED), "unchecked"
end

--- Post the day's PDA message listing every mod with a newer release; nothing when all are current or today's message is out.
--- Every mod's gate calls it on the first frame, and the day mark in xlibs_update.txt keeps it to one message.
--- @src xlibs/xpda.script publish_news (xray/xrGame/script_game_object_script3.cpp give_game_news)
--- @safety SAFE - a missing state file reads as empty, and publish_news returns false without an actor.
--- @cost 1 script listing + 1 small file read per published mod + 1 news on a day with an update
--- @return number how many mods have a newer release, 0 when today's message is already out
--- @return boolean whether it posted the message
function show_update_news()
    local shared = _read_update_file(XLIBS_MANIFEST.name)
    local today = os_date("%Y%m%d")
    if shared.notified == today then return 0, false end
    local newer = {}
    for _, manifest in ipairs(_collect_manifests()) do
        local tag = _read_update_file(manifest.name).tag
        if tag and _is_newer(tag, manifest.version) then newer[#newer + 1] = manifest.name .. " " .. tag end
    end
    if #newer == 0 then return 0, false end
    shared.notified = today
    _write_update_file(XLIBS_MANIFEST.name, shared)
    local posted = xpda.publish_news(game.translate_string(ST_NEWS_CAPTION), _format_text(ST_NEWS, table_concat(newer, ", ")))
    return #newer, posted == true
end
