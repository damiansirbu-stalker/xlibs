--- xsound: sound wrap - one-shots (play fire-and-forget; play_at retained/stoppable) + loops (create_sound/release, volume lerp)

local _NEXT_HANDLE = 1
local _active = {}
local _dead = {}
local _registered = false
local _last_tick = 0
local TICK_MS = 100
local _meta = {}
local LOUDNESS_ROLLOFF = 0.75

-- Forward declaration: play_at/create_sound call _register (defined below _update), so the name resolves at those earlier call sites.
local _register

local sound_object_t = sound_object
local time_global = time_global
local pairs, next = pairs, next
local math_abs, math_log10 = math.abs, math.log10
local assert, type = assert, type

--- Verified-safe sound paths, sourced from vanilla scripts and configs/misc/sound/*.ltx.
--- A missing path logs a Lua "File not found" and falls back to $no_sound (no crash), but wastes a handle slot.
--- @src anomaly/sr_psy_antenna.script(42): PSY_ANTENNA_L, PSY_ANTENNA_R
--- @src anomaly/psi_storm_manager.script(384): PSI_STORM
--- @src anomaly/bind_anomaly_field.script(283-284): EMI_BLOWOUT, EMI_BLOWOUT_FAR
--- @src anomaly/sr_teleport.script(52): TINNITUS
--- @src anomaly/configs/misc/script_sound.ltx: EARTHQUAKE, ORGANIC_MOAN, MONOLITH_HUM, WARLAB_NOISE, NOOS_TUNNEL, RADAR_1, RADAR_2
--- @src anomaly/bind_dynamic_light.script(70): LIGHT_HUMMING
SND = {
    -- psy / horror whispers (stereo: pair _L + _R for in-head effect)
    PSY_ANTENNA_L     = "anomaly\\psy_antenna_voices_1_l",
    PSY_ANTENNA_R     = "anomaly\\psy_antenna_voices_1_r",
    PSI_STORM         = "anomaly\\psi_storm_01",
    EMI_BLOWOUT       = "anomaly\\emi_blowout",
    EMI_BLOWOUT_FAR   = "anomaly\\emi_blowout_01",
    TINNITUS          = "affects\\tinnitus3a",
    -- ambient horror
    EARTHQUAKE        = "ambient\\earthquake",
    ORGANIC_MOAN      = "ambient\\organic_moan1",
    MONOLITH_HUM      = "ambient\\monolith_1",
    WARLAB_NOISE      = "ambient\\warlab_pod_noise",
    NOOS_TUNNEL       = "ambient\\noos_tunnel_1",
    RADAR_1           = "ambient\\radar_1",
    RADAR_2           = "ambient\\radar_2",
    LIGHT_HUMMING     = "ambient\\special\\light_humming",
}

-- callback name (e.g. "on_before_play_ambient_bed") -> array of registered listener functions
local _sound_listeners = {}
-- callback name -> the single fan-out subscriber registered with the engine, kept for UnregisterScriptCallback
local _dispatchers = {}
-- callback name -> the _G relay global the engine defines with it; absent = this exe lacks the hooks, stay inert
local SEAM_PROBE = {
    on_before_play_ambient_bed    = "COnAmbientBed",
    on_before_play_level_music    = "COnLevelMusic",
    on_before_play_script_sound   = "COnBeforePlayScriptSound",
    on_before_play_ambient_effect = "COnAmbientEffectSound",
    on_before_play_thunderbolt    = "COnThunderboltSound",
    on_before_play_rain           = "COnRainSound",
}

-- Step current toward target by smoothing per second.
-- @cost O(1) | 0 luabind
local function _compute_step(current, target, smoothing, dt_sec)
    local delta = smoothing * dt_sec
    if math_abs(target - current) <= delta then return target end
    if current < target then return current + delta end
    return current - delta
end

-- Per-frame volume lerp plus auto-cleanup when a releasing handle reaches 0.
-- @cost O(n_active) | 0 luabind (sound_object.volume is property assign)
local function _update()
    local now = time_global()
    if now - _last_tick < TICK_MS then return end
    local dt_sec = (now - _last_tick) / 1000
    _last_tick = now

    for handle, entry in pairs(_active) do
        local finished = entry.oneshot and not entry.sound:playing()
        if not entry.oneshot and entry.volume ~= entry.target_volume then
            entry.volume = _compute_step(entry.volume, entry.target_volume, entry.smoothing, dt_sec)
            entry.sound.volume = entry.volume
        end
        if not entry.oneshot and entry.releasing and entry.volume <= 0.001 then
            entry.sound:stop()
            finished = true
        end
        if finished then _dead[#_dead + 1] = handle end
    end
    for i = #_dead, 1, -1 do
        _active[_dead[i]] = nil
        _dead[i] = nil
    end

    if next(_active) == nil and _registered then
        UnregisterScriptCallback("actor_on_update", _update)
        _registered = false
    end
end

-- Fan a fired seam to its listener list, multiplying each listener's { volume_mult } into the relay's shared result table.
-- Any listener returning 0 vetoes; an unwritten result leaves vanilla.
-- @cost O(n_listeners) per play | 0 luabind
local function _create_dispatcher(list)
    return function(...)
        local arg_count = select("#", ...)
        local result = select(arg_count, ...)
        if type(result) ~= "table" then return end
        local mult = 1.0
        for i = 1, #list do
            local ret = list[i](...)
            if ret and ret.volume_mult then mult = mult * ret.volume_mult end
        end
        if mult < 1.0 then result.volume_mult = (result.volume_mult or 1.0) * mult end
    end
end

-- Enter a listener into a seam's registry; the first subscribes the fan-out to the engine callback.
-- Inert when the exe lacks the hook; not cleared on_game_start, since filesystem order would wipe a consumer.
-- @cost O(1) | 0 luabind
local function _register_listener(callback_name, fn)
    assert(type(fn) == "function", "xsound: ambient listener for " .. callback_name .. " must be a function")
    local probe = SEAM_PROBE[callback_name]
    if not (probe and type(_G[probe]) == "function") then return false end
    local list = _sound_listeners[callback_name]
    if not list then
        list = {}
        _sound_listeners[callback_name] = list
        local dispatcher = _create_dispatcher(list)
        _dispatchers[callback_name] = dispatcher
        RegisterScriptCallback(callback_name, dispatcher)
    end
    list[#list + 1] = fn
    return true
end

-- Remove a listener, unsubscribing the fan-out when the last one leaves.
-- @cost O(n_listeners) | 0 luabind
local function _unregister_listener(callback_name, fn)
    local list = _sound_listeners[callback_name]
    if not list then return end
    for i = #list, 1, -1 do
        if list[i] == fn then
            list[i] = list[#list]
            list[#list] = nil
        end
    end
    if #list == 0 then
        local dispatcher = _dispatchers[callback_name]
        if dispatcher then UnregisterScriptCallback(callback_name, dispatcher) end
        _dispatchers[callback_name] = nil
        _sound_listeners[callback_name] = nil
    end
end

--- Canonical sound-path key so the config, disk, and code forms of one path resolve to the same entry.
--- Lowercase, backslashes, no .ogg, trimmed.
--- @cost O(1) | 0 luabind
local function _format_meta_key(path)
    if type(path) ~= "string" then return "" end
    local key = path:lower():gsub("/", "\\")
    key = key:gsub("%.ogg$", "")
    return key:match("^%s*(.-)%s*$")
end

--- Play a one-shot sound (fire-and-forget: no handle, no lerp) via play_no_feedback, so the GC never cuts the engine-owned emitter.
--- For short cues that never need stopping; use play_at for a STOPPABLE one-shot, create_sound/release for loops.
--- @safety SAFE - nil-guarded on db.actor and sound_object_t constructor
--- @cost O(1) | 1 luabind heavy (sound_object ctor + play_no_feedback)
--- @src xray/xrGame/script_sound_script.cpp:51 (play_no_feedback); xrSound/SoundRender_Core.cpp:353-381 (detaches the emitter to engine ownership)
--- @param snd_path string Sound path (e.g. "affects\\tinnitus3a", xsound.SND.*)
--- @param opts table|nil { volume (default 1.0), position (vector -> 3D at that point; omit for 2D at-ear), freq (default 1.0) }
--- @return boolean True if sound was played
function play(snd_path, opts)
    local actor = db.actor
    if not actor then return false end
    local snd = sound_object_t(snd_path)
    if not snd then return false end
    opts = opts or {}
    local pos = opts.position
    local flags = sound_object_t.s2d
    if pos then flags = sound_object_t.s3d end
    snd:play_no_feedback(actor, flags, 0, pos or vector():set(0, 0, 0), opts.volume or 1.0, opts.freq or 1.0)
    return true
end

--- Play a one-shot with a RETAINED handle (the vanilla ambient call shape) so the sound CAN be stopped, unlike play().
--- The object is held in the module until it finishes (swept on the shared tick), so the GC never cuts it mid-play.
--- @safety SAFE - nil-guarded on db.actor and the sound_object constructor
--- @cost O(1) | 3-4 luabind heavy (ctor + play_at_pos + volume, s2d flag optional)
--- @src anomaly/sound_ambient.script:144-165 (the vanilla call shape); xray/xrGame/script_sound.cpp:30-37 (GC cuts an unheld playing sound)
--- @param snd_path string Sound path (backslashes, no .ogg)
--- @param opts table|nil { position (vector; required for 3D), volume (default 1.0), s2d (true = at-ear 2D) }
--- @return number|nil Handle for stop_shot/stop_shots, nil when not playable
function play_at(snd_path, opts)
    local actor = db.actor
    if not actor then return nil end
    opts = opts or {}
    local snd = sound_object_t(snd_path)
    if not snd then return nil end
    local flags = opts.s2d and sound_object_t.s2d or sound_object_t.s3d
    snd:play_at_pos(actor, opts.position or vector():set(0, 0, 0), 0, flags)
    snd.volume = opts.volume or 1.0
    local handle = _NEXT_HANDLE
    _NEXT_HANDLE = _NEXT_HANDLE + 1
    _active[handle] = {
        sound         = snd,
        path          = snd_path,
        volume        = snd.volume,
        target_volume = snd.volume,
        smoothing     = 1.0,
        releasing     = false,
        oneshot       = true,
    }
    _register()
    return handle
end

--- Stop one retained one-shot immediately and free its slot.
--- @safety SAFE - no-op on an unknown handle
--- @cost O(1) | 1 luabind (stop)
--- @param handle number Handle from play_at()
--- @return boolean ok
function stop_shot(handle)
    local entry = _active[handle]
    if not (entry and entry.oneshot) then return false end
    if entry.sound:playing() then entry.sound:stop() end
    _active[handle] = nil
    return true
end

--- Stop every retained one-shot immediately (the dev-tab Stop). Looping handles are untouched.
--- @safety SAFE - every sound call is guarded by :playing(), a released handle is skipped
--- @cost O(n_active) | 1 luabind per live shot (stop)
function stop_shots()
    for handle, entry in pairs(_active) do
        if entry.oneshot and entry.sound:playing() then entry.sound:stop() end
        if entry.oneshot then _dead[#_dead + 1] = handle end
    end
    for i = #_dead, 1, -1 do
        _active[_dead[i]] = nil
        _dead[i] = nil
    end
end

--- Duration of a sound file in milliseconds, WITHOUT playing it - for spacing one-shots by their own length.
--- Constructs the sound_object, reads length(), then lets it GC; no play means no feedback, so the collect is safe.
--- @safety SAFE - no play, no retained handle, no db.actor needed
--- @cost O(1) | 1 luabind heavy (sound_object ctor) + 1 length read
--- @src xray/xrGame/script_sound_inline.h:11-15 (Length = iFloor(get_length_sec*1000)); xray/xrGame/script_sound.cpp:30-37 (GC-safe with no feedback)
--- @param snd_path string Sound path (backslashes, no .ogg)
--- @return number Duration in ms (0 if it could not load)
function length(snd_path)
    local snd = sound_object_t(snd_path)
    if not snd then return 0 end
    return snd:length() or 0
end

-- Register the actor_on_update callback on first create_sound; idempotent on later calls
-- @cost O(1) | 1 luabind (RegisterScriptCallback) on cold register, 0 luabind on hot path
_register = function()
    if _registered then return end
    _last_tick = time_global()
    RegisterScriptCallback("actor_on_update", _update)
    _registered = true
end

--- Create a handle for a looping sound, played immediately at volume 0 so the handle is live.
--- The caller ramps volume via set_volume(handle, target); release(handle) lerps back to 0 and frees the slot.
--- @safety SAFE - guards db.actor, returns nil if sound_object constructor fails
--- @cost O(1) | 1 luabind heavy (sound_object ctor + play_at_pos)
--- @src xray/xrGame/script_sound_script.cpp sound_object bindings
--- @param snd_path string Sound path (e.g. xsound.SND.PSY_ANTENNA_L), backslashes
--- @param opts table|nil { looped (default true), s2d (default true), position (vector), smoothing (default 1.0) }
--- @return number|nil handle
function create_sound(snd_path, opts)
    if not db.actor then return nil end
    opts = opts or {}
    local snd = sound_object_t(snd_path)
    if not snd then return nil end

    local looped = opts.looped ~= false
    local s2d    = opts.s2d ~= false
    local flags  = s2d and sound_object_t.s2d or sound_object_t.s3d
    if looped then flags = flags + sound_object_t.looped end

    local pos = opts.position or vector():set(0, 0, 0)
    snd:play_at_pos(db.actor, pos, 0, flags)
    snd.volume = 0

    local handle = _NEXT_HANDLE
    _NEXT_HANDLE = _NEXT_HANDLE + 1
    _active[handle] = {
        sound         = snd,
        path          = snd_path,
        volume        = 0,
        target_volume = 0,
        smoothing     = opts.smoothing or 1.0,
        releasing     = false,
    }
    _register()
    return handle
end

--- Set the target volume. Lerp drives current volume toward target each tick (100ms).
--- @safety SAFE - rejects unknown or already-releasing handles
--- @cost O(1) | 0 luabind (state write)
--- @param handle number Handle from create_sound()
--- @param target number Target volume, clamped to [0, 1]
--- @param smoothing number|nil Override smoothing for this transition (units/sec)
--- @return boolean ok
function set_volume(handle, target, smoothing)
    local entry = _active[handle]
    if not entry or entry.releasing then return false end
    if target < 0 then target = 0 elseif target > 1 then target = 1 end
    entry.target_volume = target
    if smoothing then entry.smoothing = smoothing end
    return true
end

--- Release the handle. Ramps volume to 0, then stops the sound and frees.
--- @safety SAFE - no-op on unknown or already-releasing handle
--- @cost O(1) | 0 luabind (state flag; stop happens on lerp completion)
--- @param handle number Handle
--- @return boolean ok
function release(handle)
    local entry = _active[handle]
    if not entry or entry.releasing then return false end
    entry.releasing     = true
    entry.target_volume = 0
    return true
end

--- Check if a handle is still tracked. Tracking ends when release()'s lerp finishes.
--- @cost O(1) | 0 luabind (hash table lookup)
--- @param handle number Handle from create_sound()
--- @return boolean True while the handle has an entry in _active
function is_active(handle)
    return _active[handle] ~= nil
end

--- Snapshot of a handle's state for diagnostics. Pure read, does not affect lerp or scheduling.
--- @cost O(1) | 0 luabind (hash lookup + table copy of small fields)
--- @param handle number Handle from create_sound()
--- @return table|nil { path, volume, target_volume, smoothing, releasing }, nil for unknown handle
function get_snapshot(handle)
    local entry = _active[handle]
    if not entry then return nil end
    return {
        path          = entry.path,
        volume        = entry.volume,
        target_volume = entry.target_volume,
        smoothing     = entry.smoothing,
        releasing     = entry.releasing,
    }
end

--- The engine ambient-sound callbacks for register_ambient_listener, with per-seam args in doc/architecture.md.
SEAM = {
    BED          = "on_before_play_ambient_bed",
    MUSIC        = "on_before_play_level_music",
    SCRIPT_SOUND = "on_before_play_script_sound",
    EFFECT       = "on_before_play_ambient_effect",
    THUNDER      = "on_before_play_thunderbolt",
    RAIN         = "on_before_play_rain",
}

--- Enter a listener into a seam's registry: fn(seam args) -> nil | { volume_mult = number }, any 0 vetoes the play.
--- Many listeners may register one seam, and xlibs multiplies their volume_mult returns into the shared result.
--- @safety SAFE  @cost O(1) | 0 luabind
--- @param seam string An xsound.SEAM value
--- @param fn function
--- @return boolean true when the seam is live on this exe and the listener was added, false when inert
function register_ambient_listener(seam, fn)
    return _register_listener(seam, fn)
end

--- Remove a listener from a seam's registry. Clears the _G seam when the last one leaves.
--- @safety SAFE  @cost O(n_listeners) | 0 luabind
--- @param seam string An xsound.SEAM value
--- @param fn function
function unregister_ambient_listener(seam, fn)
    _unregister_listener(seam, fn)
end

--- Load a mod's generated per-sound profile table into the shared registry, once at load.
--- Keys normalize on the way in; a later load overwrites a shared key (mods use disjoint path namespaces).
--- @safety SAFE - no-op on a nil or non-table arg
--- @cost O(n_rows) once | 0 luabind
--- @param rows table Map of sound path to its profile table
function load_meta(rows)
    if type(rows) ~= "table" then return end
    for path, profile in pairs(rows) do
        _meta[_format_meta_key(path)] = profile
    end
end

--- The per-sound profile for a path, or nil. Pure table lookup, safe on any path form (hot-path safe).
--- @safety SAFE  @cost O(1) | 0 luabind
--- @param path string A sound path in any form
--- @return table|nil The profile table, or nil when unknown
function get_meta(path)
    return _meta[_format_meta_key(path)]
end

--- The delivered loudness in dB at a distance: content LUFS attenuated by the profile's rolloff curves.
--- Mirrors the pipeline _loudness_floor model; a nil distance means at-ear (no distance attenuation).
--- @safety SAFE - nil when the profile has no lufs
--- @cost O(1) | 0 luabind
--- @param profile table A per-sound profile { lufs, bv, mn, mx } from get_meta
--- @param dist number|nil Distance in metres, or nil for at-ear
--- @return number|nil Delivered loudness in dB, or nil when lufs is unknown
function compute_delivered_loudness(profile, dist)
    if not (profile and profile.lufs) then return nil end
    local bv = profile.bv or 1.0
    local gain = bv
    local mn, mx = profile.mn, profile.mx
    if dist and mn and mx and mx > mn then
        local clamped = dist
        if clamped < mn then clamped = mn elseif clamped > mx then clamped = mx end
        local va = (mx - clamped) / (mx - mn)
        if va < 0 then va = 0 elseif va > 1 then va = 1 end
        local al = clamped > mn and (mn / (mn + LOUDNESS_ROLLOFF * (clamped - mn))) or 1.0
        gain = bv * va * al
    end
    if gain <= 1e-6 then return -120.0 end
    return profile.lufs + 20.0 * math_log10(gain)
end

--- Reset all state on save load, stopping any playing sounds still held.
--- Sound-seam handlers are intentionally NOT cleared here (on_game_start ordering would wipe them).
function on_game_start()
    for _, entry in pairs(_active) do
        if entry.sound and entry.sound:playing() then
            entry.sound:stop()
        end
    end
    _active = {}
    if _registered then
        UnregisterScriptCallback("actor_on_update", _update)
        _registered = false
    end
    _NEXT_HANDLE = 1
end
