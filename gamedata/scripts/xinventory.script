--- xinventory: NPC inventory categorization, slot semantics, item lifecycle

local pairs, IsItem, tonumber = pairs, IsItem, tonumber
local table_sort, math_floor = table.sort, math.floor
local string_match, string_sub = string.match, string.sub
local parse_list, alife_release_id, alife_create_item, alife_object = parse_list, alife_release_id, alife_create_item, alife_object
local level, ini_sys, ini_file, xlevel = level, ini_sys, ini_file, xlevel
local get_object_story_id, se_load_var = get_object_story_id, se_load_var
local table_concat = table.concat

-- Engine slot constants (inventory_space.h:7-43); m_slots is sized from system.ltx slot_persistent_<N>, so slots 15..18 are OOB UB.

SLOT_KNIFE     = 1
SLOT_PISTOL    = 2
SLOT_RIFLE     = 3
SLOT_GRENADE   = 4
SLOT_OUTFIT    = 7
SLOT_HELMET    = 12
BACKPACK_SLOT  = 13
LAST_MAIN_SLOT = 14

-- Granular consumable section sets, hand-maintained (vanilla bundles all under kind=i_medical); extend when addons ship new sections.

local _medkit_set = {
    medkit         = true, medkit_army    = true, medkit_scientic = true,
    medkit_ai1     = true, medkit_ai2     = true, medkit_ai3      = true,
    survival_kit   = true, rebirth        = true,
}

local _bandage_set = {
    bandage = true, jgut = true,
}

local _antirad_set = {
    antirad             = true, antirad_kalium      = true,
    antirad_cystamine   = true, drug_radioprotector = true,
}

local _stim_set = {
    stimpack          = true, stimpack_army     = true, stimpack_scientic = true,
    drug_booster      = true, adrenalin         = true,
}

-- protein excluded: vanilla tags it kind=i_food, so get_section_category classifies it "food"
local _pill_set = {
    caffeine       = true, drug_sleepingpills  = true, antibio_sulfad = true,
    antibio_chlor  = true, antiemetic          = true, yadylin        = true,
    analgetic      = true, drug_psy_blockade   = true, drug_anabiotic = true,
    drug_antidot   = true, drug_coagulant      = true, cocaine        = true,
    tetanus        = true, morphine            = true, salicidic_acid = true,
    akvatab        = true, glucose             = true, glucose_s      = true,
}

-- Hand-curated, kind=w_explosive AND class prefix G_ (no _ITM["grenade"] bucket exists; ini_sys discovery breaches the cold-call ceiling).
local _grenade_set = {
    grenade_f1     = true, grenade_rgd5   = true,
    ["grenade_gd-05"] = true, grenade_smoke  = true,
}

-- Untouchable blacklist from xr_corpse_detection.ltx [ignore_sections], loaded once at first call.

local CORPSE_DETECTION_LTX = "ai_tweaks\\xr_corpse_detection.ltx"
local IGNORE_SECTIONS      = "ignore_sections"
-- Two tiers covers the common ammo split, standard and armour-piercing.
local DEFAULT_AMMO_TIERS = 2

local _blacklist_set
-- Lazy-load the corpse-detection blacklist on first call. Idempotent.
-- @cost O(~85 ini reads) on first call; O(1) thereafter (early return)
local function _build_blacklist()
    if _blacklist_set then return end
    _blacklist_set = {}
    local ini = ini_file(CORPSE_DETECTION_LTX)
    if not ini or not ini:section_exist(IGNORE_SECTIONS) then return end
    local line_count = ini:line_count(IGNORE_SECTIONS)
    for i = 0, line_count - 1 do
        local _, id = ini:r_line_ex(IGNORE_SECTIONS, i, "", "")
        if id and id ~= "" then _blacklist_set[id] = true end
    end
end

-- Per-section kind/class caches; string keys make weak mode a no-op, and the LTX-bounded section universe caps them naturally.
local _kind_cache = {}
-- Cached kind-field lookup. `false` sentinel records nil to avoid re-querying.
-- @cost O(1) on cache hit; 1 luabind heavy on miss (r_string_ex)
local function _get_kind(sec)
    if not sec then return nil end
    local cached = _kind_cache[sec]
    if cached ~= nil then return cached or nil end
    local kind = ini_sys:r_string_ex(sec, "kind")
    _kind_cache[sec] = kind or false
    return kind
end

local _class_cache = {}
-- Cached class-field lookup. `false` sentinel records nil to avoid re-querying.
-- @cost O(1) on cache hit; 1 luabind heavy on miss (r_string_ex)
local function _get_class(sec)
    if not sec then return nil end
    local cached = _class_cache[sec]
    if cached ~= nil then return cached or nil end
    local cls = ini_sys:r_string_ex(sec, "class")
    _class_cache[sec] = cls or false
    return cls
end

-- ITEM ACCESSORS (game_object item in)

--- Get item section name. Wraps item:section() to keep mods from calling the engine method directly.
--- @safety SAFE - nil-guarded item
--- @cost O(1) | 1 luabind heavy (section: shared_str alloc across bridge)
--- @src xray/xrGame/script_game_object_script.cpp
--- @param item game_object Inventory item
--- @return string|nil Section name
function get_section(item)
    if not item then return nil end
    return item:section()
end

--- Get item condition (0.0 - 1.0). Wraps item:condition(); meaningful for weapons / outfits / helmets / degradable items.
--- @safety SAFE - nil-guarded item
--- @cost O(1) | 1 luabind trivial (condition: float field read)
--- @src xray/xrGame/InventoryItem.h
--- @param item game_object Inventory item
--- @return number|nil Condition 0.0-1.0
function get_condition(item)
    if not item then return nil end
    return item:condition()
end

-- NPC SLOT ACCESSORS

--- Get the item in the NPC's knife slot (slot 1).
--- @safety SAFE - nil-guarded npc; item_in_slot returns nil for empty slot
--- @cost O(1) | 1 luabind trivial (item_in_slot: CInventory::ItemFromSlot)
--- @src xray/xrServerEntities/inventory_space.h(7-43), xray/xrGame/Inventory.cpp ItemFromSlot
--- @param npc game_object
--- @return game_object|nil Knife item or nil
function get_equipped_knife(npc)
    if not npc then return nil end
    return npc:item_in_slot(SLOT_KNIFE)
end

--- Get the item in the NPC's pistol slot (slot 2).
--- @safety SAFE - nil-guarded npc
--- @cost O(1) | 1 luabind trivial (item_in_slot)
--- @src xray/xrServerEntities/inventory_space.h(11)
--- @param npc game_object
--- @return game_object|nil Pistol item or nil
function get_equipped_pistol(npc)
    if not npc then return nil end
    return npc:item_in_slot(SLOT_PISTOL)
end

--- Get the item in the NPC's rifle slot (slot 3).
--- @safety SAFE - nil-guarded npc
--- @cost O(1) | 1 luabind trivial (item_in_slot)
--- @src xray/xrServerEntities/inventory_space.h(13)
--- @param npc game_object
--- @return game_object|nil Rifle item or nil
function get_equipped_rifle(npc)
    if not npc then return nil end
    return npc:item_in_slot(SLOT_RIFLE)
end

--- Get the item in the NPC's grenade slot (slot 4).
--- @safety SAFE - nil-guarded npc
--- @cost O(1) | 1 luabind trivial (item_in_slot)
--- @src xray/xrServerEntities/inventory_space.h(15)
--- @param npc game_object
--- @return game_object|nil Grenade item or nil
function get_equipped_grenade(npc)
    if not npc then return nil end
    return npc:item_in_slot(SLOT_GRENADE)
end

--- Get the item in the NPC's outfit slot (slot 7).
--- @safety SAFE - nil-guarded npc
--- @cost O(1) | 1 luabind trivial (item_in_slot)
--- @src xray/xrServerEntities/inventory_space.h(21)
--- @param npc game_object
--- @return game_object|nil Outfit item or nil
function get_equipped_outfit(npc)
    if not npc then return nil end
    return npc:item_in_slot(SLOT_OUTFIT)
end

--- Get the item in the NPC's helmet slot (slot 12).
--- @safety SAFE - nil-guarded npc
--- @cost O(1) | 1 luabind trivial (item_in_slot)
--- @src xray/xrServerEntities/inventory_space.h(31)
--- @param npc game_object
--- @return game_object|nil Helmet item or nil
function get_equipped_helmet(npc)
    if not npc then return nil end
    return npc:item_in_slot(SLOT_HELMET)
end

--- Get the set of item ids equipped across the protected main slots - the walkers' one-lookup equipped check.
--- SLOT_GRENADE is deliberately excluded: a slotted grenade is a throwable the policy must still manage, not protected gear.
--- @safety SAFE - nil-guarded npc; item_in_slot nil-safe per slot
--- @cost O(1) | 13 luabind trivial (item_in_slot per protected slot)
--- @src xray/xrServerEntities/inventory_space.h(7-43)
--- @param npc game_object
--- @return table { [item_id] = true, ... }
function get_equipped_ids(npc)
    local _ids = {}
    if not npc then return _ids end
    for slot = 1, LAST_MAIN_SLOT do
        local it = slot ~= SLOT_GRENADE and npc:item_in_slot(slot)
        if it then _ids[it:id()] = true end
    end
    return _ids
end

--- Build the canonical opts table for get_category from an online NPC; build once, thread into every get_category call.
--- Snapshot semantics: equipped state is captured once, and consumer walks complete within a single Lua call, so nothing mutates between.
--- @safety SAFE - nil-guarded npc; returns empty opts when npc nil
--- @cost O(1) | up to 17 luabind trivial (14 item_in_slot via get_equipped_ids + 2 item_in_slot pistol/rifle + 1 id) + 2 luabind heavy (section shared_str)
--- @src xray/xrServerEntities/inventory_space.h, xray/xrGame/script_game_object_inventory_owner.cpp(1605)
--- @param npc game_object Online NPC
--- @return table { equipped_ids, equipped_pistol_sec, equipped_rifle_sec, npc_id }
function get_category_opts(npc)
    if not npc then return { equipped_ids = {} } end
    local pistol = npc:item_in_slot(SLOT_PISTOL)
    local rifle  = npc:item_in_slot(SLOT_RIFLE)
    return {
        equipped_ids        = get_equipped_ids(npc),
        equipped_pistol_sec = pistol and pistol:section() or nil,
        equipped_rifle_sec  = rifle  and rifle:section()  or nil,
        npc_id              = npc:id(),
    }
end

-- WEAPON CONFIG

local _ammo_sections_cache = {}

--- Get ordered list of ammo sections accepted by a weapon section; array form of parse_list (declaration order), cached per weapon section.
--- @safety SAFE - nil-guarded sec; empty list when ammo_class missing
--- @cost O(1) cached, 1 luabind heavy on miss (parse_list ini parse, array form)
--- @src anomaly/_g.script parse_list, vanilla weapon LTX ammo_class field
--- @param weapon_sec string Weapon section name
--- @return table Ordered array of ammo section names
function get_ammo_sections(weapon_sec)
    if not weapon_sec then return {} end
    local cached = _ammo_sections_cache[weapon_sec]
    if cached then return cached end
    local list = parse_list(ini_sys, weapon_sec, "ammo_class") or {}
    _ammo_sections_cache[weapon_sec] = list
    return list
end

local _ammo_tier_cache = {}

--- Get the ammo tier map for a weapon's ammo_class: k_ap ascending (cost tiebreaker) split into N tiers, cached per (weapon_sec, n_tiers).
--- Tier 1 = least armor-piercing, tier N = most; a cost-only sort covers the all-k_ap-zero case.
--- @safety SAFE - nil-guarded; empty map on missing ammo_class
--- @cost O(N log N) sort on miss; O(1) cached; ~3 luabind heavy per section on miss (k_ap + cost reads via r_float_ex)
--- @src anomaly/weapon_ammo.ltx (k_ap, cost per ammo section)
--- @param weapon_sec string Weapon section name
--- @param n_tiers number Number of tiers (default 2)
--- @return table { [ammo_sec] = tier_idx, ... }
function get_ammo_tier_map(weapon_sec, n_tiers)
    n_tiers = n_tiers or DEFAULT_AMMO_TIERS
    if not weapon_sec then return {} end
    local cache_key = weapon_sec .. ":" .. n_tiers
    local cached = _ammo_tier_cache[cache_key]
    if cached then return cached end

    local sections = get_ammo_sections(weapon_sec)
    local count = #sections
    if count == 0 then
        _ammo_tier_cache[cache_key] = {}
        return {}
    end

    local entries = {}
    local all_zero_kap = true
    for i = 1, count do
        local sec = sections[i]
        local kap = ini_sys:r_float_ex(sec, "k_ap")
        if kap then
            if kap > 0 then all_zero_kap = false end
            entries[#entries + 1] = { sec = sec, k_ap = kap, cost = ini_sys:r_float_ex(sec, "cost") or 0 }
        end
    end
    local kept = #entries

    table_sort(entries, function(a, b)
        if all_zero_kap then return a.cost < b.cost end
        if a.k_ap == b.k_ap then return a.cost < b.cost end
        return a.k_ap < b.k_ap
    end)

    local tier_map = {}
    for i = 1, kept do
        tier_map[entries[i].sec] = math_floor((i - 1) * n_tiers / kept) + 1
    end

    _ammo_tier_cache[cache_key] = tier_map
    return tier_map
end


-- CATEGORY → SECTIONS (reverse map; used by trade BUY pass)

-- Set (hash table) → flat array of keys.
-- @cost O(n) keys, single pass
local function _build_hand_list(s)
    local list = {}
    for k in pairs(s) do list[#list + 1] = k end
    return list
end

-- Flat array from one Parse_ITM _ITM[bucket] hash. Empty array if bucket missing.
-- @cost O(n) sections in bucket, single pass
local function _build_bucket_list(bucket_name)
    local list = {}
    local bucket = _ITM and _ITM[bucket_name]
    if not bucket then return list end
    for sec in pairs(bucket) do list[#list + 1] = sec end
    return list
end

-- Append unique entries from one bucket into list, tracking dedup via seen hash.
-- @cost O(n) bucket entries, 1 hash op per entry
local function _add_bucket_unique(bucket, list, seen)
    for sec in pairs(bucket) do
        if not seen[sec] then
            seen[sec] = true
            list[#list + 1] = sec
        end
    end
end

-- Union of N Parse_ITM buckets, de-duped.
-- @cost O(total sections across buckets), single dedup hash
local function _merge_buckets(buckets)
    local list, seen = {}, {}
    for i = 1, #buckets do
        local bucket = _ITM and _ITM[buckets[i]]
        if bucket then _add_bucket_unique(bucket, list, seen) end
    end
    return list
end

-- Filter _ITM["eatable"] (the combined food + drink + i_mutant_cooked bucket) by exact kind, without re-walking ini_sys.
-- @cost O(n) eatable sections; per-section 1 cached _get_kind hit
local function _filter_eatable_by_kind(target_kinds)
    local list = {}
    local bucket = _ITM and _ITM["eatable"]
    if not bucket then return list end
    for sec in pairs(bucket) do
        if target_kinds[_get_kind(sec) or ""] then list[#list + 1] = sec end
    end
    return list
end

-- CWeaponAmmo::Load strict-reads k_ap, so an ammo section lacking it is a CTD on create; keep such sections out of the spawnable pool.
-- @cost O(1), 1 luabind (r_float_ex, inheritance-aware)
local function _is_ammo_spawnable(sec)
    return ini_sys:r_float_ex(sec, "k_ap") ~= nil
end

-- @cost O(n) ammo sections in the bucket, 1 r_float_ex each; built once per session, cached
local function _get_spawnable_ammo()
    local list = {}
    local bucket = _ITM and _ITM["ammo"]
    if not bucket then return list end
    for sec in pairs(bucket) do
        if _is_ammo_spawnable(sec) then list[#list + 1] = sec end
    end
    return list
end

local _SECTION_BUILDERS = {
    medkit  = function() return _build_hand_list(_medkit_set)  end,
    bandage = function() return _build_hand_list(_bandage_set) end,
    antirad = function() return _build_hand_list(_antirad_set) end,
    stim    = function() return _build_hand_list(_stim_set)    end,
    pill    = function() return _build_hand_list(_pill_set)    end,
    grenade = function() return _build_hand_list(_grenade_set) end,

    outfit            = function() return _build_bucket_list("outfit")       end,
    helmet            = function() return _build_bucket_list("helmet")       end,
    artefact          = function() return _build_bucket_list("artefact")     end,
    device            = function() return _build_bucket_list("device")       end,
    money             = function() return _build_bucket_list("money")        end,
    grenade_ammo      = function() return _build_bucket_list("grenade_ammo") end,
    ammo_not_equipped = _get_spawnable_ammo,

    crafting = function() return _merge_buckets({ "tool", "part", "upgrade" }) end,

    food  = function() return _filter_eatable_by_kind({ i_food = true, i_mutant_cooked = true }) end,
    drink = function() return _filter_eatable_by_kind({ i_drink = true }) end,
}

local _category_sections_cache = {}

--- Get the list of sections that belong to a category - the symmetric inverse of get_section_category, built once per session and cached.
--- Per-NPC categories (equipped, ammo_slot_*) and "untouchable" / "other" / "weapon" return empty (not enumerable as one section set).
--- @safety SAFE - returns empty list for nil, unknown, or per-NPC / sentinel categories
--- @cost O(1) cached; first call ~10 ops for hand-sets, ~50-200 for _ITM bucket walks, no ini_sys walks
--- @src anomaly/_g.script(3173,3230) _ITM + Parse_ITM
--- @param category string Category name (same set as get_section_category result)
--- @return table List of section names, order unspecified (caller sorts if order matters)
function get_category_sections(category)
    if not category then return {} end
    local cached = _category_sections_cache[category]
    if cached then return cached end
    local builder = _SECTION_BUILDERS[category]
    local list = builder and builder() or {}
    _category_sections_cache[category] = list
    return list
end

local _cost_cache = {}

--- Get an item section's vanilla cost (the system.ltx cost field), cached per session; nil when the section or key is missing.
--- The caller picks the miss default by context (trade uses 30, loot detection 0) and owns condition-aware pricing.
--- @safety SAFE - nil-guarded sec; r_float_ex returns nil when section or key missing
--- @cost O(1) cached, 1 luabind heavy on miss (r_float_ex: section_exist + line_exist + r_float ini parse)
--- @src anomaly/_g.script(1525-1529), anomaly/axr_trade_manager.script(236), xray/xrServerEntities/script_ini_file.cpp(93)
--- @param sec string Item section name
--- @return number|nil Cost in rubles, or nil if section / key missing
function get_cost(sec)
    if not sec then return nil end
    local cached = _cost_cache[sec]
    if cached ~= nil then return cached or nil end
    local v = ini_sys:r_float_ex(sec, "cost")
    _cost_cache[sec] = v or false
    return v
end

--- Translated player-facing name of an item section: resolves inv_name through the string table.
--- Falls back to the section id on any miss, so the return is always a usable display string.
--- @safety SAFE - nil-guarded sec; returns the section id on any miss
--- @cost O(1) | 1 r_string_ex + 1 translate
--- @src xray/xrServerEntities/script_ini_file.cpp r_string_ex; anomaly inv_name -> game.translate_string convention
--- @param sec string Item section name
--- @return string Display name, or the section id on miss
function get_item_name(sec)
    if not sec then return "" end
    local key = ini_sys:r_string_ex(sec, "inv_name")
    if key and key ~= "" then
        local name = game.translate_string(key)
        if name and name ~= "" then return name end
    end
    return sec
end

local _box_size_cache = {}

--- Get the ammo box size (rounds per stack) for an ammo section, cached per session.
--- The section_exist + line_exist guard avoids the r_u32 fatal on a miss.
--- @safety SAFE - section_exist + line_exist guard before r_u32 (which fatals via THROW3 otherwise)
--- @cost O(1) cached, 3 luabind heavy on miss (section_exist, line_exist, r_u32)
--- @src xray/xrServerEntities/script_ini_file.cpp(36,41,79)
--- @param sec string Ammo section name
--- @return number|nil Box size or nil if section/key missing
function get_box_size(sec)
    if not sec then return nil end
    local v = _box_size_cache[sec]
    if v then return v end
    if not ini_sys:section_exist(sec) or not ini_sys:line_exist(sec, "box_size") then return nil end
    v = ini_sys:r_u32(sec, "box_size")
    if v then _box_size_cache[sec] = v end
    return v
end

-- CATEGORY RESOLVER

--- Resolve the category from a section name (no item required); untouchables (quest / anim / blacklisted) gate first.
--- Ammo always returns "ammo_not_equipped" (per-NPC tiers live in get_category); weapons detect by class prefix "WP_".
--- @safety SAFE - nil-guarded sec
--- @cost O(1) | up to ~14 hash lookups + 1 luabind heavy on cache miss (kind, class via cached _get_kind / _get_class)
--- @param sec string Item section name
--- @return string Category name
function get_section_category(sec)
    if not sec then return "other" end

    if IsItem("quest", sec) or IsItem("anim", sec) then return "untouchable" end
    _build_blacklist()
    if _blacklist_set[sec] then return "untouchable" end

    if _medkit_set[sec]   then return "medkit"  end
    if _bandage_set[sec]  then return "bandage" end
    if _antirad_set[sec]  then return "antirad" end
    if _stim_set[sec]     then return "stim"    end
    if _pill_set[sec]     then return "pill"    end
    if _grenade_set[sec]  then return "grenade" end

    local kind = _get_kind(sec)
    if kind == "i_food" or kind == "i_mutant_cooked" then return "food"  end
    if kind == "i_drink"                              then return "drink" end

    if IsItem("grenade_ammo", sec) then return "grenade_ammo"      end
    if IsItem("ammo",         sec) then return "ammo_not_equipped" end
    if IsItem("artefact",     sec) then return "artefact" end
    if IsItem("outfit",       sec) then return "outfit"   end
    if IsItem("helmet",       sec) then return "helmet"   end
    if IsItem("device",       sec) then return "device"   end
    if IsItem("money",        sec) then return "money"    end
    if IsItem("tool", sec) or IsItem("part", sec) or IsItem("upgrade", sec) then return "crafting" end

    local cls = _get_class(sec)
    if cls and cls:sub(1, 3) == "WP_" then return "weapon" end

    return "other"
end

--- Resolve a per-NPC ammo category from a section + opts (no item required) - the section-string form of get_category's ammo branch.
--- For item-less callers like the stash loot scan; nil when the section is not ammo.
--- @safety SAFE - nil-guarded sec; opts optional (nil opts -> "ammo_not_equipped")
--- @cost O(1) | 1 IsItem hash lookup + up to 2 cached get_ammo_tier_map lookups
--- @src anomaly/_g.script IsItem + parse_list, xinventory.get_ammo_tier_map
--- @param sec string Ammo section name
--- @param opts table|nil { equipped_pistol_sec, equipped_rifle_sec }
--- @return string|nil "ammo_slot_2_tN" / "ammo_slot_3_tN" / "ammo_not_equipped" / nil (not ammo)
function resolve_ammo_category(sec, opts)
    if not sec or not IsItem("ammo", sec) then return nil end
    if not opts then return "ammo_not_equipped" end
    if opts.equipped_pistol_sec then
        local tier = get_ammo_tier_map(opts.equipped_pistol_sec, 2)[sec]
        if tier then return "ammo_slot_2_t" .. tier end
    end
    if opts.equipped_rifle_sec then
        local tier = get_ammo_tier_map(opts.equipped_rifle_sec, 2)[sec]
        if tier then return "ammo_slot_3_t" .. tier end
    end
    return "ammo_not_equipped"
end

--- Resolve the category for a live item with per-NPC opts: three runtime untouchable checks (story_id, companion-gifted, strapped) apply.
--- Then the opts.equipped_ids check, then ammo tier resolution per equipped pistol / rifle; the rest delegates to get_section_category.
--- @safety SAFE - nil-guarded item; opts entirely optional; axr_companions module guarded
--- @cost O(1) | get_section_category cost + item:section/id luabind + 3 hash lookups (story_id, assigned, strapped)
--- @src xray/xrGame/script_game_object_script.cpp section(), anomaly/_g.script get_object_story_id, anomaly/axr_companions.script is_assigned_item
--- @src anomaly/_g.script:2647-2653 (se_load_var ignores the save_name arg; "" matches the itms_manager pattern)
--- @param item game_object Inventory item
--- @param opts table|nil { equipped_ids, equipped_pistol_sec, equipped_rifle_sec, npc_id }
--- @return string Category name
--- @return string|nil The item's section, resolved here already so callers need not re-read it; nil for a nil / sectionless item
function get_category(item, opts)
    if not item then return "other" end
    local sec = item:section()
    if not sec then return "other" end

    local base = get_section_category(sec)

    if base == "untouchable" then return base, sec end

    local item_id = item:id()
    if get_object_story_id and get_object_story_id(item_id) then return "untouchable", sec end
    if opts and opts.npc_id and axr_companions and axr_companions.is_assigned_item
        and axr_companions.is_assigned_item(opts.npc_id, item_id) then return "untouchable", sec end
    if se_load_var and se_load_var(item_id, "", "strapped_item") then return "untouchable", sec end

    if opts and opts.equipped_ids and opts.equipped_ids[item_id] then return "equipped", sec end

    if base == "ammo_not_equipped" then
        local resolved = resolve_ammo_category(sec, opts)
        if resolved then return resolved, sec end
    end

    return base, sec
end

--- True if the section's category equals the given category name (routes through get_section_category).
--- Per-NPC categories (equipped, ammo_slot_*) are never returned on this path, so those always read false; use get_category for them.
--- @safety SAFE - nil-guarded sec and category
--- @cost O(1) | get_section_category cost (~13 hash lookups + cached kind/class on miss)
--- @param sec string Item section name
--- @param category string Category name from the get_section_category result set
--- @return boolean
function is_in_category(sec, category)
    return sec ~= nil and category ~= nil and get_section_category(sec) == category
end

-- RANK GATE

-- True when the actor's rank is below the floor tier named for this section or category.
-- A missing floor entry or unresolved tier name returns false (no block).
local function _is_below_rank_floor(actor, floor, section, category)
    local tier = floor and (floor[section] or floor[category])
    if not tier then return false end
    local interval = ranks.get_rank_interval(tier)
    local lo = interval and interval[1]
    local actor_rank = actor.character_rank and actor:character_rank()
    return lo and actor_rank and actor_rank < lo or false
end

--- Rank-gated 0..1 appearance chance for a section under a ruleset: a hard rank floor, then the actor tier's first matching cost band.
--- Missing floor / tier row / bands all open (chance 1), so an unconfigured ruleset never blocks; the caller rolls and fail-closes.
--- @safety SAFE - nil-guarded section / actor / ruleset; bad tier name skips the floor
--- @cost O(1) | get_section_category + get_cost + 2 ranks lookups + O(bands) row walk (~3)
--- @src anomaly/ranks.script(56) get_obj_rank_name, (89) get_rank_interval; xray/xrGame/script_game_object_script2.cpp(106) character_rank
--- @param section string Item section name
--- @param actor game_object Player object (character_rank + rank tier source)
--- @param ruleset table { floor = { [section|category] = tier_name }, bands = { [tier_name] = { {cost,chance}, ... asc }, default = {...} } }
--- @return number Appearance chance in [0, 1]
function get_rank_chance(section, actor, ruleset)
    if not section or not actor or not ruleset then return 0 end
    local category = get_section_category(section)
    if _is_below_rank_floor(actor, ruleset.floor, section, category) then return 0 end

    local bands = ruleset.bands
    if not bands then return 1 end
    local row = bands[ranks.get_obj_rank_name(actor)] or bands.default
    if not row then return 1 end
    local cost = get_cost(section) or 0
    for i = 1, #row do
        local band = row[i]
        if band.cost and cost <= band.cost then return band.chance or 0 end
    end
    return row[#row] and row[#row].chance or 0
end

-- ITEM LIFECYCLE (moved from xobject per item-domain boundary)

--- Iterate an NPC's inventory iff the NPC is online (the engine exposes no offline server-inventory walk); nil-returns otherwise.
--- The callback returns true to stop early; max_items caps the walk and reports the truncation as a second return value.
--- @safety SAFE - returns nil on nil npc_id / callback / offline NPC
--- @cost O(min(items, max_items)) | 2 luabind (level.object_by_id trivial + iterate_inventory) + STL walk; +1 Lua closure alloc when max_items set
--- @src xray/xrGame/script_game_object_inventory_owner.cpp(266-270) IterateInventory (for-loop returns on callback == true)
--- @param npc_id number NPC entity ID
--- @param callback function(npc_go, item_go) Invoked per item; return true to stop early
--- @param max_items number|nil Cap on items walked; nil = unbounded
--- @return game_object|nil The npc game_object when iteration ran; nil if offline / invalid
--- @return boolean|nil true when max_items stopped the walk early (more items remained); nil when unbounded
function iterate_inventory(npc_id, callback, max_items)
    if not npc_id or not callback then return nil end
    if not level.present() then return nil end
    local npc_go = level.object_by_id(npc_id)
    if not npc_go then return nil end
    if not max_items then
        npc_go:iterate_inventory(callback, npc_go)
        return npc_go
    end
    local scanned = 0
    local hit_cap = false
    npc_go:iterate_inventory(function(owner, item)
        scanned = scanned + 1
        if scanned > max_items then
            hit_cap = true
            return true
        end
        return callback(owner, item)
    end, npc_go)
    return npc_go, hit_cap
end

--- Force a requested condition onto a freshly created item that itms_manager silently dropped it for (no use_condition flag).
--- Gated on not is_degradable so the degradable path (including cond_r/cond_cr) is left untouched.
--- @safety SAFE - skips nil se, table (ammo) returns without an id, and missing/zero cond
local function _apply_cond(se, section, t)
    if se and t and t.cond and se.id and not utils_item.is_degradable(nil, section) then
        alife_process_item(section, se.id, { cond = t.cond })
    end
    return se
end

--- Create an item on any NPC (online, offline, cross-map); all three branches route through alife_create_item.
--- An offline NPC with an invalid lvid falls back to its smart terrain's position as the spawn anchor.
--- @safety SAFE - all branches nil-guarded; smart fallback validates lvid
--- @cost O(log n) | 2-4 luabind (alife_object medium + alife_create_item heavy)
--- @src anomaly/_g.script(2129), anomaly/itms_manager.script(1254)
--- @src xray/xrGame/alife_simulator_script.cpp(175,232)
--- @param section string Item section to create
--- @param npc_id number NPC ID (online or offline)
--- @param t table|nil { ammo, cond, uses, cond_r, cond_ct, cond_cr } forwarded to itms_manager
--- @return cse_alife_object|table|nil Created entity or table of ammo entities, or nil
function create_item(section, npc_id, t)
    if not section or not npc_id then return nil end

    if level.present() then
        local npc = level.object_by_id(npc_id)
        if npc then return _apply_cond(alife_create_item(section, npc, t), section, t) end
    end

    local se_npc = alife_object(npc_id)
    if not se_npc then return nil end

    if xlevel.is_valid_lvid(se_npc) then
        return _apply_cond(alife_create_item(section, se_npc, t), section, t)
    end

    local smart_id = se_npc.m_smart_terrain_id
    if not smart_id then return nil end
    local smart = alife_object(smart_id)
    if not smart or not xlevel.is_valid_lvid(smart) then return nil end

    return _apply_cond(alife_create_item(section, {
        smart.position, smart.m_level_vertex_id, smart.m_game_vertex_id, npc_id
    }, t), section, t)
end

--- Transfer an item from one NPC to another. Wraps from_npc:transfer_item(item, to_npc); event-queued in engine, safe mid-iterate.
--- @safety SAFE - returns nil on nil args
--- @cost O(1) | 1 luabind (transfer_item: event queue enqueue)
--- @src xray/xrGame/script_game_object_inventory_owner.cpp(601)
--- @param from_npc game_object Source owner
--- @param item game_object Item to move
--- @param to_npc game_object Destination owner
--- @return boolean Success
function transfer_item(from_npc, item, to_npc)
    if not from_npc or not item or not to_npc then return false end
    from_npc:transfer_item(item, to_npc)
    return true
end

--- Release an item from the simulation (alife_release_id). Wraps alife_release_id(item:id()); event-queued, safe mid-iterate.
--- @safety SAFE - nil-guarded item
--- @cost O(1) | 1 luabind (alife_release_id: event queue enqueue)
--- @src anomaly/_g.script alife_release_id, xray/xrGame/alife_simulator_script.cpp
--- @param item game_object Item to release
--- @return boolean Success
function release_item(item)
    if not item then return false end
    alife_release_id(item:id())
    return true
end

--- Release an item from the simulation by id - the id-based sibling of release_item, so it works on offline items too.
--- Event-queued, safe mid-iterate.
--- @safety SAFE - nil-guarded id
--- @cost O(1) | 1 luabind (alife_release_id: event queue enqueue)
--- @src anomaly/_g.script alife_release_id, xray/xrGame/alife_simulator_script.cpp
--- @param id number Item entity id
--- @return boolean Success
function release_item_id(id)
    if not id then return false end
    alife_release_id(id)
    return true
end

-- Policy primitives: one uniform LTX policy shape shared by every consumer; the values live in the consumer mods (see architecture.md).

-- Parse a policy rule cell: "min, max" -> { min, max }, a bare "max" -> { min = 0, max }.
-- Empty or malformed cells yield nil.
local function _parse_rule(value)
    if not value or value == "" then return nil end
    local min_str, max_str = string_match(value, "(%S+)%s*,%s*(%S+)")
    if min_str then
        local min, max = tonumber(min_str), tonumber(max_str)
        if min and max then return { min = min, max = max } end
    end
    local max_only = tonumber(value)
    if max_only then return { min = 0, max = max_only } end
    return nil
end

-- Contribution one item makes to its category count: ammo categories count rounds, others count 1 item per stack.
local function _get_unit(category, item)
    if category == "ammo_not_equipped"
        or string_sub(category, 1, 11) == "ammo_slot_2"
        or string_sub(category, 1, 11) == "ammo_slot_3" then
        return item:ammo_get_count() or 0
    end
    return 1
end

-- Route one parsed LTX line into the accumulating block: numeric specials to block.specials, rows to entries + rules[key].
-- A key is a category name or an item section name; both share one rules map, and malformed lines are skipped.
local function _read_policy_line(key, value, specials_set, block)
    if not key or key == "" then return end
    if specials_set[key] then
        block.specials[key] = tonumber(value) or 0
        return
    end
    local rule = _parse_rule(value)
    if not rule then return end
    block.entries[#block.entries + 1] = { category = key, rule = rule }
    block.rules[key] = rule
end

-- Load one policy block (one section). Missing section yields empty block.
local function _load_policy_block(ini, section, specials_set)
    local block = { entries = {}, rules = {}, specials = {} }
    if not ini or not ini:section_exist(section) then return block end
    local line_count = ini:line_count(section)
    for i = 0, line_count - 1 do
        local _, key, value = ini:r_line_ex(section, i, "", "")
        _read_policy_line(key, value, specials_set, block)
    end
    return block
end

--- Load an LTX policy file with the uniform {min, max}-per-key shape; each named section yields { entries, rules, specials }.
--- entries preserves declaration order (= BUY / LOOT priority), rules is the per-key hash, specials carries the specials_set numerics.
--- @safety SAFE - missing file / section / line yields empty block; malformed lines skipped
--- @cost O(lines) | per line: 1 luabind heavy r_line_ex
--- @src anomaly/axr_trade_manager precedent (per-section buy_sell rows; this generalizes to per-category)
--- @param path string LTX path under gamedata/configs (e.g. "mymod\\my_policy.ltx")
--- @param sections table Array of section names to load
--- @param specials_set table|nil Hash {key=true} of keys to extract as specials[key]=number
--- @return table { [section] = { entries = ordered_list, rules = hash, specials = hash } }
function load_policy(path, sections, specials_set)
    local result = {}
    if not path or not sections then return result end
    specials_set = specials_set or {}
    local ini = ini_file(path)
    for s = 1, #sections do
        result[sections[s]] = _load_policy_block(ini, sections[s], specials_set)
    end
    return result
end

--- Resolve the policy key for a live item: its section when named in rules, else its category - the one place that override lives.
--- Returns nil for untouchable / equipped items; the category and section come back as extra returns.
--- @safety SAFE - nil-guarded item
--- @cost O(1) | get_category cost (which also returns the section) + 1 hash lookup
--- @src xray/xrGame/script_game_object_script.cpp section()
--- @param item game_object Inventory item
--- @param opts table|nil From get_category_opts(npc)
--- @param rules table|nil From load_policy(...).rules; nil = category key only
--- @return string|nil policy key (section name or category name), nil if untouchable/equipped
--- @return string|nil item category
--- @return string|nil item section
function get_policy_key(item, opts, rules)
    local cat, sec = get_category(item, opts)
    if cat == "untouchable" or cat == "equipped" then return nil, cat end
    return (rules and rules[sec]) and sec or cat, cat, sec
end

--- Count an online NPC's inventory per policy key in one iterate; untouchable and equipped items never reach the counts.
--- Ammo keys count in ROUNDS, other keys in ITEMS; a section named in rules counts under its section key, not its category.
--- @safety SAFE - nil-guarded npc; offline npc yields empty (iterate_inventory online-only)
--- @cost O(min(items, max_items)) | per item: get_policy_key + 0-1 ammo_get_count
--- @src xray/xrGame/script_game_object_inventory_owner.cpp(266-270) iterate_inventory
--- @param npc game_object Online NPC
--- @param opts table|nil From get_category_opts(npc); nil opts treats every ammo as ammo_not_equipped
--- @param rules table|nil From load_policy(...).rules; nil = pure per-category counting
--- @param max_items number|nil Cap forwarded to iterate_inventory; nil = unbounded
--- @return table { [category|section] = count }
--- @return boolean|nil true when the walk was capped at max_items (more items remained)
function collect_policy_counts(npc, opts, rules, max_items)
    local counts = {}
    if not npc then return counts end
    local _, hit_cap = iterate_inventory(npc:id(), function(_, item)
        if not item then return end
        local key, cat = get_policy_key(item, opts, rules)
        if not key then return end
        counts[key] = (counts[key] or 0) + _get_unit(cat, item)
    end, max_items)
    return counts, hit_cap
end

--- Walk an NPC's inventory and hand each item above its policy max to ctx.on_surplus, decrementing ctx.counts in place.
--- unit == 1 keys land exactly at max; ammo releases whole stacks, so the final count can undershoot by up to unit - 1 rounds.
--- @safety SAFE - nil-guarded args; iterate_inventory tolerant of nil items
--- @cost O(min(items, max_items)) | per item: get_policy_key + 1 hash lookup + 0-1 ammo_get_count
--- @src xray/xrGame/script_game_object_inventory_owner.cpp(266-270) iterate_inventory
--- @param npc game_object Online NPC
--- @param opts table|nil From get_category_opts(npc)
--- @param ctx table { rules, counts (mutable, from collect_policy_counts), on_surplus = fn(item, cat, sec, unit), max_items|nil }
--- @return number Count of surplus items ctx.on_surplus was called on
function iterate_surplus(npc, opts, ctx)
    if not npc or not ctx or not ctx.rules or not ctx.counts or not ctx.on_surplus then return 0 end
    local rules, counts, on_surplus = ctx.rules, ctx.counts, ctx.on_surplus
    local invoked = 0
    iterate_inventory(npc:id(), function(_, item)
        if not item then return end
        local key, cat, sec = get_policy_key(item, opts, rules)
        if not key then return end
        local rule = rules[key]
        if not rule or not rule.max then return end
        local unit = _get_unit(cat, item)
        local count = counts[key] or 0
        if count <= rule.max then return end
        counts[key] = count - unit
        invoked = invoked + 1
        return on_surplus(item, cat, sec, unit) == true
    end, ctx.max_items)
    return invoked
end

--- Count an NPC's inventory per policy key AND release its surplus in one engine walk - the drop-in single-walk form.
--- The release runs after the walk over a captured list (never during a live iterate), same released set and order, half the per-item cost.
--- @safety SAFE - nil-guarded npc / rules / on_surplus; iterate tolerant of nil items
--- @cost O(min(items, max_items)) | per item: get_policy_key + 1 _get_unit + 1 hash; then 0-N on_surplus
--- @src xray/xrGame/script_game_object_inventory_owner.cpp(266-270) iterate_inventory
--- @param npc game_object Online NPC
--- @param opts table|nil From get_category_opts(npc)
--- @param ctx table { rules, on_surplus = fn(item, cat, sec, unit) (return true to stop early), max_items|nil }
--- @return number Count of surplus items on_surplus was called on
--- @return table Post-release per-key counts (identical to collect_policy_counts then iterate_surplus)
--- @return boolean|nil true when the walk was capped at max_items (more items remained)
function collect_surplus(npc, opts, ctx)
    local counts = {}
    if not npc or not ctx or not ctx.rules or not ctx.on_surplus then return 0, counts, nil end
    local rules, on_surplus = ctx.rules, ctx.on_surplus
    local list = {}
    local _, hit_cap = iterate_inventory(npc:id(), function(_, item)
        if not item then return end
        local key, cat, sec = get_policy_key(item, opts, rules)
        if not key then return end
        local unit = _get_unit(cat, item)
        counts[key] = (counts[key] or 0) + unit
        local rule = rules[key]
        if rule and rule.max then
            list[#list + 1] = { item = item, key = key, cat = cat, sec = sec, unit = unit, max = rule.max }
        end
    end, ctx.max_items)

    local released = 0
    for i = 1, #list do
        local entry = list[i]
        local count = counts[entry.key]
        if count > entry.max then
            counts[entry.key] = count - entry.unit
            released = released + 1
            if on_surplus(entry.item, entry.cat, entry.sec, entry.unit) == true then break end
        end
    end
    return released, counts, hit_cap
end

--- Derive surplus per policy key from counts vs rules (pure): keys where count > rule.max, with the surplus amount.
--- An unmentioned key never shows as surplus; stash fill plans deposits off this without re-walking inventory.
--- @safety SAFE - nil-guarded inputs (returns empty)
--- @cost O(counts) pure Lua, no luabind
--- @param counts table From collect_policy_counts(npc, opts, rules)
--- @param rules table From load_policy(...).rules
--- @return table { [category|section] = surplus_count } (only entries with surplus > 0)
function build_surplus_map(counts, rules)
    local surplus = {}
    if not counts or not rules then return surplus end
    for key, count in pairs(counts) do
        local rule = rules[key]
        local max = rule and rule.max
        if max and count > max then
            surplus[key] = count - max
        end
    end
    return surplus
end

--- True when a before_move event is the actor taking an item OUT of a dead body (a deposit reads iActorBag and is false).
--- Every take path funnels through Cond_Move, so a before_move handler that vetoes here with disable_move blocks them all.
--- @safety SAFE - pure enum compare, no luabind
--- @cost O(1) | 0 luabind
--- @src EDDListType.iDeadBodyBag; ui_inventory.script:241-242,908-918,2251 (Cond_Move funnel; npc_bag -> iDeadBodyBag)
--- @param mode string actor-menu mode (the callback's 4th arg)
--- @param bag number source list type, an EDDListType value (the callback's 5th arg)
--- @return boolean
function is_corpse_take(mode, bag)
    return mode == "loot" and bag == EDDListType.iDeadBodyBag
end

--- Veto an actor-menu move from a before_move handler; Cond_Move aborts the move when ret_value is cleared (ui_inventory.script:915-917).
--- @safety SAFE - sets one field on the engine-provided flags table
--- @cost O(1) | 0 luabind
--- @param flags table the before_move callback's 1st arg
function disable_move(flags)
    if flags then flags.ret_value = false end
end

-- INVENTORY DUMP (diagnostic)

-- Tally one item's section into counts/order (order preserves first-seen for a stable line).
local function _add_count(sec, counts, order)
    counts[sec] = (counts[sec] or 0) + 1
    if counts[sec] == 1 then order[#order + 1] = sec end
end

--- Dump an NPC's inventory to a log function as ONE aggregated per-section-counts line.
--- Call it behind the calling mod's own debug gate; it does no gating itself.
--- @safety SAFE - nil-guarded npc and log_fn
--- @cost O(inventory): 1 walk + 1 section read per item + 1 write
--- @src xray/xrGame/script_game_object_inventory_owner.cpp:256 (iterate_inventory)
--- @param npc game_object trader or NPC to dump
--- @param tag string label for the log line (the calling feature: "trade", "market", "service", ...)
--- @param log_fn function(fmt, ...) sink, called once with the summary (a mod's own debug logger)
--- @return nil
function log_inventory(npc, tag, log_fn)
    if not (npc and log_fn) then return end
    local counts, order, total = {}, {}, 0
    npc:iterate_inventory(function(_, it)
        total = total + 1
        _add_count(it:section(), counts, order)
    end, npc)
    local parts = {}
    for k = 1, #order do parts[k] = order[k] .. " x" .. counts[order[k]] end
    log_fn("inv_dump(%s) npc=%d n=%d [%s]", tag, npc:id(), total, table_concat(parts, ", "))
end
