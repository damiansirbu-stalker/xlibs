--- xfs: virtual filesystem enumeration - clean folder/file lists over getFS():file_list_open + the FS.* flag bits (results unsorted)

local getFS, bit_or, FS = getFS, bit_or, FS

--- List the subfolder names directly under a directory in a mount, cleaned of separators and . / .. entries.
--- Root-only (not recursive). A missing directory yields an empty list.
--- @safety SAFE - nil-guarded (empty list on a missing dir)
--- @cost 1 luabind (file_list_open) + O(entries)
--- @param mount string The FS mount point (e.g. "$game_sounds$")
--- @param dir string The directory under the mount (trailing separator expected)
--- @return table The array of subfolder names
function read_folders(mount, dir)
    local out = {}
    local fl = getFS():file_list_open(mount, dir, bit_or(FS.FS_ListFolders, FS.FS_RootOnly))
    for i = 1, (fl and fl:Size() or 0) do
        local name = fl:GetAt(i - 1):gsub("[\\/]", "")
        if name ~= "" and name ~= "." and name ~= ".." then out[#out + 1] = name end
    end
    return out
end

--- List the file names directly under a directory in a mount. Root-only (not recursive). With ext (e.g.
--- ".ogg"), only matching files are returned and the extension is stripped; without ext, every name verbatim.
--- @safety SAFE - nil-guarded (empty list on a missing dir)
--- @cost 1 luabind (file_list_open) + O(entries)
--- @param mount string The FS mount point (e.g. "$game_sounds$")
--- @param dir string The directory under the mount (trailing separator expected)
--- @param ext string|nil Optional extension filter (e.g. ".ogg"); stripped from returned names
--- @return table The array of file names
function read_files(mount, dir, ext)
    local out = {}
    local fl = getFS():file_list_open(mount, dir, bit_or(FS.FS_ListFiles, FS.FS_RootOnly))
    local ext_len = ext and #ext
    for i = 1, (fl and fl:Size() or 0) do
        local fname = fl:GetAt(i - 1)
        if not ext then
            out[#out + 1] = fname
        elseif fname:sub(-ext_len) == ext then
            out[#out + 1] = fname:sub(1, -ext_len - 1)
        end
    end
    return out
end

--- List the file names under a directory in a mount, recursing into subfolders because FS_RootOnly is omitted.
--- With ext only matching files return and the extension is stripped; without ext every name is verbatim and subpath-qualified.
--- @safety SAFE - nil-guarded (empty list on a missing dir)
--- @cost 1 luabind (file_list_open) + O(entries in the subtree)
--- @param mount string The FS mount point (e.g. "$game_scripts$")
--- @param dir string The directory under the mount (trailing separator expected)
--- @param ext string|nil Optional extension filter (e.g. ".script"); stripped from returned names
--- @return table The array of subpath-qualified file names
function read_files_deep(mount, dir, ext)
    local out = {}
    local fl = getFS():file_list_open(mount, dir, FS.FS_ListFiles)
    local ext_len = ext and #ext
    for i = 1, (fl and fl:Size() or 0) do
        local fname = fl:GetAt(i - 1)
        if not ext then
            out[#out + 1] = fname
        elseif fname:sub(-ext_len) == ext then
            out[#out + 1] = fname:sub(1, -ext_len - 1)
        end
    end
    return out
end

--- Read a whole text file from disk (libc io on a real path, not the engine VFS), or nil if unreadable.
--- The sanctioned filesystem home: consumers route here instead of raw io so the fs surface stays in one place.
--- @safety SAFE - nil on a missing or unreadable file, never raises.
--- @novalidate(security.fs_access, reason:"xfs is the single sanctioned filesystem home; consumers route here instead of raw io")
--- @cost 1 libc open + O(bytes)
--- @param path string The file path
--- @return string|nil The file contents, or nil
function read_file(path)
    local file = io.open(path, "r")
    if not file then return nil end
    local data = file:read("*a")
    file:close()
    return data
end

--- Write text to a file on disk (libc io on a real path). append=true adds to the end, else overwrites.
--- The sanctioned filesystem home: consumers route here instead of raw io so the fs surface stays in one place.
--- @safety SAFE - false on an open failure, never raises.
--- @novalidate(security.fs_access, reason:"xfs is the single sanctioned filesystem home; consumers route here instead of raw io")
--- @cost 1 libc open + O(bytes)
--- @param path string The file path
--- @param text string The content to write
--- @param append boolean|nil True to append, else overwrite
--- @return boolean True on success
function write_file(path, text, append)
    local file = io.open(path, append and "a" or "w")
    if not file then return false end
    file:write(text)
    file:close()
    return true
end

--- Resolve a mount-relative path to its full VFS path (wraps getFS():update_path).
--- The sanctioned filesystem home: consumers route here instead of a raw getFS() call.
--- @safety SAFE - a pure path resolve, never raises.
--- @cost 1 luabind (update_path)
--- @param mount string The FS mount point (e.g. "$game_scripts$")
--- @param rel string The path relative to the mount ("" for the mount root)
--- @return string The full VFS path
function resolve_path(mount, rel)
    return getFS():update_path(mount, rel)
end
