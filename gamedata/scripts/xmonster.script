--- Controller per-hit stamina drain; negative keeps current.
--- @safety SAFE - nil-guarded, false below the bind; controller only
--- @cost O(1) | 1 luabind trivial (field write)
--- @src modded-exes/lua_help_ex.script (set_controller_stamina_hit)
--- @param mob game_object controller
--- @param value number stamina drained per psi hit
--- @return boolean true when the engine path applied
function xmonster.set_controller_stamina_hit(mob, value)
    if not mob or not _has_bind(mob, "set_controller_stamina_hit") then return false end
    mob:set_controller_stamina_hit(value)
    return true
end

--- Poltergeist hover-height family (band, change velocity, dwell band); nil component = keep - the per-spawn visible variation.
--- @safety SAFE - nil-guarded, false below the bind; poltergeist only
--- @cost O(1) | 1 luabind trivial (field writes)
--- @src modded-exes/lua_help_ex.script (set_poltergeist_height_params)
--- @param mob game_object poltergeist
--- @param opts table { height_min, height_max, change_velocity, min_time_ms, max_time_ms }, nil = keep
--- @return boolean true when the engine path applied
function xmonster.set_poltergeist_height_params(mob, opts)
    if not mob or not opts or not _has_bind(mob, "set_poltergeist_height_params") then return false end
    mob:set_poltergeist_height_params(_get_keep(opts.height_min), _get_keep(opts.height_max),
        _get_keep(opts.change_velocity), _get_keep(opts.min_time_ms), _get_keep(opts.max_time_ms))
    return true
end

--- Poltergeist actor-detection family (near/far range factors, far range, accumulation speed, loose speed); nil component = keep.
--- @safety SAFE - nil-guarded, false below the bind; poltergeist only (engine error-logs other species)
--- @cost O(1) | 1 luabind trivial (field writes)
--- @src modded-exes/lua_help_ex.script (set_poltergeist_detection_params), xray/ai/monsters/poltergeist/poltergeist.cpp:146-150
--- @param mob game_object poltergeist
--- @param opts table { near_factor, far_factor, far_range, speed_factor, loose_speed }, nil = keep
--- @return boolean true when the engine path applied
function xmonster.set_poltergeist_detection_params(mob, opts)
    if not mob or not opts or not _has_bind(mob, "set_poltergeist_detection_params") then return false end
    mob:set_poltergeist_detection_params(_get_keep(opts.near_factor), _get_keep(opts.far_factor),
        _get_keep(opts.far_range), _get_keep(opts.speed_factor), _get_keep(opts.loose_speed))
    return true
end

--- Play a named motion on a monster in place (set_override_animation): the motion resolves by registered prefix and REPLAYS until stopped.
--- THE CALLER OWNS STOPPING IT (a timer or the jump read) - a standing override suppresses movement animations indefinitely.
--- @safety SAFE - nil-guarded, false below the bind; an unknown motion name engine-logs and plays nothing
--- @cost O(1) | 1 luabind trivial (override fields write)
--- @src modded-exes/lua_help_ex.script (set_override_animation), xray/ai/monsters/control_animation_base_update.cpp:169-194 (prefix resolve)
--- @param mob game_object monster
--- @param motion_name string motion name with index suffix (e.g. "jump_attack_0")
--- @return boolean true when the engine path applied
function xmonster.play_monster_animation(mob, motion_name)
    if not mob or not motion_name or not _has_bind(mob, "set_override_animation") then return false end
    mob:set_override_animation(motion_name)
    return true
end

--- Stop a play_monster_animation override; safe at any time, the base animation selection resumes next frame.
--- @safety SAFE - nil-guarded, false below the bind
--- @cost O(1) | 1 luabind trivial (override fields reset)
--- @src modded-exes/lua_help_ex.script (clear_override_animation), xray/ai/monsters/control_animation_base_update.cpp:134-138
--- @param mob game_object monster
--- @return boolean true when the engine path applied
function xmonster.stop_monster_animation(mob)
    if not mob or not _has_bind(mob, "clear_override_animation") then return false end
    mob:clear_override_animation()
    return true
end

--- Register fn on the monster combat-decision relay (monster_on_combat_action): set flags.substate to a monster_state.* id, -1 = vanilla.
--- Fires per combat-active monster per frame (engine-memoized once per monster) - the subscriber's silent path must be pure Lua.
--- @safety SAFE - registers only behind the functor probe, false on any floor/absent path
--- @cost O(1) | one-time registration; the handler pays per fire
--- @src modded-exes/lua_help_ex.script, xray gamedata callbacks_gameobject.script:252-267, xray/base_monster.cpp:1064-1087 (memoized)
--- @param fn function subscriber fn(monster, enemy, dist, enemy_strength, can_jump, flags)
--- @return boolean true when registered, false when this exe has no decision relay
function xmonster.on_monster_combat_action(fn)
    if type(fn) ~= "function" then return false end
    if callbacks_gameobject == nil then return false end
    if type(rawget(_G, "CMonsterCombatAction")) ~= "function" then return false end
    RegisterScriptCallback("monster_on_combat_action", fn)
    return true
end
