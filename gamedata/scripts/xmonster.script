--- Script-forced jump flags, OR'd onto every jump's own fill - never clears an engine-set flag; auto_aim needs its factor too (configs ship 0).
--- @safety SAFE - nil-guarded, false below the bind
--- @cost O(1) | 1 luabind trivial (flag mask write)
--- @src modded-exes/lua_help_ex.script (set_monster_jump_flags), xray/ai/monsters/control_jump.cpp (activate OR)
--- @param mob game_object monster
--- @param opts table { auto_aim, prepare_in_move, ground_skip (booleans, default false), auto_aim_factor (nil = keep) }
--- @return boolean true when the engine path applied
function xmonster.set_monster_jump_flags(mob, opts)
    if not mob or not opts or not _has_bind(mob, "set_monster_jump_flags") then return false end
    mob:set_monster_jump_flags(opts.auto_aim == true, opts.prepare_in_move == true,
        opts.ground_skip == true, _get_keep(opts.auto_aim_factor))
    return true
end

