    return mob:get_monster_movement_info()
end

--- Monster health, a NORMALIZED fraction [0,1] - the condition update clamps to max_health()=1.0 so LTX Health points never surface here. 0 when unreadable.
--- @safety SAFE - nil-guarded; the property read is engine-SAFE_WRAPped
--- @cost O(1) | 1 luabind trivial (health property read)
--- @src xray/script_game_object_script2.cpp:76 (.property health), xray/EntityCondition.cpp:20,338 (MAX_HEALTH 1.0, the per-update clamp)
--- @param mob game_object monster
--- @return number health fraction [0,1], 0 when mob is nil
function xmonster.get_monster_health(mob)
    if not mob then return 0 end
    return mob.health
end

--- Write monster health, a NORMALIZED fraction [0,1]; clamped to max_health()=1.0 next tick, so a value from the absolute LTX base caps to full - the trap.
--- Monster health persists in saves, so a caller writes an idempotent fraction, never a value multiplied from the current reading.
--- @safety SAFE - nil-guarded; SetHealth writes the field, the condition update clamps it into [0,1]
--- @cost O(1) | 1 luabind trivial (health property write)
--- @src xray/script_game_object_script2.cpp:76 (.property health = SetHealth), xray/EntityCondition.cpp:338 (clamp to max_health()=1.0)
--- @param mob game_object monster
--- @param fraction number normalized health [0,1] to assign
function xmonster.set_monster_health(mob, fraction)
    if not mob or not fraction then return end
    mob.health = fraction
end

--- Command the species' own jump at a target, after the interim can_jump mirror clears it - the return means feasible-and-started, so the caller believes it.
--- A force of 0 or less falls back to jump_factor; a species with none (the bloodsucker) would launch at infinite speed, so it refuses.
--- @safety SAFE - nil-guarded, false below the bind; the engine refuses during an active jump, a foreign capture, or scheme ownership
--- @cost O(1) | a few LTX reads + 2 luabind medium (restrictor test, component capture attempt)
--- @src control_manager_custom.cpp:452-485 (script_try_jump), control_jump.cpp:447-453 (force fallback), :640-680 (can_jump)
--- @param mob game_object monster
--- @param pos vector world target position
--- @param factor number jump force factor; 0 or less takes the species jump_factor
--- @param opts table|nil { skip_prepare = true } launches without the crouch wind-up (ePrepareSkip)
--- @return boolean true when the jump was feasible, captured and started
function xmonster.try_monster_jump(mob, pos, factor, opts)
    if not mob or not pos or not factor or not _has_bind(mob, "try_monster_jump") then return false end
    if factor <= 0 and not ini_sys:r_float_ex(mob:section(), "jump_factor") then return false end
    if not _can_jump(mob, pos) then return false end
    return mob:try_monster_jump(pos, factor, (opts and opts.skip_prepare) == true)
end

--- The engine's flight time for a jump at pos and force: the minimum-velocity throw time over the 3D distance, divided by the force.
--- @safety SAFE - nil-guarded, nil on a missing input or a force of 0 or less
--- @cost O(1) | 1 luabind trivial (position) + vector math
--- @src control_jump.cpp:447-453 (calculate_jump_time), MathUtils.h:314-316 (ThrowMinVelTime), Physics.cpp:54 (gravity 2 * 9.81)
--- @param mob game_object monster
--- @param pos vector world target position
--- @param factor number jump force factor, above 0
--- @return number|nil flight time in seconds
function xmonster.compute_jump_time(mob, pos, factor)
    if not mob or not pos or not factor or factor <= 0 then return nil end
    return math_sqrt(2 * mob:position():distance_to(pos) / WORLD_GRAVITY) / factor
end

--- Start a rotation-jump from the species' loaded motion data - the instant turning juke (bloodsucker, dog, gigant, pseudodog, boar).
--- @safety SAFE - nil-guarded, false below the bind; the engine refuses without data or under capture, and consults the FSM's own gate
--- @cost O(1) | 1 luabind medium (component capture attempt)
--- @src modded-exes/lua_help_ex.script (try_monster_rotation_jump), xray/ai/monsters/control_manager_custom.cpp:493
--- @param mob game_object monster
--- @return boolean true when started
function xmonster.try_monster_rotation_jump(mob)
    if not mob or not _has_bind(mob, "try_monster_rotation_jump") then return false end
    return mob:try_monster_rotation_jump()
end

