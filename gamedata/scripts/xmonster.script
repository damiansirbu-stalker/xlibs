--- xmonster: the CBaseMonster combat surface - FSM/memory readers, maneuver invokes, param setters, the decision-callback registrar

local type, rawget = type, rawget
local math_abs, math_sqrt, math_acos = math.abs, math.sqrt, math.acos
local ini_sys, RegisterScriptCallback = ini_sys, RegisterScriptCallback

xmonster = xmonster or {}

-- The fallback angle and height for a species whose jump config never loads (bloodsucker.cpp:77,87): the chimera's (m_chimera.ltx:138-139).
local FALLBACK_JUMP_ANGLE  = 0.55
local FALLBACK_JUMP_HEIGHT = 6.0

-- World gravity, the one the jump solver divides by (Physics.cpp:54).
local WORLD_GRAVITY = 2 * 9.81

-- Bind availability by name, probed once and cached for the session (the bind set is a property of the exe, immutable at runtime).
local _bind_ready = {}

-- True when the engine bind `name` exists on this exe's game_object.
-- @cost O(1) | 1 luabind trivial on the first probe (method lookup), 0 cached
local function _has_bind(mob, name)
    local ready = _bind_ready[name]
    if ready == nil then
        ready = type(mob[name]) == "function"
        _bind_ready[name] = ready
    end
    return ready
end

-- nil opts component -> -1, the engine's keep-current sentinel on every monster param setter.
local function _get_keep(value)
    if value == nil then return -1 end
    return value
end

-- The interim can_jump mirror (control_jump.cpp:640-680): the restrictor, distance, height and angle gates script_try_jump skips.
-- The cooldown is the caller's.
-- @cost O(1) | 1 luabind medium (restrictor test) + a few LTX reads + vector math
local function _can_jump(mob, pos)
    if not mob:accessible(pos) then return false end
    local sec = mob:section()
    local mp = mob:position()
    local dx, dy, dz = pos.x - mp.x, pos.y - mp.y, pos.z - mp.z
    local max_dist = ini_sys:r_float_ex(sec, "jump_max_distance")
    if max_dist then
        local dist = math_sqrt(dx * dx + dy * dy + dz * dz)
        if dist > max_dist or dist < (ini_sys:r_float_ex(sec, "jump_min_distance") or 0) then return false end
    end
    local max_h = ini_sys:r_float_ex(sec, "jump_max_height") or FALLBACK_JUMP_HEIGHT
    if math_abs(dy) > max_h then return false end
    local max_a = ini_sys:r_float_ex(sec, "jump_max_angle") or FALLBACK_JUMP_ANGLE
    local flat = math_sqrt(dx * dx + dz * dz)
    if flat > 0.01 then
        local dir = mob:direction()
        local dir_len = math_sqrt(dir.x * dir.x + dir.z * dir.z)
        if dir_len > 0.01 then
            local cos_a = (dir.x * dx + dir.z * dz) / (dir_len * flat)
            if cos_a < -1 then cos_a = -1 elseif cos_a > 1 then cos_a = 1 end
            if math_acos(cos_a) > max_a then return false end
        end
    end
    return true
end

--- Deepest resolved monster FSM state id (EMonsterState), nil below the bind - an attacking monster reports its substate (Attack_Run), not eStateAttack.
--- @safety SAFE - nil-guarded, nil below the bind
--- @cost O(1) | 1 luabind trivial (StateMan substate walk)
--- @src modded-exes/lua_help_ex.script (get_monster_state), xray/ai/monsters/monster_state_manager.cpp (get_state_type)
--- @param mob game_object monster
--- @return number|nil EMonsterState id, nil when unavailable
function xmonster.get_monster_state(mob)
    if not mob or not _has_bind(mob, "get_monster_state") then return nil end
    return mob:get_monster_state()
end

--- True while the monster's jump control is in flight - the one-animation-owner gate: never command or override a body mid-jump.
--- @safety SAFE - nil-guarded, false below the bind
--- @cost O(1) | 1 luabind trivial
--- @src modded-exes/lua_help_ex.script (is_monster_jumping), xray/ai/monsters/basemonster/base_monster.cpp:1059-1062
--- @param mob game_object monster
--- @return boolean true while a jump is active
function xmonster.is_monster_jumping(mob)
    if not mob or not _has_bind(mob, "is_monster_jumping") then return false end
    return mob:is_monster_jumping()
end

