--- Arm the dormant rear spin-strike (CControlMeleeJump) with the model's own strike motions; it then self-fires on rear exposure under 4m.
--- Motions MUST carry their own attack_params rows or release deals the first row's numbers (the damage law).
--- @safety SAFE - nil-guarded, false below the bind; an unknown motion name keeps the component refusing (engine guard)
--- @cost O(1) | 1 luabind trivial (motion resolve + data fill, once per arm)
--- @src modded-exes/lua_help_ex.script (set_monster_melee_strike), xray/ai/monsters/control_melee_jump.cpp:19-32 (the rear gate)
--- @param mob game_object monster
--- @param anim_left string left-side strike motion name
--- @param anim_right string right-side strike motion name
--- @param rear_arc_deg number rear cone width in degrees; <= 0 keeps the 120 default
--- @return boolean true when the engine path applied
function xmonster.set_monster_melee_strike(mob, anim_left, anim_right, rear_arc_deg)
    if not mob or not _has_bind(mob, "set_monster_melee_strike") then return false end
    mob:set_monster_melee_strike(anim_left, anim_right, rear_arc_deg or -1)
    return true
end

--- Melee reach band (MeleeChecker MinAttackDist/MaxAttackDist); nil component = keep current; re-set on spawn, never serialized.
--- @safety SAFE - nil-guarded, false below the bind
--- @cost O(1) | 1 luabind trivial (2 field writes)
--- @src modded-exes/lua_help_ex.script (set_monster_attack_dist), xray/ai/monsters/melee_checker.h:40-45
--- @param mob game_object monster
--- @param opts table { min_dist, max_dist } metres, nil = keep
--- @return boolean true when the engine path applied
function xmonster.set_monster_attack_dist(mob, opts)
    if not mob or not opts or not _has_bind(mob, "set_monster_attack_dist") then return false end
    mob:set_monster_attack_dist(_get_keep(opts.min_dist), _get_keep(opts.max_dist))
    return true
end

