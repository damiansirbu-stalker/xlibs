--- Force or release the burer's gravity attack - the WHEN lever for the gravi trigger (a vanilla modded-exes bind, present pre-floor).
--- @safety SAFE - nil-guarded, false below the bind; burer only (engine error-logs other species)
--- @cost O(1) | 1 luabind trivial (flag write)
--- @src modded-exes/lua_help_ex.script (burer_set_force_gravi_attack), xray/script_game_object_use2.cpp:42-53
--- @param mob game_object burer
--- @param enabled boolean true forces the gravi attack on the next decision
--- @return boolean true when the engine path applied
function xmonster.set_burer_gravi_force(mob, enabled)
    if not mob or not _has_bind(mob, "burer_set_force_gravi_attack") then return false end
    mob:burer_set_force_gravi_attack(enabled == true)
    return true
end

--- Burer gravity-attack family (cooldown, distance band, speed, radius, hit power); nil component = keep.
--- @safety SAFE - nil-guarded, false below the bind; burer only
--- @cost O(1) | 1 luabind trivial (field writes)
--- @src modded-exes/lua_help_ex.script (set_burer_gravi_params)
--- @param mob game_object burer
--- @param opts table { cooldown_ms, min_dist, max_dist, speed, radius, hit_power }, nil = keep
--- @return boolean true when the engine path applied
function xmonster.set_burer_gravi_params(mob, opts)
    if not mob or not opts or not _has_bind(mob, "set_burer_gravi_params") then return false end
    mob:set_burer_gravi_params(_get_keep(opts.cooldown_ms), _get_keep(opts.min_dist), _get_keep(opts.max_dist),
        _get_keep(opts.speed), _get_keep(opts.radius), _get_keep(opts.hit_power))
    return true
end

--- True when this exe carries the post-floor #798 monster read/trace surface (the probe sibling of the fired-event relays below).
--- @safety SAFE - false when the bind is absent; probe this before wiring the relays, so they stay inert on a baseline exe
--- @param mob game_object any monster
--- @return boolean true when the trace getters and the fired-event relays exist
function xmonster.has_trace_surface(mob)
    return mob ~= nil and _has_bind(mob, "get_monster_jump_flags")
end

--- Register fn(mob) for the engine run-attack (charge) completion; the engine fires it only on a supported exe.
function xmonster.on_run_attack_end(fn)
    RegisterScriptCallback("monster_on_run_attack_end", fn)
end

