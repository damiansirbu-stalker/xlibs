--- xtime: Game time helpers (cached epoch, game-seconds)

local _start_time = nil

--- Get game-seconds since epoch (level start time), caching level.get_start_time() per save (reset on on_game_start).
--- @safety SAFE - level.present()-guarded; level.get_start_time AVs before on_game_load, so never call this in load_state or on_game_start
--- @cost O(1) | 2 luabind (get_game_time medium: xrTime ctor; diffSec trivial), first call adds 1 luabind medium (get_start_time)
--- @src xray/xrGame/level_script.cpp(2079) get_start_time, xray/xrGame/xr_time.cpp(76) diffSec, level_script.cpp(2733) get_game_time
--- @return number Game-seconds since epoch (0 when no level)
function get_game_sec()
    if not level.present() then return 0 end
    if not _start_time then
        _start_time = level.get_start_time()
    end
    return game.get_game_time():diffSec(_start_time)
end

--- Get the engine CTime for the current in-game moment, or nil when no level is present (wrapper over game.get_game_time).
--- Engine CTime exposes only :get / :diffSec / :add / :sub / :set* / :dateToString / :timeToString - there is no :hour() or :min().
--- @safety SAFE - returns nil when no level
--- @cost O(1) | 1 luabind medium (get_game_time: xrTime ctor wrapping current u64 timestamp)
--- @src xray/xrGame/level_script.cpp(2733) get_game_time binding, xray/xrGame/xr_time.cpp xrTime
--- @return userdata|nil CTime or nil
function get_game_time()
    if not level.present() then return nil end
    return game.get_game_time()
end

--- Get the current in-game hour and minute via CTime:get(). nil, nil when no level.
--- @safety SAFE - returns nil, nil when no level
--- @cost O(1) | 2 luabind (game_time wrapper: 1 luabind medium for xrTime ctor; CTime:get: 1 luabind trivial -- split_time bit math on u64)
--- @src xray/xrGame/xr_time.cpp(71) xrTime::get -> split_time
--- @return number|nil h
--- @return number|nil m
function get_time_hm()
    local game_t = get_game_time()
    if not game_t then return nil, nil end
    local h, m = select(4, game_t:get(0, 0, 0, 0, 0, 0, 0))
    return h, m
end

function on_game_start()
    _start_time = nil
end
