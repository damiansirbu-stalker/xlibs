--- xconst: X-Ray engine sentinel constants

--- Invalid entity ID (u16 MAX, alife_space.h:39, 0xFFFF)
INVALID_ENTITY_ID = 65535

--- Invalid level vertex ID (u32 MAX, 0xFFFFFFFF)
INVALID_LEVEL_VERTEX_ID = 4294967295

--- Invalid game vertex ID (u16 MAX, GameGraph::_GRAPH_ID(-1) at xrServer_Objects_ALife.cpp:369)
INVALID_GAME_VERTEX_ID = 65535

--- Invalid bone ID (u16 MAX): game_object:get_bone_id returns it for a bone the skeleton lacks (the utils_obj.safe_bone_pos sentinel).
INVALID_BONE_ID = 65535

--- Actor entity ID (engine convention: actor allocated as first server slot, db.actor:id() == 0)
ACTOR_ENTITY_ID = 0

--- Per-NPC engine relation names (game_object:relation result mapped to a string by xcreature.relation)
RELATION = { ENEMY = "enemy", NEUTRAL = "neutral", FRIEND = "friend" }

--- Task status strings on task_manager task_info entries (axr_task_manager.script)
TASK_STATUS = { FAIL = "fail", COMPLETED = "completed" }

--- Faction community strings shared across queries (squad player_id / character community)
COMMUNITY = { TRADER = "trader", ZOMBIED = "zombied" }
