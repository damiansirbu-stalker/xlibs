--- xsmart_spawn: additive and exclusive spawn injection on smart terrains, via the respawn_params field try_respawn reads natively

local pairs, tostring, type = pairs, tostring, type

--- Faction -> generic simulation squad sections (novice, advanced, veteran); mirrors smart_terrain.script:16-29.
SQUADS_BY_FACTION = {
    army = {"army_sim_squad_novice","army_sim_squad_advanced","army_sim_squad_veteran"},
    bandit = {"bandit_sim_squad_novice","bandit_sim_squad_advanced","bandit_sim_squad_veteran"},
    csky = {"csky_sim_squad_novice","csky_sim_squad_advanced","csky_sim_squad_veteran"},
    dolg = {"duty_sim_squad_novice","duty_sim_squad_advanced","duty_sim_squad_veteran"},
    ecolog = {"ecolog_sim_squad_novice","ecolog_sim_squad_advanced","ecolog_sim_squad_veteran"},
    freedom = {"freedom_sim_squad_novice","freedom_sim_squad_advanced","freedom_sim_squad_veteran"},
    killer = {"merc_sim_squad_novice","merc_sim_squad_advanced","merc_sim_squad_veteran"},
    monolith = {"monolith_sim_squad_novice","monolith_sim_squad_advanced","monolith_sim_squad_veteran"},
    stalker = {"stalker_sim_squad_novice","stalker_sim_squad_advanced","stalker_sim_squad_veteran"},
    renegade = {"renegade_sim_squad_novice","renegade_sim_squad_advanced","renegade_sim_squad_veteran"},
    greh = {"greh_sim_squad_novice","greh_sim_squad_advanced","greh_sim_squad_veteran"},
    isg = {"isg_sim_squad_novice","isg_sim_squad_advanced","isg_sim_squad_veteran"},
}
--- Species -> single-species simulation squad section (species-pure for infest/conquest). See doc/library/xray/api/squad-factions.md.
SQUADS_BY_SPECIES = {
    bloodsucker = {"simulation_bloodsucker"}, boar = {"simulation_boar"}, burer = {"simulation_burer"}, cat = {"simulation_cat"},
    chimera = {"simulation_chimera"}, controller = {"simulation_controller"}, dog = {"simulation_dog"}, flesh = {"simulation_flesh"},
    fracture = {"simulation_fracture"}, gigant = {"simulation_gigant"}, karlik = {"simulation_karlik"}, lurker = {"simulation_lurker"},
    poltergeist = {"simulation_poltergeist"}, pseudodog = {"simulation_pseudodog"}, psy_dog = {"simulation_psy_dog"}, psysucker = {"simulation_psysucker"},
    rat = {"simulation_rat"}, snork = {"simulation_snork"}, tushkano = {"simulation_tushkano"}, zombie = {"simulation_zombie"},
}
-- Value-merge, not xtable.merge: a set-merge would store boolean `true` into respawn_params[key].squads and crash try_respawn.
local _SQUADS_BY_IDENTITY = xtable.clone(SQUADS_BY_FACTION)
for k, v in pairs(SQUADS_BY_SPECIES) do _SQUADS_BY_IDENTITY[k] = v end

-- Keep only squad sections the loaded system ini defines, returning a NEW survivor array or nil when none survive.
-- A missing section would reach create_squad -> alife_create nil -> CTD, so no respawn_params row may store one that is absent.
-- @cost O(#squads) | #squads luabind (section_exist each); inject-time only, arrays are <= 3
local function _filter_existing(squads)
    if type(squads) ~= "table" then return nil end
    local kept, count = {}, 0
    for i = 1, #squads do
        local sec = squads[i]
        if sec and ini_sys:section_exist(sec) then
            count = count + 1
            kept[count] = sec
        end
    end
    if count == 0 then return nil end
    return kept
end

--- Add a shared spawn entry to a smart's respawn_params (additive: originals keep spawning, no faction_controlled).
--- The faction filter stays in "spawn all" mode, so both LTX and injected entries fire.
--- @scope global - mutates server-entity fields directly; respawn evaluates in try_respawn (cse_alife_schedulable tick, runs offline)
--- @safety SAFE - pure Lua table writes on smart terrain object
--- @cost O(1) | 0 luabind (parse_condlist is pure Lua)
--- @src anomaly/smart_terrain.script(1665-1716)
--- @param smart se_smart_terrain Smart terrain to inject into
--- @param key string Unique respawn_params key (e.g. "ap_conquest")
--- @param identity string Stalker faction or mutant species (_SQUADS_BY_IDENTITY lookup)
--- @param spawn_num number|nil Max squads for this entry (default 1)
--- @return boolean True if applied
function set_shared_spawn(smart, key, identity, spawn_num)
    if not smart or not key then return false end
    local squads = _SQUADS_BY_IDENTITY[identity]
    if not squads then return false end
    squads = _filter_existing(squads)
    if not squads then return false end
    smart.respawn_params = smart.respawn_params or {}
    smart.already_spawned = smart.already_spawned or {}
    smart.respawn_point = true
    local condlist = xr_logic.parse_condlist(nil, nil, nil, tostring(spawn_num or 1))
    smart.respawn_params[key] = { num = condlist, squads = squads }
    smart.already_spawned[key] = smart.already_spawned[key] or { num = 0 }
    return true
end

--- Remove a shared spawn entry from a smart terrain.
--- @scope global - mutates server-entity respawn_params directly
--- @safety SAFE - pure Lua table writes on smart terrain object
--- @cost O(1) | 0 luabind
--- @param smart se_smart_terrain Smart terrain to revert
--- @param key string Respawn_params key to remove
--- @return boolean True if cleared
function clear_shared_spawn(smart, key)
    if not smart or not key then return false end
    if smart.respawn_params then
        smart.respawn_params[key] = nil
    end
    return true
end

--- Add a shared spawn entry for an EXPLICIT squad section (not an identity->pool lookup); additive, cleared with clear_shared_spawn.
--- For callers injecting a specific squad_descr section (e.g. a service filler squad) rather than a faction pool.
--- @scope global - mutates server-entity fields directly; respawn evaluates in try_respawn (offline)
--- @safety SAFE - pure Lua table writes on smart terrain object
--- @cost O(1) | 0 luabind (parse_condlist is pure Lua)
--- @src anomaly/smart_terrain.script(1665-1716)
--- @param smart se_smart_terrain Smart terrain to inject into
--- @param key string Unique respawn_params key (e.g. "ap_service")
--- @param section string A squad_descr section to spawn
--- @param spawn_num number|nil Max squads for this entry (default 1)
--- @return boolean True if applied
function set_shared_spawn_section(smart, key, section, spawn_num)
    if not smart or not key or not section then return false end
    if not ini_sys:section_exist(section) then return false end
    smart.respawn_params = smart.respawn_params or {}
    smart.already_spawned = smart.already_spawned or {}
    smart.respawn_point = true
    local condlist = xr_logic.parse_condlist(nil, nil, nil, tostring(spawn_num or 1))
    smart.respawn_params[key] = { num = condlist, squads = { section } }
    smart.already_spawned[key] = smart.already_spawned[key] or { num = 0 }
    return true
end

--- Add a faction-tagged spawn entry for EXPLICIT squad section(s) that passes the faction gate on an already-exclusive smart.
--- Passenger only: it reads smart.faction (never sets faction_controlled / smart.faction), which the controlling caller must have set.
--- @scope global - mutates server-entity respawn_params; try_respawn evaluates offline
--- @safety SAFE - pure Lua table writes on smart terrain object; no-op if smart has no owner faction
--- @cost O(1) | 0 luabind (parse_condlist is pure Lua)
--- @src anomaly/smart_terrain.script(1665-1672) faction gate: (faction_controlled==nil) or v.faction==self.faction
--- @param smart se_smart_terrain Smart terrain to inject into (must be under exclusive control)
--- @param key string Unique respawn_params key (e.g. "ap_service_trader")
--- @param section string|table A squad_descr section, or an ARRAY of sections (try_respawn picks uniformly per spawn)
--- @param spawn_num number|nil Max squads for this entry (default 1)
--- @return boolean True if applied
function set_exclusive_spawn_section(smart, key, section, spawn_num)
    if not smart or not key or not section then return false end
    local faction = smart.faction
    if not faction then return false end
    local squads = (type(section) == "table") and section or { section }
    if not squads[1] then return false end
    squads = _filter_existing(squads)
    if not squads then return false end
    smart.respawn_params = smart.respawn_params or {}
    smart.already_spawned = smart.already_spawned or {}
    smart.respawn_point = true
    local condlist = xr_logic.parse_condlist(nil, nil, nil, tostring(spawn_num or 1))
    smart.respawn_params[key] = { num = condlist, squads = squads, faction = faction }
    smart.already_spawned[key] = smart.already_spawned[key] or { num = 0 }
    return true
end

-- Shared writer for the exclusive (faction_controlled) form: sets the gate + owner faction and installs the entry.
local function _write_exclusive(smart, key, identity, squads, spawn_num)
    squads = _filter_existing(squads)
    if not squads then return false end
    smart.faction_controlled = key
    smart.faction = identity
    smart.respawn_params = smart.respawn_params or {}
    smart.already_spawned = smart.already_spawned or {}
    smart.respawn_point = true
    local condlist = xr_logic.parse_condlist(nil, nil, nil, tostring(spawn_num or 1))
    smart.respawn_params[key] = { num = condlist, squads = squads, faction = identity }
    smart.already_spawned[key] = smart.already_spawned[key] or { num = 0 }
    return true
end

--- Set exclusive spawn on a smart terrain: faction_controlled + one entry with .faction, suppressing the original LTX entries.
--- Monster factions need a periodic re-apply (check_smart_faction ignores monsters, smart_terrain.script:1209-1236).
--- @scope global - mutates server-entity fields directly; faction_controlled gate evaluates in try_respawn
--- @safety SAFE - pure Lua table writes on smart terrain object
--- @cost O(1) | 0 luabind (parse_condlist is pure Lua)
--- @src anomaly/smart_terrain.script(246-267,1209-1236,1665-1672)
--- @param smart se_smart_terrain Smart terrain to mutate
--- @param key string Unique respawn_params key (e.g. "ap_infest")
--- @param identity string Stalker faction or mutant species (_SQUADS_BY_IDENTITY lookup)
--- @param spawn_num number|nil Max squads for this entry (default 1)
--- @return boolean True if applied
function set_exclusive_spawn(smart, key, identity, spawn_num)
    if not smart or not key then return false end
    local squads = _SQUADS_BY_IDENTITY[identity]
    if not squads then return false end
    return _write_exclusive(smart, key, identity, squads, spawn_num)
end

-- Squad-tier ceiling per xlevel danger tier, cumulative: a map fields every faction tier up to its danger, over the {novice, advanced, veteran} pool.
local _TIER_CEILING = { [0] = 1, [1] = 2, [2] = 2, [3] = 3, [4] = 3, [5] = 3 }

--- Faction squad pool capped by the smart's level danger tier, cumulative: rookie maps yield novice only, mid maps north the full pool.
--- The array a caller feeds to set_exclusive_spawn_section; unknown levels read as xlevel.DANGER_TIER_DEFAULT.
--- @safety SAFE - nil-guarded; nil for unknown factions
--- @cost O(1) | 2-4 luabind (xlevel.get_level_id + sim:level_name on a cold tier cache)
--- @src anomaly/smart_terrain.script(1716-1720) uniform pick from the squads array
--- @param smart se_smart_terrain Smart terrain (tier scope)
--- @param faction string Stalker community (SQUADS_BY_FACTION lookup)
--- @return table|nil Array of squad sections, nil for an unknown faction
function get_tiered_faction_squads(smart, faction)
    if not smart then return nil end
    local pool = SQUADS_BY_FACTION[faction]
    if not pool then return nil end
    local tier = xlevel.get_danger_tier(xlevel.get_level_id(smart)) or xlevel.DANGER_TIER_DEFAULT
    local ceiling = _TIER_CEILING[tier] or #pool
    if ceiling >= #pool then return pool end
    local squads = {}
    for i = 1, ceiling do squads[i] = pool[i] end
    return squads
end

--- Exclusive faction spawn with the squad tiers capped by the level's danger tier (get_tiered_faction_squads over _write_exclusive).
--- Faction identities only; species pools are single-section, so use set_exclusive_spawn for those.
--- @scope global - mutates server-entity fields directly; faction_controlled gate evaluates in try_respawn
--- @safety SAFE - pure Lua table writes on smart terrain object; tier lookup nil-guarded
--- @cost O(1) | 2-4 luabind (xlevel.get_level_id + sim:level_name) + parse_condlist pure Lua
--- @src anomaly/smart_terrain.script(1665-1672,1716-1720) gate + uniform pick from the squads array
--- @param smart se_smart_terrain Smart terrain to mutate
--- @param key string Unique respawn_params key (e.g. "ap_conquest")
--- @param faction string Stalker community (SQUADS_BY_FACTION lookup)
--- @param spawn_num number|nil Max squads for this entry (default 1)
--- @return boolean True if applied
function set_exclusive_spawn_tiered(smart, key, faction, spawn_num)
    if not smart or not key then return false end
    local squads = get_tiered_faction_squads(smart, faction)
    if not squads then return false end
    return _write_exclusive(smart, key, faction, squads, spawn_num)
end

--- Clear exclusive spawn from a smart terrain, restoring original LTX spawning on the next try_respawn.
--- Clears faction_controlled, reverts faction to default, and removes the exclusive entry.
--- @scope global - mutates server-entity fields directly
--- @safety SAFE - pure Lua table writes on smart terrain object
--- @cost O(1) | 0 luabind
--- @src anomaly/smart_terrain.script(246-267,1665-1672)
--- @param smart se_smart_terrain Smart terrain to revert
--- @param key string Respawn_params key to remove
--- @return boolean True if cleared
function clear_exclusive_spawn(smart, key)
    if not smart or not key then return false end
    smart.faction_controlled = nil
    smart.faction = smart.default_faction
    if smart.respawn_params then
        smart.respawn_params[key] = nil
    end
    return true
end

--- Reset all smart terrain spawn counters to zero (already_spawned[k].num and last_respawn_update) on every respawn-capable smart.
--- @scope global - iterates SIMBOARD.smarts and mutates server-entity fields
--- @safety SAFE - pure Lua field writes on smart terrain objects, nil-guarded
--- @cost O(n) smarts * O(k) spawn sections | 0 luabind (SIMBOARD.smarts holds direct refs to server entities; field writes via pairs are pure Lua)
--- @src anomaly/smart_terrain.script(251,886,1625), anomaly/sim_board.script(302)
--- @return number Count of smarts reset
function reset_spawns()
    if not SIMBOARD or not SIMBOARD.smarts then return 0 end

    local count = 0
    for _, data in pairs(SIMBOARD.smarts) do
        local smart = data.smrt
        if not smart then goto continue end
        if not smart.already_spawned then goto continue end
        for _, entry in pairs(smart.already_spawned) do
            entry.num = 0
        end
        smart.last_respawn_update = nil
        count = count + 1
        ::continue::
    end

    return count
end

--- Reset population and re-seed the world from the simulation preset: reset counters, clear start_position_filled, call fill_start_position.
--- @scope global - mutates SIMBOARD and triggers fill_start_position
--- @safety SAFE - delegates to engine's fill_start_position (runs on every new game start)
--- @cost O(n) smarts reset + fill_start_position | 0 luabind for reset_spawns; fill_start_position is engine spawn injection (heavy per smart)
--- @src anomaly/se_actor.script(14), anomaly/sim_board.script(284)
--- @return boolean True if reset_population ran
function reset_population()
    if not SIMBOARD then return false end
    reset_spawns()
    SIMBOARD.start_position_filled = false
    SIMBOARD:fill_start_position()
    return true
end

