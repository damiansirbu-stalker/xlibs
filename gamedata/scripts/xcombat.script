--- xcombat: combat AI primitives - weapons, NPC control, geometry, targeting, cover, squad spread, fire-gate wrappers

local math_sqrt, math_cos, math_sin, math_abs = math.sqrt, math.cos, math.sin, math.abs
local math_acos, math_deg, math_huge = math.acos, math.deg, math.huge
local time_global, tostring, tonumber = time_global, tostring, tonumber
local type, rawget, assert, pairs = type, rawget, assert, pairs
local level_object_by_id = level.object_by_id
local vector, level, GetEvent = vector, level, GetEvent
local move, state_mgr, state_mgr_direction = move, state_mgr, state_mgr_direction
local db, alife_object, ini_sys, IsWeapon, xmath = db, alife_object, ini_sys, IsWeapon, xmath

xcombat = xcombat or {}

local INVALID_LVID = 4294967295
xcombat.INVALID_LVID = INVALID_LVID

-- Combat-state options: the three orthogonal knobs set_combat resolves into one engine state.
xcombat.FIRE,  xcombat.SNIPE,  xcombat.READY, xcombat.STOW = "FIRE", "SNIPE", "READY", "STOW"
xcombat.STAND, xcombat.CROUCH = "STAND", "CROUCH"
xcombat.STILL, xcombat.WALK,   xcombat.RUN  = "STILL", "WALK", "RUN"

-- Weapon classification

-- The w_sniper palette classifier a consumer's doctrine weapon palette keys on.
xcombat.SNIPER_KINDS = {
    w_sniper = true,
}

xcombat.WEAPON_RANGES = {
    w_melee     = { min = 0,  max = 2   },
    w_pistol    = { min = 2,  max = 20  },
    w_shotgun   = { min = 2,  max = 15  },
    w_smg       = { min = 2,  max = 30  },
    w_rifle     = { min = 3,  max = 80  },
    w_sniper    = { min = 10, max = 150 },
    w_explosive = { min = 10, max = 100 },
}

-- Weapon kinds an NPC can hold and fight with; w_explosive is excluded so a mid-throw NPC classifies by its slotted firearm.
local HELD_WEAPON_KINDS = {
    w_pistol = true, w_shotgun = true, w_smg = true, w_rifle = true, w_sniper = true, w_melee = true,
}

local WEAPON_TTL_MS = 2000

-- Sweep expired entries on an interval so an id-keyed TTL cache never grows unbounded (stalker-code.md hot path rule 5).
local CACHE_SWEEP_INTERVAL_MS = 60000
local _next_sweep = setmetatable({}, { __mode = "k" })
local _sweep_keys = {}

--- Delete every expired entry from an id-keyed TTL cache, at most once a minute.
--- Keys are collected first and deleted in a second pass; _sweep_keys is reused (zero allocation) and _next_sweep is weak-keyed.
--- @safety SAFE - pure Lua table work
--- @cost O(1) between sweeps, O(n) entries on one | 0 luabind
--- @param cache table id-keyed cache of { expires = <ms> }
--- @param tg number time_global() in ms
local function _clear_expired(cache, tg)
    if tg < (_next_sweep[cache] or 0) then return end
    _next_sweep[cache] = tg + CACHE_SWEEP_INTERVAL_MS
    local found = 0
    for key, entry in pairs(cache) do
        if tg >= entry.expires then
            found = found + 1
            _sweep_keys[found] = key
        end
    end
    for i = 1, found do
        cache[_sweep_keys[i]] = nil
        _sweep_keys[i] = nil
    end
end
local _weapon_kind_cache = {}

--- Kind string for the weapon an NPC is fighting with (w_rifle / w_pistol / ...), TTL-cached 2s per id so it holds stable through transitions.
--- Reads the active item's kind, accepting only held-and-fightable kinds; falls back to the slot-priority scan (rifle, pistol, knife).
--- @safety SAFE - nil-guarded section reads, returns nil when no weapon resolves
--- @cost O(1) | 0 luabind cached; on miss 1 luabind active_item + r_string_ex, else the slot-scan getters + r_string_ex
--- @src anomaly/configs/items/weapons/w_*.ltx (kind field), xray/script_ini_file.cpp, xray/script_game_object.cpp (active_item)
--- @param npc game_object
--- @return string|nil weapon kind, or nil when unarmed/unresolved
function xcombat.get_weapon_kind(npc)
    local id = npc:id()
    local tg = time_global()
    local entry = _weapon_kind_cache[id]
    if entry and tg < entry.expires then return entry.kind end
    local kind = nil
    local active = npc:active_item()
    if active then
        local k = ini_sys:r_string_ex(active:section(), "kind")
        if k and HELD_WEAPON_KINDS[k] then kind = k end
    end
    if not kind then
        local wpn = xinventory.get_equipped_rifle(npc)
                 or xinventory.get_equipped_pistol(npc)
                 or xinventory.get_equipped_knife(npc)
        if wpn then
            local section = wpn:section()
            if section then kind = ini_sys:r_string_ex(section, "kind") end
        end
    end
    _clear_expired(_weapon_kind_cache, tg)
    _weapon_kind_cache[id] = { kind = kind, expires = tg + WEAPON_TTL_MS }
    return kind
end

--- Engagement range band { min, max } in metres for a weapon kind. Unknown kinds fall back to the rifle band so any armed NPC has a usable range.
--- @safety SAFE - pure table lookup
--- @cost O(1) | 0 luabind
--- @param kind string weapon kind
--- @return table { min = number, max = number }
function xcombat.get_weapon_range(kind)
    return xcombat.WEAPON_RANGES[kind] or xcombat.WEAPON_RANGES.w_rifle
end

--- The range band a distance falls in against a weapon kind: "too_close" (under the minimum), "in" (effective), "out" (past the maximum).
--- The one range primitive; band compares read it instead of raw min/max compares.
--- @safety SAFE - unknown kinds read the rifle band via get_weapon_range
--- @cost O(1) | 0 luabind (table lookup + two compares)
--- @param dist number metres to the target
--- @param kind string weapon kind
--- @return string "too_close" | "in" | "out"
function xcombat.get_range_band(dist, kind)
    local band = xcombat.get_weapon_range(kind)
    if dist < band.min then return "too_close" end
    if dist <= band.max then return "in" end
    return "out"
end

-- Engine fire-queue bands per weapon kind, static by design (anomaly/m_stalker.ltx:826-909; kind mapping stalker_combat_action_base.cpp:94-220).
xcombat.FIRE_QUEUE = {
    w_pistol  = { far = { 1, 2, 500, 750 },   medium = { 1, 4, 400, 500 },   close = { 1, 8, 350, 400 } },
    w_shotgun = { far = { 1, 1, 1000, 2000 }, medium = { 1, 4, 600, 750 },   close = { 1, 6, 600, 750 } },
    w_sniper  = { far = { 1, 1, 2000, 3000 }, medium = { 1, 1, 1500, 2000 }, close = { 1, 1, 1000, 1100 } },
    w_rifle   = { far = { 1, 3, 400, 800 },   medium = { 1, 6, 350, 600 },   close = { 2, 9, 250, 500 } },
    w_smg     = { far = { 1, 6, 300, 600 },   medium = { 2, 12, 300, 500 },  close = { 2, 15, 200, 400 } },
}

--- Fire-queue band bounds for a weapon kind: burst size and inter-burst interval, the envelope the engine planner itself fires with at that range.
--- Unknown kinds fall back to the rifle bands, an unknown band to medium, so every armed NPC gets usable bounds.
--- @safety SAFE - pure table lookup
--- @cost O(1) | 0 luabind
--- @src anomaly/configs/creatures/m_stalker.ltx:826-909 [fire_queue_params]
--- @param kind string weapon kind (get_weapon_kind)
--- @param band string "far" | "medium" | "close"
--- @return number, number, number, number min_size, max_size, min_interval_ms, max_interval_ms
function xcombat.get_fire_queue(kind, band)
    local bands = xcombat.FIRE_QUEUE[kind] or xcombat.FIRE_QUEUE.w_rifle
    local bounds = bands[band] or bands.medium
    return bounds[1], bounds[2], bounds[3], bounds[4]
end

-- Enemy memory: the engine's per-enemy perception reads (see / memory_time / memory_position), read instead of re-derived.

--- True when the NPC sees the object RIGHT NOW - the engine's accumulated visible_now state, the test vanilla kill_enemy fires on.
--- A visual-memory read, not a fresh raycast; for sighting staleness use get_unseen_ms, for cover bookkeeping use get_cover_state.
--- @safety SAFE - nil-guarded and dead-SUBJECT guarded (a dead npc makes the SAFE_WRAPped bind log "cannot check visibility of dead object!")
--- @cost O(1) | 1 luabind (CheckObjectVisibility - visual memory read)
--- @src xray/script_game_object_script2.cpp:138 (see = CheckObjectVisibility, SAFE_WRAP)
--- @param npc game_object the perceiving NPC
--- @param obj game_object the object under test
--- @return boolean true when visible now
function xcombat.can_see(npc, obj)
    if not (npc and obj) then return false end
    if not npc:alive() then return false end
    return npc:see(obj)
end

--- True when npc is within radius metres of obj AND currently sees it; the squared-distance test bails before the visibility read.
--- Range-limits :see for close-range checks where a full-vision hit across the level is wrong; occlusion and facing come from :see.
--- @safety SAFE - nil-guarded; distance and :see are both engine-SAFE_WRAPped
--- @cost O(1) | 2 position + 1 distance_to_sqr on the far bail; + 1 see (visual-memory read) when in range
--- @src xray/script_game_object_script2.cpp:138 (see = CheckObjectVisibility, SAFE_WRAP)
--- @param npc game_object the perceiving NPC
--- @param obj game_object the object under test
--- @param radius number range in metres
--- @return boolean true when within range and visible now
function xcombat.can_see_within(npc, obj, radius)
    if not (npc and obj) then return false end
    if npc:position():distance_to_sqr(obj:position()) >= radius * radius then return false end
    return xcombat.can_see(npc, obj)
end

--- Milliseconds since the NPC last perceived the enemy by ANY sense (sight, sound, or hit) - the disengagement read vanilla uses.
--- A negative result (only possible across a load) reads as fresh.
--- @safety SAFE - npc is a stalker/monster at every combat call site; enemy is a remembered object
--- @cost O(1) | 1 luabind (memory list lookup, no raycast)
--- @src xray/memory_manager.cpp:255-274 (memory_time aggregation), anomaly/xr_combat_ignore.script:111 (the vanilla disengagement read)
--- @param npc game_object the perceiving NPC
--- @param enemy game_object the remembered enemy
--- @param tg number time_global() snapshot
--- @return number ms since last perception
function xcombat.get_unseen_ms(npc, enemy, tg)
    return tg - npc:memory_time(enemy)
end

--- Resolve a remembered enemy id to its live game_object - the maneuver target-commitment read.
--- nil when the id is gone, offline, or dead, so the caller ends the maneuver instead of aiming at a corpse.
--- @safety SAFE - nil id / offline / dead all return nil
--- @cost O(1) | 1-2 luabind trivial (object_by_id, alive)
--- @param id number|nil enemy id
--- @return game_object|nil live enemy, or nil
function xcombat.resolve_enemy(id)
    if not id then return nil end
    local obj = level_object_by_id(id)
    if obj and obj:alive() then return obj end
    return nil
end

--- The engine's selected enemy for this combatant, or nil - the alive-guarded best_enemy read.
--- The raw bind reaches into the memory manager of a possibly-dead object, so the guard bails first.
--- @safety SAFE - nil- and dead-guarded (the can_see dead-subject precedent)
--- @cost O(1) | 2 luabind trivial (alive + best_enemy)
--- @src xray/script_game_object_script2.cpp:206 (bind), script_game_object2.cpp:200-209 (GetBestEnemy - no alive guard of its own)
--- @param npc game_object stalker
--- @return game_object|nil the selected enemy, nil when none or the npc is dead or nil
function xcombat.get_best_enemy(npc)
    if not (npc and npc:alive()) then return nil end
    return npc:best_enemy()
end

--- Position to track the enemy for movement: the live position when currently seen, else the last-known position from memory.
--- Pursuing the last-known spot lets a chase end where the enemy was lost instead of trailing the live, fleeing target.
--- @safety SAFE - enemy is a remembered object (guaranteed when it is the NPC's best_enemy)
--- @cost O(1) | 1 luabind
--- @src xray/memory_manager.cpp:279 (memory_position), rx_combat.script:230,298 (the live-on-see precedent)
--- @param npc game_object the perceiving NPC
--- @param enemy game_object the remembered enemy
--- @param sees boolean whether the NPC currently sees the enemy (slot.sees)
--- @return vector position to treat as the enemy for movement resolution
function xcombat.get_track_pos(npc, enemy, sees)
    if sees then return enemy:position() end
    return npc:memory_position(enemy)
end

-- make_enemy_visible probe result, cached on first disclose (nil = not probed yet)
local _has_make_visible = nil

--- Disclose an enemy to an NPC: inject it into memory and register the NPC in combat, relation-clean (no goodwill or community write).
--- On exes with the make_enemy_visible bind the enemy is also squad-shared; a reliable victim-turn still needs set_hit_redirect.
--- @safety SAFE - nil-guarded npc/enemy; the combat registration routes through the alive-guarded register_in_combat wrapper
--- @cost O(1) | 3-4 luabind (enable_memory_object visual-memory inject; make_enemy_visible add_visible_object; alive + register_in_combat via agent_manager)
--- @src xray/script_game_object3.cpp:65 (enable_memory_object), xray/script_game_object_inventory_owner.cpp:1945 (register_in_combat)
--- @src xray/enemy_manager.cpp:69 (is_relation_enemy gate), xray/ai/stalker/ai_stalker_misc.cpp (CAI_Stalker::tfGetRelationType)
--- @src xray/memory_manager.cpp make_object_visible_somewhen (the seen-class promotion; engine-internal precedent agent_enemy_manager.cpp)
--- @param npc game_object stalker to alert
--- @param enemy game_object hostile object to disclose
--- @param opts table|nil { memory_only = true } skips the seen-class promotion (pre-bind behavior)
--- @return boolean true when applied
function xcombat.show_enemy(npc, enemy, opts)
    if not npc or not enemy then return false end
    npc:enable_memory_object(enemy, true)
    if _has_make_visible == nil then _has_make_visible = type(npc.make_enemy_visible) == "function" end
    if _has_make_visible and not (opts and opts.memory_only) then npc:make_enemy_visible(enemy) end
    xcombat.register_in_combat(npc)
    return true
end

-- Danger types that mean "a shooter is engaging me"; built lazily (danger_object is absent at file body in the validator stub).
local _under_fire_types = nil

--- True when the NPC's own danger memory says enemy shot at it within the last window_ms - no callback, no state, any shooter.
--- A landed hit the NPC did not perceive as danger is NOT covered; pair with the consumer's own hit stamp for that.
--- @safety SAFE - nil-guarded; false when no danger, a stale one, or a different source
--- @cost O(1) | 2-5 luabind trivial (best_danger, type, time, dependent_object/object, id - field reads)
--- @src xray/memory_space_script.cpp:130-147 (danger type enum), anomaly/xr_danger.script:59-70 (source = dependent_object else object)
--- @param npc game_object the NPC under consideration
--- @param enemy game_object the suspected shooter
--- @param tg number time_global() snapshot
--- @param window_ms number freshness window in ms
--- @return boolean true when the enemy shot at the NPC within the window
function xcombat.is_under_fire(npc, enemy, tg, window_ms)
    if not (npc and enemy) then return false end
    if not _under_fire_types then
        _under_fire_types = {
            [danger_object.attacked]        = true,
            [danger_object.bullet_ricochet] = true,
            [danger_object.attack_sound]    = true,
        }
    end
    local danger = npc:best_danger()
    if not danger or not _under_fire_types[danger:type()] then return false end
    if (tg - danger:time()) > window_ms then return false end
    local source = danger:dependent_object() or danger:object()
    return source ~= nil and source:id() == enemy:id()
end

-- GOAP takeover: the planner block list and the squad combat-mask lifecycle the blocked CStalkerCombatPlanner no longer performs.

-- The blocked-planner id list, resolved at call time so the library never auto-loads the GOAP id modules at load.
local _blocked_planners = nil

-- Append one id, only when it resolves to a number; a removed or renumbered scheme is skipped rather than faulting the install.
local function _add_planner_id(list, id)
    if type(id) == "number" then list[#list + 1] = id end
end

-- An action id off a scheme module, or nil when that scheme is not installed (auto-load returns nil for a missing .script).
local function _get_scheme_id(module_ref, field)
    if not module_ref then return nil end
    return module_ref[field]
end

--- GOAP action ids the takeover precondition-blocks while a transaction is open (built once, cached).
--- An action NOT listed satisfies the brain's goal directly and bypasses the takeover, so the list is enumerated, never sampled.
--- @safety SAFE - every entry is type-checked; a scheme absent from the install is skipped
--- @cost O(1) | 0 luabind (module field reads, cached after first build)
--- @src anomaly/xr_actions_id.script (the id arithmetic), anomaly/modules.script:17-34 (what is loaded)
--- @src anomaly/xr_combat.script:87-100 (the three combat schemes taking the TOP-LEVEL manager)
--- @src anomaly/state_mgr.script:552-559 (state_mgr+1), anomaly/xr_smartcover.script:210 (+2 = combat)
--- @src xray/stalker_combat_planner.cpp:182,193-194 (the mask bookkeeping the block removes)
--- @return table array of GOAP action ids
function xcombat.get_blocked_planners()
    if _blocked_planners then return _blocked_planners end
    local list = {}
    _add_planner_id(list, stalker_ids.action_combat_planner)
    _add_planner_id(list, stalker_ids.action_danger_planner)
    _add_planner_id(list, xr_actions_id.alife)
    _add_planner_id(list, _get_scheme_id(xr_danger, "actid"))
    _add_planner_id(list, xr_actions_id.state_mgr + 1)
    _add_planner_id(list, xr_actions_id.state_mgr + 2)
    for i = 0, 3 do _add_planner_id(list, xr_actions_id.combat_monolith_base + i) end
    for i = 0, 1 do _add_planner_id(list, xr_actions_id.combat_zombied_base + i) end
    for i = 0, 1 do _add_planner_id(list, xr_actions_id.combat_camper_base + i) end
    _add_planner_id(list, _get_scheme_id(axr_fight_from_cover, "actid"))
    _add_planner_id(list, xr_actions_id.smartcover_action + 2)
    _add_planner_id(list, _get_scheme_id(xrs_facer, "actid_facer"))
    _add_planner_id(list, _get_scheme_id(xrs_facer, "actid_steal_up_facer"))
    _add_planner_id(list, _get_scheme_id(xrs_kill_wounded, "actid"))
    _add_planner_id(list, _get_scheme_id(rx_ff, "actid"))
    _blocked_planners = list
    return _blocked_planners
end

--- Set the NPC's squad combat-mask bit - join the squad memory-sharing group.
--- Called because the blocked CStalkerCombatPlanner::initialize no longer runs; idempotent (the engine ORs the bit), alive-gated.
--- @safety SAFE - nil/alive-guarded; register_in_combat is SAFE_WRAPped and a no-op on a non-stalker
--- @cost O(1) | 1 luabind medium (register_in_combat: agent_manager().member() mask OR)
--- @src xray/script_game_object_script2.cpp:381 (binding), xray/stalker_combat_planner.cpp:182 (the removed call)
--- @param npc game_object stalker
function xcombat.register_in_combat(npc)
    if not npc or not npc:alive() then return end
    npc:register_in_combat()
end

--- Clear the NPC's squad combat-mask bit - leave the squad memory-sharing group.
--- Alive-gated: finalize also fires on death, where the bound call faults on the stale object (the engine smart_cast guards type, not liveness).
--- @safety SAFE - nil/alive-guarded (skips the dead-object fault the engine smart_cast does not catch)
--- @cost O(1) | 1 luabind medium (unregister_in_combat: agent_manager().member() mask clear)
--- @src xray/script_game_object_script2.cpp:382 (binding), xray/stalker_combat_planner.cpp:193-194 (the removed call)
--- @param npc game_object stalker
function xcombat.unregister_in_combat(npc)
    if not npc or not npc:alive() then return end
    npc:unregister_in_combat()
end

-- GOAP takeover graft: xcombat owns the mechanism, the consumer owns policy via spec { gate, on_begin }; the graft is permanent for the NPC's life.

-- Shared evaluator+action GOAP id; 188200 collided with an external companion surge-shelter scheme, 188347 verified unused and RESERVED.
local TAKEOVER_ID = 188347

--- The grafted action's GOAP id, exported so a consumer can declare it in vanilla's state_mgr.combat_action_ids.
--- Read-only by convention; writing it does not move the graft, which reads the local.
--- @src anomaly/state_mgr.script:10-18 (the table and vanilla's own note on who belongs in it)
xcombat.TAKEOVER_ID = TAKEOVER_ID

local _takeover_spec = nil
local _takeover_installed = {}
-- npc id -> set of blocked ids already preconditioned on this NPC's manager; makes the seize-time top-up idempotent (duplicate add_condition throws).
local _takeover_blocked = {}

-- The gate evaluator: true exactly while the consumer's gate is raised for this NPC; polled every plan solve, so it is a flag read.
class "xcombat_takeover_evaluator" (property_evaluator)
function xcombat_takeover_evaluator:__init(name) super(nil, name) end
function xcombat_takeover_evaluator:evaluate()
    return _takeover_spec ~= nil and _takeover_spec.gate(self.object) == true
end

-- The grafted action: initialize issues the maneuver via spec.on_begin, execute does nothing (the engine carries it), finalize leaves the group.
class "xcombat_takeover_action" (action_base)
function xcombat_takeover_action:__init(name) super(nil, name) end
function xcombat_takeover_action:initialize()
    action_base.initialize(self)
    local npc = self.object
    npc:clear_animations()
    npc:set_desired_position()
    npc:set_desired_direction()
    npc:set_path_type(game_object.level_path)
    npc:set_mental_state(anim.danger)
    xcombat.register_in_combat(npc)
    if _takeover_spec and _takeover_spec.on_begin then _takeover_spec.on_begin(npc) end
end
function xcombat_takeover_action:execute()
    action_base.execute(self)
end
function xcombat_takeover_action:finalize()
    action_base.finalize(self)
    local npc = self.object
    xcombat.unregister_in_combat(npc)
    if _takeover_spec and _takeover_spec.on_release then _takeover_spec.on_release(npc) end
end

--- Graft the takeover onto a stalker: add the gate evaluator + action and precondition-block the vanilla combat chain on the gate.
--- Idempotent per NPC and SINGLE-CONSUMER: a second differing spec asserts instead of silently replacing the first for every NPC.
--- @safety SAFE for the single consumer - nil/manager guarded, false without a manager; ASSERTS on a second differing spec
--- @cost O(b) blocked planners | add_evaluator + add_action + b*(action lookup + add_precondition), one-time at install
--- @src anomaly/xr_actions_id.script, anomaly/xr_evaluators_id.script:17 (sidor_wounded_base); xray/stalker_planner.cpp:68-69,128,149-163 (goal chain)
--- @param npc game_object stalker
--- @param spec table { gate = fn(npc) -> boolean, on_begin = fn(npc) on control granted, on_release = fn(npc)|nil on control taken away }
--- @return boolean true when grafted or already grafted, false when the NPC has no action manager
function xcombat.register_takeover(npc, spec)
    if not npc or not spec then return false end
    assert(_takeover_spec == nil or _takeover_spec == spec,
        "xcombat.register_takeover: a second differing takeover spec - the takeover is single-consumer")
    local id = npc:id()
    if _takeover_installed[id] then return true end
    local manager = npc:motivation_action_manager()
    if not manager then return false end
    _takeover_spec = spec
    _takeover_installed[id] = true

    manager:add_evaluator(TAKEOVER_ID, xcombat_takeover_evaluator("eva_xcombat_takeover"))

    local action = xcombat_takeover_action("act_xcombat_takeover")
    action:add_precondition(world_property(stalker_ids.property_alive, true))
    action:add_precondition(world_property(xr_evaluators_id.sidor_wounded_base, false))
    action:add_precondition(world_property(TAKEOVER_ID, true))
    action:add_effect(world_property(TAKEOVER_ID, false))
    manager:add_action(TAKEOVER_ID, action)

    _takeover_blocked[id] = {}
    xcombat.apply_takeover_block(npc)
    return true
end

--- Apply the TAKEOVER_ID==false precondition to every blocked-list action on this NPC's manager that has not received it yet.
--- Run once at graft time and re-run by the consumer at each seize, so a scheme whose action bound after the graft is blocked in time.
--- @safety SAFE - nil/ungrafted/manager guarded; every id type-checked by get_blocked_planners
--- @cost O(b) blocked ids | one manager:action lookup per id still missing (ids already blocked cost a table read)
--- @src anomaly/xr_logic.script:279-295 (the once-per-NPC bind guard and the late-registration hole)
--- @src xray/condition_state_inline.h:44-53 (duplicate condition THROW - why the set gates the add)
--- @param npc game_object stalker previously passed to register_takeover
function xcombat.apply_takeover_block(npc)
    if not npc then return end
    local done = _takeover_blocked[npc:id()]
    if not done then return end
    local manager = npc:motivation_action_manager()
    if not manager then return end
    local blocked = xcombat.get_blocked_planners()
    for i = 1, #blocked do
        local aid = blocked[i]
        local act = not done[aid] and manager:action(aid) or nil
        if act then
            act:add_precondition(world_property(TAKEOVER_ID, false))
            done[aid] = true
        end
    end
end

--- True while the grafted takeover action is the manager's CURRENT top-level action - the boolean form of get_operator == "takeover".
--- Consumers pair it with an open gate to detect a denylist escape (an unblocked action holding the slot under an open maneuver).
--- @safety SAFE - nil-guarded manager + initialized check, false when unreadable
--- @cost O(1) | 3 luabind trivial (motivation_action_manager, initialized, current_action_id)
--- @param npc game_object stalker
--- @return boolean true when the takeover action is current
function xcombat.is_takeover_current(npc)
    if not npc then return false end
    local mgr = npc:motivation_action_manager()
    if not (mgr and mgr:initialized()) then return false end
    return mgr:current_action_id() == TAKEOVER_ID
end

--- Drop the install-tracking for an NPC so a respawned id re-grafts; call on net_destroy.
--- The graft cannot be unwired from a live manager; a respawn builds a fresh one, so clearing the guard lets the next install re-graft.
--- @safety SAFE - nil guarded
--- @cost O(1) | 1 luabind trivial (id) + table clear
--- @param npc game_object
function xcombat.release_takeover(npc)
    if not npc then return end
    local id = npc:id()
    _takeover_installed[id] = nil
    _takeover_blocked[id] = nil
end

--- Id-keyed sibling of release_takeover for callers holding no game_object (server-side unregister).
--- Calling this from the unregister handler keeps a recycled id from silently skipping its next re-graft.
--- @safety SAFE - nil guarded
--- @cost O(1) | 0 luabind (table clear)
--- @param id number NPC id
function xcombat.release_takeover_id(id)
    if not id then return end
    _takeover_installed[id] = nil
    _takeover_blocked[id] = nil
end

--- The combat planner's stored cover bookkeeping for a stalker: (in_cover, looked_out, position_held).
--- These are the engine's BELIEFS, not geometry, and under a planner block they can only decay - read them BEFORE a seize, not during one.
--- @safety SAFE - nil-guarded end to end; nil (not false) when there is no planner to ask, so "not in cover" and "unknowable" stay distinct
--- @cost O(1) | 7 luabind trivial (manager, initialized, action, cast_planner, 3 stored property reads)
--- @src xray/action_planner_script.cpp:26-63 (cast_planner + the read-only storage bind), xray/property_storage_script.cpp:22 (property)
--- @src xray/stalker_combat_planner.cpp:369 (set), :57-63 (cleared on cover change), :253-262 (storage-backed evaluator set), :344 (kill_enemy needs in_cover)
--- @src xray/ai/stalker/ai_stalker_script.cpp:43 (stalker_ids.property_in_cover)
--- @param npc game_object stalker
--- @return boolean|nil in_cover, boolean|nil looked_out, boolean|nil position_held (all nil when unreadable)
function xcombat.get_cover_state(npc)
    if not npc then return nil end
    local mgr = npc:motivation_action_manager()
    if not (mgr and mgr:initialized()) then return nil end
    local planner = cast_planner(mgr:action(stalker_ids.action_combat_planner))
    if not planner then return nil end
    local storage = planner.storage
    return storage:property(stalker_ids.property_in_cover), storage:property(stalker_ids.property_looked_out), storage:property(stalker_ids.property_position_holded)
end

--- The sight manager's CURRENT sight target and mode - the pair the state machinery's direction evaluator gates fire on for a look_object order.
--- During a zero-shot hold this is the field that shows whether the ordered look_object was ever accepted.
--- @safety SAFE - nil-guarded npc and params
--- @cost O(1) | 2-3 luabind trivial (sight_params + field reads)
--- @src xray/script_game_object_script3.cpp:443 (sight_params bind), anomaly/state_mgr_direction.script (the identity+mode fire gate)
--- @param npc game_object stalker
--- @return number|nil id of the current sight object (nil = current sight is not an object)
--- @return number|nil m_sight_type enum value (nil when npc/params absent)
function xcombat.get_sight_target(npc)
    if not npc then return nil, nil end
    local params = npc:sight_params()
    if not params then return nil, nil end
    local obj = params.m_object
    return obj and obj:id() or nil, params.m_sight_type
end

-- The engine combat operators worth naming; resolved once at call time (stalker_ids absent at file body).
local _operators = nil

-- Register the +1/+2/+3 sub-action labels for one numeric action id, skipping any id already mapped.
local function _set_variants(ops, name, aid)
    if type(aid) ~= "number" then return end
    for i = 1, 3 do
        if ops[aid + i] == nil then ops[aid + i] = name .. "+" .. i end
    end
end

--- Short name of the engine combat operator the NPC's brain is running now (combat / danger / alife / any xr_actions_id name) - who drives.
--- A still unknown id shows as its number, an absent or uninitialized manager as "-".
--- @safety SAFE - nil-guarded manager + initialized() check, never constructs
--- @cost O(1) | 3 luabind trivial (motivation_action_manager, initialized, current_action_id - field reads)
--- @src xray/script_game_object_script2.cpp (motivation_action_manager), anomaly/xr_actions_id.script
--- @param npc game_object stalker
--- @return string operator label ("combat"/"danger"/"alife"/scheme action name/id/"-")
function xcombat.get_operator(npc)
    if not _operators then
        _operators = {
            [stalker_ids.action_combat_planner] = "combat",
            [stalker_ids.action_danger_planner] = "danger",
            [stalker_ids.action_alife_planner]  = "alife",
        }
        for name, aid in pairs(xr_actions_id) do
            if type(aid) == "number" and _operators[aid] == nil then _operators[aid] = name end
        end
        for name, aid in pairs(xr_actions_id) do
            _set_variants(_operators, name, aid)
        end
        if xr_danger.actid and _operators[xr_danger.actid] == nil then _operators[xr_danger.actid] = "danger_s" end
        _operators[TAKEOVER_ID] = "takeover"
    end
    local mgr = npc:motivation_action_manager()
    if not (mgr and mgr:initialized()) then return "-" end
    local cur = mgr:current_action_id()
    if not cur then return "-" end
    return _operators[cur] or tostring(cur)
end

--- Body facing as a unit direction vector - the heading/aim read.
--- Wraps npc:direction() so a consumer takes facing through xcombat instead of the raw engine field; get_facing_offset composes on it.
--- @safety SAFE - nil npc returns a zero vector
--- @cost O(1) | 1 luabind trivial (direction: field read)
--- @src xray/script_game_object_script2.cpp:98 (direction)
--- @param npc game_object
--- @return vector unit facing direction
function xcombat.get_facing(npc)
    if not npc then return vector() end
    return npc:direction()
end

--- Degrees the NPC's body facing is off the straight line to target_pos (0 = dead on, 180 = opposite).
--- A combat NPC normally faces near its enemy, so a large offset is the body pointed away (the weird-aim cue).
--- @safety SAFE - returns 0 when the target sits on the NPC (degenerate direction)
--- @cost O(1) | 2 luabind trivial (direction, position field reads) + pure math
--- @src xray/script_game_object_script2.cpp:98 (direction)
--- @param npc game_object
--- @param target_pos vector world position the NPC should be facing
--- @return number degrees in [0, 180]
function xcombat.get_facing_offset(npc, target_pos)
    local dir = xcombat.get_facing(npc)
    local np = npc:position()
    local vx, vz = target_pos.x - np.x, target_pos.z - np.z
    local mag = math_sqrt(vx * vx + vz * vz)
    if mag < 1 then return 0 end
    local cos = (dir.x * vx + dir.z * vz) / mag
    if cos > 1 then cos = 1 elseif cos < -1 then cos = -1 end
    return math_deg(math_acos(cos))
end

--- True when the combatant is facing target_pos within cone_deg - the predicate view of get_facing_offset.
--- Negate it for the back-turned read; the cone stays caller policy.
--- @safety SAFE - see get_facing_offset (degenerate target position reads as facing, offset 0)
--- @cost O(1) | get_facing_offset's 2 luabind trivial + pure math
--- @param obj game_object combatant (stalker or actor)
--- @param target_pos vector world position asked about
--- @param cone_deg number half-cone in degrees the facing must fall within
--- @return boolean true when the facing offset is at or under cone_deg
function xcombat.is_facing(obj, target_pos, cone_deg)
    return xcombat.get_facing_offset(obj, target_pos) <= cone_deg
end

-- NPC control: set_combat owns weapon mode + posture + movement + fire discipline; set_destination owns destination.

-- The combat-state matrix [fire][posture][movement] -> the one state_lib state bundling exactly those knobs; a missing cell = no such engine state.
local COMBAT_STATES = {
    FIRE = {
        STAND  = { STILL = "threat_fire", WALK = "raid_fire", RUN = "assault_fire" },
        CROUCH = { STILL = "hide_fire",   WALK = "sneak_fire" },
    },
    SNIPE = {
        STAND  = { STILL = "threat_sniper_fire" },
        CROUCH = { STILL = "hide_sniper_fire" },
    },
    READY = {
        STAND  = { STILL = "threat_na", WALK = "raid",  RUN = "assault" },
        CROUCH = { STILL = "hide_na",   WALK = "sneak" },
    },
    STOW = {
        STAND  = { RUN = "sprint" },
    },
}

-- Posture/movement keys into the engine move enum, looked up at call time so the module loads where move is absent (the validator stub).
local BODY_KEY = { STAND = "standing", CROUCH = "crouch" }
local MOVE_KEY = { STILL = "stand", WALK = "walk", RUN = "run" }

-- State for a (fire, posture, movement) combo, or nil when the engine ships none.
-- @cost O(1) | 0 luabind (nested table lookup)
local function _get_combat_state(fire, posture, movement)
    local by_fire = COMBAT_STATES[fire]
    local by_post = by_fire and by_fire[posture]
    return by_post and by_post[movement]
end

-- Set the sight at the committed target: the engine sight slot has NO expiry, so the previous owner's stare survives a planner block until this write.
-- Mirrors look_at_object (state_mgr_direction.script); the point_obj_dir stamp lets the direction evaluator's mode term pass once identity matches.
-- @cost O(1) | 2 luabind (id, set_sight; set_sight dedups engine-side when unchanged)
-- @src xray/sight_manager.cpp:242 (u32(-1) sight duration), anomaly/state_mgr.script:318 (the fire gate), xray/sight_action_inline.h:87-111 (operator==)
local function _set_committed_sight(npc, aim)
    local st = db.storage[npc:id()]
    local sm = st and st.state_mgr
    local point_dir = (sm ~= nil) and state_mgr_direction.look_object_type(npc, sm) or false
    if sm and sm.look_object == aim:id() then sm.point_obj_dir = point_dir end
    local torso_look = true
    local fire_object = not point_dir
    local no_pitch = false
    npc:set_sight(aim, torso_look, fire_object, no_pitch)
end

-- The engine's fire discipline: seen fires as asked (the vanilla kill_enemy order), blind consults fire_make_sense, else READY; reload degrades first.
-- Never gate the seen branch on can_kill_enemy: the engine never does, and measured 2026-07-12 it muted 73% of reads through normal sight lag.
-- @cost O(1) | 1-2 luabind (reload state) + 1 luabind (see) when seen; + the fire_make_sense reads when blind
-- @src xray/stalker_combat_actions.cpp:483-496 (seen -> fire), :906-914 (blind fire_make_sense); a fire goal on a reloading weapon cancels the reload
local function _resolve_fire(npc, requested, enemy)
    if xcombat.is_reloading(npc) then return xcombat.READY, "reloading" end
    if enemy and xcombat.can_see(npc, enemy) then return requested, "seen" end
    if enemy and xcombat.fire_make_sense(npc, enemy) then return requested, "memory" end
    return xcombat.READY, "hold"
end

--- Drive the NPC's combat state - the one command for weapon mode, posture, movement, and fire discipline.
--- opts.fire is the caller's INTENT, resolved through _resolve_fire before any state applies; returns false untouched on an unsupported combo.
--- @safety SAFE - returns false on an unsupported combo; the engine calls are SAFE_WRAPped
--- @cost O(1) | 1 state_mgr dispatch + 2 luabind trivial (set_body_state, set_movement_type); + the _resolve_fire reads on a FIRE/SNIPE intent
--- @src anomaly/state_lib.script (bundles), anomaly/state_mgr.script:503 (set_state), :319-321 (sniper_fire states = single shots, randomized 500-1500ms aim)
--- @src xray/script_game_object_script2.cpp:282-283 (body/movement)
--- @src xray/stalker_combat_actions.cpp:483-496 (seen -> fire, the anti-wall order), :906-914 (blind fire_make_sense)
--- @param npc game_object
--- @param opts table { fire = intent, posture, movement, enemy = game_object|nil, state = string|nil }
--- @return string|boolean applied fire ("FIRE"/"SNIPE"/"READY"/"STOW") when a state was applied, false when the combo has no state
--- @return string fire-gate verdict: "reloading"/"seen"/"memory"/"hold" when the intent was FIRE/SNIPE, "na" otherwise
function xcombat.set_combat(npc, opts)
    local intent = opts.fire
    local fire, gate = intent, "na"
    if intent == xcombat.FIRE or intent == xcombat.SNIPE then
        fire, gate = _resolve_fire(npc, intent, opts.enemy)
    end
    local state = opts.state or _get_combat_state(fire, opts.posture, opts.movement)
    if not state then return false, gate end
    local aim = (intent == xcombat.FIRE or intent == xcombat.SNIPE) and opts.enemy or nil
    state_mgr.set_state(npc, state, nil, nil, { look_object = aim }, { fast_set = true })
    if not opts.state then
        local body = BODY_KEY[opts.posture]
        if body then npc:set_body_state(move[body]) end
        local mvt = MOVE_KEY[opts.movement]
        if mvt then npc:set_movement_type(move[mvt]) end
    end
    if fire == "STOW" then
        npc:set_sight(look.path_dir, nil, 0)
    end
    if aim then
        _set_committed_sight(npc, aim)
    end
    return fire, gate
end

-- Geometric queries

-- Ray heights above npc:position() (the feet), probe-grounded (2026-08-04); every combat ray takes its height from HERE, never a literal.
xcombat.BODY_Y = {
    CROUCH_EYE = 0.93,
    LANE       = 1.20,
    CHEST      = 1.51,
    STAND_EYE  = 1.59,
}
local BODY_Y = xcombat.BODY_Y
-- rqtBoth (xr_collide_defs.h:72-76): baked geometry PLUS game objects; a static-only ray passes through cover a bullet cannot.
local RQ_BOTH = 3
-- rqtStatic (xr_collide_defs.h:72-76): baked level geometry ONLY - the pure wall test, where a body or crate must not count as a blocker.
local RQ_STATIC = 2
local SELF_CLEARANCE_M       = 1.0
local ENEMY_BODY_CLEARANCE_M = 0.75

--- The ONE object-aware (rqtBoth) clearance ray: true when a wall or game object blocks the straight line from a to b.
--- Heights are DATA (BODY_Y), never literals: opts.from_y / opts.to_y are required, opts.self_clear / opts.target_clear trim the ends.
--- @safety SAFE - get_distance returns 0 when nothing is hit
--- @cost O(1) | 6 luabind (ray_pick ctor + set_flags/position/direction/range + query spatial scan + get_distance)
--- @src xray/level_script.cpp:2633 (CRayPick), xray/xrCDB/xr_collide_defs.h:72-76 (rqtBoth = rqtObject | rqtStatic)
--- @src xray/ai/stalker/ai_stalker_fire.cpp:171,208,232 (the engine fires from eye_matrix.c - why a shot ray starts at an eye height)
--- @param a vector start position (feet); lifted by opts.from_y
--- @param b vector end position (feet); lifted by opts.to_y
--- @param opts table { from_y = BODY_Y.*, to_y = BODY_Y.*, self_clear = metres|nil, target_clear = metres|nil }
--- @return boolean true when the line is blocked
function xcombat.is_line_blocked(a, b, opts)
    local sc, tc = opts.self_clear or 0, opts.target_clear or 0
    local sy = a.y + opts.from_y
    local dx = b.x - a.x
    local dy = (b.y + opts.to_y) - sy
    local dz = b.z - a.z
    local dist = math_sqrt(dx*dx + dy*dy + dz*dz)
    local range = dist - sc - tc
    if range < 1 then return false end
    local ux, uy, uz = dx/dist, dy/dist, dz/dist
    local ray = ray_pick()
    ray:set_flags(opts.flags or RQ_BOTH)
    ray:set_position(vector():set(a.x + ux*sc, sy + uy*sc, a.z + uz*sc))
    ray:set_direction(vector():set(ux, uy, uz))
    ray:set_range(range)
    ray:query()
    local hit = ray:get_distance()
    return hit > 0 and hit < range - 1.0
end

--- True if a wall or game object blocks a MOVEMENT lane between two points - the run-lane test at the low LANE height.
--- A ~1m crate the navmesh routes through is caught; for a SHOT at an enemy use has_obstacle_to_target instead.
--- @safety SAFE - see is_line_blocked
--- @cost O(1) | 6 luabind (one is_line_blocked ray)
--- @param start_pos vector start (feet)
--- @param end_pos vector destination (feet)
--- @return boolean true if a wall or object blocks the lane
function xcombat.has_obstacle_between(start_pos, end_pos)
    return xcombat.is_line_blocked(start_pos, end_pos, { from_y = BODY_Y.LANE, to_y = BODY_Y.LANE, self_clear = SELF_CLEARANCE_M })
end

--- True when a static WALL (baked level geometry only) blocks the straight line from a to b, cast chest-to-chest.
--- Unlike has_obstacle_between a body, crate or NPC never counts, so a corpse pile never false-blocks; facing-independent (no vision cone).
--- @cost O(1) | one is_line_blocked ray (rqtStatic)
--- @param a vector start position (feet); lifted to chest
--- @param b vector end position (feet); lifted to chest
--- @return boolean true when a wall blocks the line
function xcombat.has_wall_between(a, b)
    return xcombat.is_line_blocked(a, b, { from_y = BODY_Y.CHEST, to_y = BODY_Y.CHEST, flags = RQ_STATIC, self_clear = SELF_CLEARANCE_M })
end

--- True if a wall or game object blocks the SHOT line from a firing position at eye height eye_y to the target's CHEST.
--- The ray stops ENEMY_BODY_CLEARANCE_M short so the target's own body and the cover it hugs are never the blocker; eye_y names the posture.
--- @safety SAFE - see is_line_blocked
--- @cost O(1) | 6 luabind (one is_line_blocked ray)
--- @param start_pos vector firing position (feet); the ray starts at eye_y over it
--- @param target_pos vector target position (feet); the ray aims at CHEST and stops short of the body
--- @param eye_y number the shooter's eye height (BODY_Y.STAND_EYE or BODY_Y.CROUCH_EYE)
--- @return boolean true if the shot is blocked before it reaches the target
function xcombat.has_obstacle_to_target(start_pos, target_pos, eye_y)
    return xcombat.is_line_blocked(start_pos, target_pos, { from_y = eye_y, to_y = BODY_Y.CHEST, self_clear = SELF_CLEARANCE_M, target_clear = ENEMY_BODY_CLEARANCE_M })
end

--- DEFENSIVE hide read: from lvid, is a static wall in the way at CROUCH height toward dir (0 = walled/hidden, 1 = open/exposed).
--- NOT a line of fire - it never traces to the enemy; confirm any shot with a raycast. Sign tested in game 2026-08-02.
--- @safety SAFE - the engine returns 0 for an invalid vertex; nil-guarded to 0
--- @cost O(1) | 1 luabind trivial (baked quadtree lookup + yaw interpolation, ~40ns)
--- @src xray/level_script.cpp:363 (bind), :371 (yaw-only getHP), xray/level_graph_vertex_inline.h:649-660 (interp NORMALIZE_NODE_COVER_LOW quadrant bytes)
--- @param lvid number level vertex id
--- @param dir vector direction to read toward (yaw used, pitch discarded)
--- @return number 0 = walled/hidden crouched, 1 = open/exposed (higher = more exposed)
function xcombat.get_crouch_openness(lvid, dir)
    return level.low_cover_in_direction(lvid, dir) or 0
end

--- The standing twin of get_crouch_openness: same baked, yaw-only, static read, same 0..1 meaning, same limit (NOT a line of fire).
--- Read both to classify the spot: crouch walled + stand open = a waist-high wall; both walled = tall wall; both open = no cover.
--- @safety SAFE - the engine returns 0 for an invalid vertex; nil-guarded to 0
--- @cost O(1) | 1 luabind trivial (baked quadtree lookup + yaw interpolation, ~40ns)
--- @src xray/level_script.cpp:351 (bind), :359 (yaw-only getHP), xray/level_graph_vertex_inline.h:636-647 (interp NORMALIZE_NODE_COVER_HIGH quadrant bytes)
--- @param lvid number level vertex id
--- @param dir vector direction to read toward (yaw used, pitch discarded)
--- @return number 0 = walled/hidden standing, 1 = open/exposed (higher = more exposed)
function xcombat.get_stand_openness(lvid, dir)
    return level.high_cover_in_direction(lvid, dir) or 0
end

--- True when viewer has npc in his sight: facing within cone_deg of the NPC and the shot line between them clear.
--- The one sight primitive; call it on event edges or feasibility checks, never per frame (it pays a raycast).
--- @safety SAFE - false when viewer is nil
--- @cost O(1) | 2 luabind (facing + positions) + 1 raycast
--- @param viewer game_object the entity whose sight is asked (db.actor for the player)
--- @param npc game_object the NPC asking whether viewer has him in his sight
--- @param cone_deg number viewer's facing offset to the NPC must be within this many degrees
--- @return boolean
function xcombat.is_in_sight(viewer, npc, cone_deg)
    if not viewer then return false end
    local npos = npc:position()
    if xcombat.get_facing_offset(viewer, npos) > cone_deg then return false end
    return not xcombat.has_obstacle_to_target(viewer:position(), npos, BODY_Y.STAND_EYE)
end

-- Project member onto the npc->enemy firing axis; true if it sits ahead and within the lateral band.
-- axis = { npc_pos, nx, nz, dist, thresh_sqr }, precomputed once by the caller.
-- @cost O(1) | 0 luabind (pure vector field math)
local function _is_on_line(member_pos, axis)
    local mx = member_pos.x - axis.npc_pos.x
    local mz = member_pos.z - axis.npc_pos.z
    local along = mx * axis.nx + mz * axis.nz
    if along <= 0 or along >= axis.dist then return false end
    local perp_x = mx - along * axis.nx
    local perp_z = mz - along * axis.nz
    return perp_x*perp_x + perp_z*perp_z < axis.thresh_sqr
end

-- One member check; lifted out so the loop body has no nested if-chain.
-- @cost O(1) | 2 luabind (level.object_by_id + alive) on hit; vector field access
local function _is_member_on_line(member_id, my_id, axis)
    if member_id == my_id then return false end
    local member = level_object_by_id(member_id)
    if not member or not member:alive() then return false end
    return _is_on_line(member:position(), axis)
end

--- True if any living squadmate sits roughly on the NPC -> enemy firing line within combat range.
--- Projects each member onto the firing axis; used to detect a friendly line-of-fire block before firing.
--- @safety SAFE - nil-guarded squad lookup, empty-squad returns false
--- @cost O(m) members | 1 luabind get_squad_by_member + 2 luabind per online member (object_by_id, alive)
--- @src anomaly/sim_squad_scripted.script (squad_members)
--- @param npc game_object
--- @param npc_pos vector NPC position
--- @param ene_pos vector enemy position
--- @param lateral_thresh_m number lateral half-width of the firing lane
--- @return boolean true if a squadmate blocks the lane
function xcombat.has_friendly_in_line(npc, npc_pos, ene_pos, lateral_thresh_m)
    local squad = xsquad.get_squad_by_member(npc:id())
    if not squad then return false end
    local dx = ene_pos.x - npc_pos.x
    local dz = ene_pos.z - npc_pos.z
    local dist = math_sqrt(dx*dx + dz*dz)
    if dist < 1 then return false end
    local axis = {
        npc_pos = npc_pos, nx = dx / dist, nz = dz / dist,
        dist = dist, thresh_sqr = lateral_thresh_m * lateral_thresh_m,
    }
    local my_id = npc:id()
    for member_id in xsquad.iterate_member_ids(squad) do
        if _is_member_on_line(member_id, my_id, axis) then return true end
    end
    return false
end

-- Squared NPC-to-actor distance TTL cache; 5s bounds the radius-compare error to +-70m at worst-case closure, acceptable for a perceivability gate.
local ACTOR_DIST_TTL_MS = 5000
local _actor_dist_cache = {}

--- Squared distance from an NPC to the actor, TTL-cached per id (5s); radius-agnostic, so one shared cache serves all consumers.
--- Returns math.huge when there is no actor (menu, teardown), so a radius compare reads "far" instead of erroring.
--- @safety SAFE - nil-actor guarded (math.huge), npc is the caller's live object
--- @cost O(1) | 0 luabind cached; 3 luabind trivial on miss (2 position reads + distance)
--- @src xray/script_game_object_script2.cpp (position), the _weapon_kind_cache TTL precedent above
--- @param npc game_object
--- @return number squared distance in m^2, math.huge when no actor exists
function xcombat.get_actor_dist_sqr(npc)
    local id = npc:id()
    local tg = time_global()
    local entry = _actor_dist_cache[id]
    if entry and tg < entry.expires then return entry.dist_sqr end
    local actor = db.actor
    if not actor then return math_huge end
    local dist_sqr = npc:position():distance_to_sqr(actor:position())
    _clear_expired(_actor_dist_cache, tg)
    _actor_dist_cache[id] = { dist_sqr = dist_sqr, expires = tg + ACTOR_DIST_TTL_MS }
    return dist_sqr
end

-- Engine fire-gate wrappers: each probes its bind once (a capability probe, never a version compare) and carries a defined floor fallback.

-- Bind availability by name, probed once and cached for the session (the bind set is a property of the exe, immutable at runtime).
local _bind_ready = {}

-- True when the engine bind `name` exists on this exe's game_object.
-- @cost O(1) | 1 luabind trivial on the first probe (method lookup), 0 cached
local function _has_bind(npc, name)
    local ready = _bind_ready[name]
    if ready == nil then
        ready = type(npc[name]) == "function"
        _bind_ready[name] = ready
    end
    return ready
end

--- Per-NPC aim tuning: sight swing speed, fine-tracking cap, and target lead (set_aim_params, PR #594).
--- Negative components revert to the global ai_aim_* cvars; not serialized, re-set on npc_on_net_spawn. Floor: no-op, vanilla aim is the fallback.
--- @safety SAFE - nil-guarded, no-op below the bind
--- @cost O(1) | 1 luabind trivial (4 field writes) on the engine path, 0 on the floor
--- @src PR themrdemonized/xray-monolith#594; xray/ai_stalker.h:817-845 (sentinel fields), xray/sight_manager.cpp:80-101 (select_speed consumption)
--- @param npc game_object stalker
--- @param max_angle number radians in [0,PI], or negative for the global cvar - diffs above this swing at full speed (asserts if > PI)
--- @param min_angle number radians in [0,PI], or negative for the global cvar - diffs below this cap at min_speed (asserts if > PI)
--- @param min_speed number rad/s fine-tracking speed cap (negative = global cvar)
--- @param predict_time number seconds of target lead (negative = global cvar)
--- @return boolean true when the engine path applied, false on a floor exe (no-op)
function xcombat.set_aim_params(npc, max_angle, min_angle, min_speed, predict_time)
    if not npc or not _has_bind(npc, "set_aim_params") then return false end
    assert(not (max_angle > 3.14159265), "xcombat.set_aim_params: max_angle > PI (radians, bounded by PI; use <=0.785 or -1 for the global)")
    assert(not (min_angle > 3.14159265), "xcombat.set_aim_params: min_angle > PI (radians, bounded by PI; use <=0.785 or -1 for the global)")
    npc:set_aim_params(max_angle, min_angle, min_speed, predict_time)
    return true
end

--- Per-NPC vision acquisition factor (set_vision_speed, PR #594): 1.0 = vanilla, higher = seen faster, negative clamps to 0.
--- Shapes mid/long-range acquisition only; floor: no-op BY DESIGN (the only script substitute is a per-frame functor wrap, banned).
--- @safety SAFE - nil-guarded, no-op below the bind; the bind error-logs on a non-CCustomMonster (the actor)
--- @cost O(1) | 1 luabind trivial (field write) on the engine path, 0 on the floor
--- @src PR themrdemonized/xray-monolith#594; xray/visual_memory_manager.cpp:355-379 (composition), :360-361 (close-range skip)
--- @param npc game_object stalker or monster
--- @param factor number multiplier on vision-value accumulation (1.0 = vanilla)
--- @return boolean true when the engine path applied, false on a floor exe (no-op)
function xcombat.set_vision_speed(npc, factor)
    if not npc or not _has_bind(npc, "set_vision_speed") then return false end
    npc:set_vision_speed(factor)
    return true
end

--- Per-NPC view-DISTANCE factor - the RANGE twin of set_vision_speed: multiplies object_visible_distance's return.
--- 1.0 = vanilla, higher = detection begins farther out; composes with the per-state max_view_distance LTX multiplier. Floor: no-op.
--- @safety SAFE - nil-guarded, no-op below the bind; the bind error-logs on a non-CCustomMonster (the actor)
--- @cost O(1) | 1 luabind trivial (field write) on the engine path, 0 on the floor
--- @src n038 BIND_NPC_VIEW_DISTANCE (todo-demonized-exes.md); mirrors set_vision_speed
--- @param npc game_object stalker or monster
--- @param factor number multiplier on the effective visible distance (1.0 = vanilla)
--- @return boolean true when the engine path applied, false on a floor exe (no-op)
function xcombat.set_view_distance_factor(npc, factor)
    if not npc or not _has_bind(npc, "set_view_distance_factor") then return false end
    npc:set_view_distance_factor(factor)
    return true
end

--- Per-NPC fire-queue scaling (PR #603): size_k multiplies burst size (the engine clamps >= 1), interval_k the inter-burst pause.
--- Vanilla-combat-planner fire only (state_mgr fire states bypass select_queue_params); negative = vanilla, re-set on net_spawn. Floor: no-op.
--- @safety SAFE - nil-guarded, no-op below the bind
--- @cost O(1) | 1 luabind trivial (2 field writes) on the engine path, 0 on the floor
--- @src PR themrdemonized/xray-monolith#603; xray/stalker_combat_action_base.cpp:246-254 (apply), xray/ai/stalker/ai_stalker_inline.h:178-193 (fields/getters)
--- @param npc game_object stalker
--- @param size_k number burst-size scale (negative = vanilla queue)
--- @param interval_k number inter-burst interval scale (negative = vanilla queue)
--- @return boolean true when the engine path applied, false on a floor exe (no-op)
function xcombat.set_fire_queue_scale(npc, size_k, interval_k)
    if not npc or not _has_bind(npc, "set_fire_queue_scale") then return false end
    npc:set_fire_queue_scale(size_k, interval_k)
    return true
end

--- Per-NPC additive passive health-restore velocity: 0 = vanilla, higher = faster idle regeneration.
--- Distinct lever from the medkit heal action (an item consume; this is the standing velocity); re-set on npc_on_net_spawn. Floor: no-op.
--- @safety SAFE - nil-guarded, no-op below the bind
--- @cost O(1) | 1 luabind trivial (field write) on the engine path, 0 on the floor
--- @src xray/EntityCondition.cpp:642 (UpdateHealth applies m_fV_HealthRestore), :279 (alive gate); base health_restore_v anomaly/m_stalker.ltx:249
--- @param npc game_object stalker
--- @param boost number additive on the restore velocity (0 = vanilla)
--- @return boolean true when the engine path applied, false on a floor exe (no-op)
function xcombat.set_health_restore_boost(npc, boost)
    if not npc or not _has_bind(npc, "set_health_restore_boost") then return false end
    npc:set_health_restore_boost(boost)
    return true
end

--- Per-NPC hit-redirect selection lever (PR #636): the last attacker within falloff metres gets up to max subtracted from its selection cost.
--- A hit victim turns on the real hit signal - no forged sighting, fire still needs line of sight; max < 0 = the vanilla step. Floor: no-op.
--- @safety SAFE - nil-guarded, no-op below the bind
--- @cost O(1) | 1 luabind trivial (2 field writes) on the engine path, 0 on the floor
--- @src PR themrdemonized/xray-monolith#636 (merge 168a08654); xray/enemy_manager.cpp:149-167 (the hit term)
--- @param npc game_object stalker
--- @param max number peak cost bonus toward the last attacker (negative = vanilla step)
--- @param falloff number metres at which the bonus decays to 0 (<= 0 defaults to 60)
--- @return boolean true when the engine path applied, false on a floor exe (no-op)
function xcombat.set_hit_redirect(npc, max, falloff)
    if not npc or not _has_bind(npc, "set_hit_redirect") then return false end
    npc:set_hit_redirect(max, falloff)
    return true
end

--- Per-NPC override of the baked "prefers whoever sees me" selection pull (PR #637): vanilla subtracts 900 for the actor vs 300 for an NPC.
--- Each argument is independent; negative keeps that side vanilla, 0 removes the pull. Floor: no-op, the vanilla bias is the fallback.
--- @safety SAFE - nil-guarded, no-op below the bind
--- @cost O(1) | 1 luabind trivial (2 field writes) on the engine path, 0 on the floor
--- @src PR themrdemonized/xray-monolith#637 (merge 748833d63); xray/enemy_manager.cpp:175-184 (the sees-us terms)
--- @param npc game_object stalker
--- @param actor_bias number replaces the 900 actor-sees-us pull (negative = vanilla)
--- @param npc_bias number replaces the 300 npc-sees-us pull (negative = vanilla)
--- @return boolean true when the engine path applied, false on a floor exe (no-op)
function xcombat.set_visible_enemy_bias(npc, actor_bias, npc_bias)
    if not npc or not _has_bind(npc, "set_visible_enemy_bias") then return false end
    npc:set_visible_enemy_bias(actor_bias, npc_bias)
    return true
end

--- Per-NPC movement hold - the glide-stop lever: while true the mover routes into its Stand branch every frame, path and destination preserved.
--- THE CALLER OWNS CLEARING IT: a stale true holds the NPC planted indefinitely (clear on death/offline/feature-off). Floor: no-op.
--- @safety SAFE - nil-guarded, no-op below the bind; the bind error-logs on a non-stalker
--- @cost O(1) | 1 luabind trivial (field write) on the engine path, 0 on the floor
--- @src n040 BIND_NPC_MOVEMENT_HOLD (todo-demonized-exes.md); xray/stalker_movement_manager_base.cpp:432 (the Stand-branch gate)
--- @param npc game_object stalker
--- @param hold boolean true plants the NPC, false releases it
--- @return boolean true when the engine path applied, false on a floor exe (no-op)
function xcombat.set_movement_hold(npc, hold)
    if not npc or not _has_bind(npc, "set_movement_hold") then return false end
    npc:set_movement_hold(hold)
    return true
end


--- Scale a pending hit's damage inside a before-hit callback: shit.power = shit.power * factor.
--- factor > 1 amplifies, < 1 mitigates; subscribers compose by multiplying the shared field, and nil hit or factor is a no-op.
--- @safety SAFE - nil-guarded on both args; a pure Lua field write, no engine bind, works on every exe
--- @cost O(1) | 0 luabind of its own (a field read+write on the callback-delivered CScriptHit userdata)
--- @src xray/script_hit_script.cpp:35 (power def_readwrite); dispatched from anomaly/_g.script:1245 (npc_on_before_hit), :1237 (actor)
--- @param shit CScriptHit the hit object passed to the before-hit callback
--- @param factor number|nil the damage multiplier (nil = no change)
--- @return boolean true when a factor was applied, false when skipped
function xcombat.apply_hit_power(shit, factor)
    if not (shit and factor) then return false end
    shit.power = shit.power * factor
    return true
end

--- Scale the per-shot dispersion cone inside an npc_shot_dispersion callback: temp_disp.dispersion is multiplied by factor.
--- factor < 1 tightens the cone, > 1 loosens it; subscribers compose, and the engine returns the final value to its accuracy calc.
--- @safety SAFE - nil-guarded; a pure Lua field write, no engine bind, works on every exe
--- @cost O(1) | 0 luabind of its own (a plain table field read+write)
--- @src anomaly/_g.script:1213-1217 (GetWeaponAccuracy seeds temp_disp.dispersion, fires the callback); base cone xray/ai_stalker_fire.cpp:72-133
--- @param temp_disp table the shared { dispersion = number } table passed to the callback
--- @param factor number|nil the cone multiplier (nil = no change)
--- @return boolean true when a factor was applied, false when skipped
function xcombat.apply_dispersion(temp_disp, factor)
    if not (temp_disp and factor and temp_disp.dispersion) then return false end
    temp_disp.dispersion = temp_disp.dispersion * factor
    return true
end

local FIRE_BONE = "bip01_r_finger02"
-- u16 bone sentinel (BI_NONE); get_bone_id returns it when the skeleton lacks the bone.
local INVALID_BONE_ID = 65535
-- Lateral half-width of the friendly firing lane for the can_kill_member fallback (the proven takeover doctrine value).
local FRIENDLY_LANE_THRESH_M = 1.5

-- Fire origin: the weapon-hand bone position, STAND_EYE over the feet when the skeleton lacks the bone.
-- @src xray/ai_stalker_fire.cpp:208 (the engine fires from eye_matrix.c); rx_ff.check_in_los + utils_obj.safe_bone_pos precedents
-- @cost O(1) | 2-3 luabind trivial (get_bone_id + bone_position, or position)
local function _get_fire_origin(npc)
    if npc:get_bone_id(FIRE_BONE) ~= INVALID_BONE_ID then
        return npc:bone_position(FIRE_BONE)
    end
    local pos = npc:position()
    return vector():set(pos.x, pos.y + BODY_Y.STAND_EYE, pos.z)
end

-- Capped fire-clearance ray from origin toward the enemy chest; returns (blocker distance or nil when clear, distance to the chest).
-- Gap vs the engine ray: no transparency accumulation, so glass and bushes read as blockers the engine's own gate shoots through.
-- @cost O(1) | 6 luabind (ray_pick ctor + set_flags/position/direction/range + query + get_distance)
local function _get_fire_lane_hit(origin, enemy_pos)
    local dx = enemy_pos.x - origin.x
    local dy = (enemy_pos.y + BODY_Y.CHEST) - origin.y
    local dz = enemy_pos.z - origin.z
    local dist = math_sqrt(dx*dx + dy*dy + dz*dz)
    local range = dist - ENEMY_BODY_CLEARANCE_M - SELF_CLEARANCE_M
    if range <= 0 then return nil, dist end
    local ux, uy, uz = dx/dist, dy/dist, dz/dist
    local ray = ray_pick()
    ray:set_flags(RQ_BOTH)
    ray:set_position(vector():set(origin.x + ux*SELF_CLEARANCE_M, origin.y + uy*SELF_CLEARANCE_M, origin.z + uz*SELF_CLEARANCE_M))
    ray:set_direction(vector():set(ux, uy, uz))
    ray:set_range(range)
    ray:query()
    local hit = ray:get_distance()
    if hit > 0 and hit < range then return hit + SELF_CLEARANCE_M, dist end
    return nil, dist
end

--- True when the NPC's fire lane reaches the enemy: the engine's posture-aware shot clearance (PR #596) or a capped clearance-ray floor.
--- NEVER a fire gate - the engine never gates fire on this read (measured 2026-07-12: 73% blocked); a position/aim-quality question only.
--- @safety SAFE - nil-guarded; the bind returns false on a holstered NPC (ActiveItem guard in the bind)
--- @cost O(1) | engine: 1 luabind (frame-cached recompute) | fallback: ~9 luabind (bone origin + ray)
--- @src PR themrdemonized/xray-monolith#596; xray/ai/stalker/ai_stalker_fire.cpp:744-777 (safety fan), :802-823 (update_can_kill_info)
--- @param npc game_object stalker
--- @param enemy game_object the enemy to clear a shot against
--- @return boolean true when the shot lane is clear
function xcombat.can_kill_enemy(npc, enemy)
    if not (npc and enemy) then return false end
    if _has_bind(npc, "can_kill_enemy") then return npc:can_kill_enemy() end
    local hit_m = _get_fire_lane_hit(_get_fire_origin(npc), enemy:position())
    return hit_m == nil
end

--- True when a NON-ENEMY sits in the NPC's fire lane - a REPOSITIONING HINT, never a hold-fire gate.
--- The engine's own friendly-fire hold (CObjectActionFire) survives a planner block and already stops the shot; the floor sees squadmates only.
--- @safety SAFE - nil-guarded; the bind returns false on a holstered NPC (ActiveItem guard in the bind)
--- @cost O(1) engine (frame-cached) | O(m) members fallback (has_friendly_in_line)
--- @src PR themrdemonized/xray-monolith#596; xray/ai/stalker/ai_stalker_fire.cpp:728-731 (non-enemy member); xray/object_actions.cpp:244-265 (engine hold)
--- @param npc game_object stalker
--- @param enemy_pos vector enemy position defining the fire lane (fallback axis; the engine path uses the live fire direction)
--- @return boolean true when a friendly/neutral blocks the lane (reposition; do not hold fire on it)
function xcombat.can_kill_member(npc, enemy_pos)
    if not (npc and enemy_pos) then return false end
    if _has_bind(npc, "can_kill_member") then return npc:can_kill_member() end
    return xcombat.has_friendly_in_line(npc, _get_fire_origin(npc), enemy_pos, FRIENDLY_LANE_THRESH_M)
end

-- Vanilla fire-gate values (ai_stalker_fire.cpp:65-68); post-floor exes expose them as the ai_fire_* cvars, probed once and read live when present.
local FIRE_EXT_M      = 2.5
local FIRE_HEIGHT_M   = 2.0
local FIRE_MIN_DIST_M = 2.5
local FIRE_UNSEEN_MS  = 10000
-- The ef_weapon_type classes the engine's unseen suppression window accepts (ai_stalker_fire.cpp:920-930); read from ini_sys, never a bind.
local AUTO_EF_WEAPON_TYPES = { [6] = true, [7] = true, [8] = true, [10] = true }

-- nil = unprobed; false = cvars absent (floor exe); true = cvars present (read live per call)
local _fire_cvars = nil

-- The 4 gate values: the live ai_fire_* cvars when the exe has them, the vanilla constants otherwise.
-- @cost O(1) | 0 luabind on the floor after the first probe, 5 luabind trivial per call when cvars exist
local function _get_fire_gate_values()
    if _fire_cvars == nil then
        _fire_cvars = get_console():get_string("ai_fire_range_extension") ~= nil
    end
    if not _fire_cvars then
        return FIRE_EXT_M, FIRE_HEIGHT_M, FIRE_MIN_DIST_M, FIRE_UNSEEN_MS
    end
    local console = get_console()
    local ext_m = console:get_float("ai_fire_range_extension")
    local height_m = console:get_float("ai_fire_max_height_diff")
    local min_dist_m = console:get_float("ai_fire_min_dist")
    local unseen_ms = console:get_integer("ai_fire_make_sense_interval")
    return ext_m, height_m, min_dist_m, unseen_ms
end

--- The engine fire-discipline gate: should this NPC pull the trigger on this enemy right now (PR #596, floor reproduces the engine gate order).
--- The BLIND-fire gate only: check see() first and fire unconditionally on seen (the vanilla kill_enemy order); never per frame.
--- @safety SAFE - nil-guarded; enemy must be a remembered object (a best_enemy is), per get_unseen_ms
--- @cost O(1) | engine: 1 luabind (internal frame cache) | fallback: ~15 luabind on the full path (positions + bone origin + ray + see + memory + weapon ini)
--- @src PR themrdemonized/xray-monolith#596; xray/ai/stalker/ai_stalker_fire.cpp:894-930 (gate order), :65-68 (vanilla values)
--- @src anomaly/xrs_debug_tools.script:1986 (ef_weapon_type read), sdk/ai/ai_add_cop_2.06/scripts/rx_combat.script:73,134 (see-gate precedent)
--- @param npc game_object stalker
--- @param enemy game_object the enemy under fire consideration
--- @return boolean true when firing at the enemy makes sense now
function xcombat.fire_make_sense(npc, enemy)
    if not (npc and enemy) then return false end
    if _has_bind(npc, "fire_make_sense") then return npc:fire_make_sense() end
    local ext_m, height_m, min_dist_m, unseen_ms = _get_fire_gate_values()
    local enemy_pos = enemy:position()
    if math_abs(npc:position().y - enemy_pos.y) > height_m then return false end
    local hit_m, dist_m = _get_fire_lane_hit(_get_fire_origin(npc), enemy_pos)
    local pick_m = hit_m or dist_m
    if pick_m + ext_m < dist_m then return false end
    if pick_m < min_dist_m then return false end
    if npc:see(enemy) then return true end
    if xcombat.get_unseen_ms(npc, enemy, time_global()) > unseen_ms then return false end
    local wpn = npc:best_weapon()
    if not wpn then return false end
    return AUTO_EF_WEAPON_TYPES[tonumber(ini_sys:r_string_ex(wpn:section(), "ef_weapon_type") or "")] == true
end

--- Register fn on the combat action-switch veto (npc_on_combat_action_switch, PR #595); set flags.allow = false to keep the current action.
--- Registers ONLY when the seam exists and returns whether it did; the denied proposal re-fires each brain update, so fn must be cheap.
--- @safety SAFE - registers only behind the functor probe, false on any floor/absent path
--- @cost O(1) | one-time registration, 2 table reads per repeat call
--- @src PR themrdemonized/xray-monolith#595; xray/action_planner_inline.h:111 (gated swap), xray gamedata callbacks_gameobject.script:423-427 (forwarder)
--- @param fn function subscriber fn(npc, from_op, to_op, flags)
--- @return boolean true when registered on the engine callback, false when this exe has no veto seam
function xcombat.on_action_switch(fn)
    if type(fn) ~= "function" then return false end
    if callbacks_gameobject == nil then return false end
    if type(rawget(_G, "CAI_Stalker__AllowCombatActionSwitch")) ~= "function" then return false end
    RegisterScriptCallback("npc_on_combat_action_switch", fn)
    return true
end

--- Register fn on the best-cover re-pick veto (npc_on_find_best_cover_repick); set flags.allow = false to keep the NPC's current cover.
--- Two invalidators are STANDING STATE (enemy inside 3m, gone loophole) and re-ask per brain update - keep fn cheap, cap any continuous deny.
--- @safety SAFE - registers only behind the functor probe, false on any absent path (no crash on old exes)
--- @cost O(1) | one-time registration, 2 table reads per repeat call
--- @src xray/ai/stalker/ai_stalker_cover.cpp best_cover() (AllowCoverRepick) + update_find_best_cover_actuality; xray gamedata callbacks_gameobject.script
--- @param fn function subscriber fn(npc, flags)
--- @return boolean true when registered on the engine callback, false when this exe has no veto seam
function xcombat.on_cover_repick(fn)
    if type(fn) ~= "function" then return false end
    if callbacks_gameobject == nil then return false end
    if type(rawget(_G, "CAI_Stalker__AllowCoverRepick")) ~= "function" then return false end
    RegisterScriptCallback("npc_on_find_best_cover_repick", fn)
    return true
end

-- Registers fn on one engine-forwarder callback behind the functor probe (the shared body of the registrars).
-- Registers ONLY when the forwarder exists on this exe and returns whether it did, so the caller self-gates on older builds.
-- @cost O(1) | one-time registration, 2 table reads per repeat call
local function _register_forwarded(fn, forwarder, callback_name)
    if type(fn) ~= "function" then return false end
    if callbacks_gameobject == nil then return false end
    if type(rawget(_G, forwarder)) ~= "function" then return false end
    RegisterScriptCallback(callback_name, fn)
    return true
end

--- Register fn on the cover-band minimum ask (npc_on_get_min_combat_dist): fn(npc, base_min, flags) writing flags.ret_value.
--- Fired on cover re-searches, never per frame; an invalid return is ignored engine-side and min > max is swapped.
--- @safety SAFE - registers only behind the functor probe, false on any absent path
--- @cost O(1) | one-time registration; the handler pays only on cover re-searches
--- @src xray/ai/stalker/ai_stalker_cover.cpp:91-150 (compute_enemy_distances), :282-298; xray gamedata callbacks_gameobject.script:496-505 (forwarder)
--- @param fn function subscriber fn(npc, base_min, flags) writing flags.ret_value
--- @return boolean true when registered, false when this exe has no combat-distance seam
function xcombat.on_get_min_combat_dist(fn)
    return _register_forwarded(fn, "CAI_Stalker__GetMinCombatDist", "npc_on_get_min_combat_dist")
end

--- Register fn on the cover-band maximum ask (npc_on_get_max_combat_dist): fn(npc, base_max, flags).
--- Same seam, cadence, and flags contract as on_get_min_combat_dist; base_max carries the engine's weapon-typed value.
--- @safety SAFE - registers only behind the functor probe, false on any absent path
--- @cost O(1) | one-time registration; the handler pays only on cover re-searches
--- @src xray/ai/stalker/ai_stalker_cover.cpp:91-150 (compute_enemy_distances); xray gamedata callbacks_gameobject.script:507-515 (forwarder)
--- @param fn function subscriber fn(npc, base_max, flags) writing flags.ret_value
--- @return boolean true when registered, false when this exe has no combat-distance seam
function xcombat.on_get_max_combat_dist(fn)
    return _register_forwarded(fn, "CAI_Stalker__GetMaxCombatDist", "npc_on_get_max_combat_dist")
end

--- Register fn on the NPC reload-start edge (npc_on_weapon_reload_start): fn(npc, wpn), fired on every reload path.
--- Replaces per-NPC get_state polling with the exact edge; the actor never fires it (actor_on_weapon_reload covers him).
--- @safety SAFE - registers only behind the functor probe, false on any absent path
--- @cost O(1) | one-time registration, 2 table reads per repeat call
--- @src xray/Weapon.cpp CWeapon::OnStateSwitch (reload-edge functors); xray gamedata callbacks_gameobject.script (forwarder)
--- @param fn function subscriber fn(npc, wpn)
--- @return boolean true when registered, false when this exe has no reload-event seam
function xcombat.on_reload_start(fn)
    return _register_forwarded(fn, "CAI_Stalker__OnWeaponReloadStart", "npc_on_weapon_reload_start")
end

--- Register fn on the NPC reload-stop edge (npc_on_weapon_reload_stop): fn(npc, wpn), fired when the weapon leaves the reload state.
--- BEST-EFFORT: a weapon detached mid-reload fires nothing, so bound edge-tracked state with a staleness window or confirm with is_reloading.
--- @safety SAFE - registers only behind the functor probe, false on any absent path
--- @cost O(1) | one-time registration, 2 table reads per repeat call
--- @src xray/Weapon.cpp CWeapon::OnStateSwitch (reload-edge functors); xray gamedata callbacks_gameobject.script (forwarder)
--- @param fn function subscriber fn(npc, wpn)
--- @return boolean true when registered, false when this exe has no reload-event seam
function xcombat.on_reload_stop(fn)
    return _register_forwarded(fn, "CAI_Stalker__OnWeaponReloadStop", "npc_on_weapon_reload_stop")
end

-- Movement targeting: the finders return a level vertex or nil, no side effects; _find_toward is the geometry primitive.

-- best_cover cost grows ~r^2 with the radius scanned and is worst on a no-cover result (radius 10 measured up to 2.7ms in dense cover).
local COVER_MIN_ENEMY_DIST = 1
local COVER_MAX_ENEMY_DIST = 30
local CONCEAL_THRESH       = 0.3
local COS_30               = 0.866
local STEP_DECREMENT_M     = 2
local PROBE_MIN_M          = 1
local PROBE_MAX_M          = 6
local PROBE_STEP_M         = 1
local PROBE_DIRS           = 8
local PROBE_ARC            = 2 * math.pi / PROBE_DIRS
local DEG_TO_RAD           = math.pi / 180

-- True if vid is in-range, accessible, not the NPC's own node, and free (or already ours).
-- Mirrors vanilla utils_obj.validate (the battle-tested validate+lmove pattern), reservation-aware.
-- @cost O(1) | 2 luabind (accessible medium, level_vertex_id trivial) + db read
local function _is_free(npc, vid)
    if not vid or vid >= INVALID_LVID then return false end
    if not npc:accessible(vid) then return false end
    if vid == npc:level_vertex_id() then return false end
    local owner = db.used_level_vertex_ids[vid]
    return owner == nil or owner == npc:id()
end

-- Nearest free accessible vertex toward dir, decreasing the step until one validates (the vanilla try_to_strafe pattern).
-- vertex_in_direction returns the origin on no-progress, which is rejected like nil.
-- @cost O(s/2) steps | up to step/2 luabind (vertex_in_direction trivial + accessible medium) each
local function _find_toward(npc, from_lvid, dir, step)
    local step_m = step
    while step_m >= STEP_DECREMENT_M do
        local vid = level.vertex_in_direction(from_lvid, dir, step_m)
        if vid and vid < INVALID_LVID and vid ~= from_lvid and _is_free(npc, vid) then return vid end
        step_m = step_m - STEP_DECREMENT_M
    end
    return nil
end

-- One probe: a free reachable vertex step metres from from_lvid along dir with a clear SHOT line to the enemy, or nil.
-- Object-aware: a crate between the vertex and the enemy disqualifies it, while the enemy's own body does not (the ray stops short).
-- @cost O(1) | 1 vertex_in_direction trivial + accessible medium + 1 raycast
local function _find_firing_vid(npc, from_lvid, dir, step, enemy_pos)
    local vid = level.vertex_in_direction(from_lvid, dir, step)
    if not vid or vid >= INVALID_LVID or vid == from_lvid or not _is_free(npc, vid) then return nil end
    if xcombat.has_obstacle_to_target(level.vertex_position(vid), enemy_pos, BODY_Y.STAND_EYE) then return nil end
    return vid
end

-- One ring of probes around a centre vertex: PROBE_DIRS directions at `step`, first with a clear shot wins.
-- @cost O(d) dirs | up to PROBE_DIRS (vertex_in_direction + accessible + raycast) per ring
local function _find_ring_vid(npc, from_lvid, step, enemy_pos)
    local dir = vector()
    for index = 0, PROBE_DIRS - 1 do
        local angle = index * PROBE_ARC
        local vid = _find_firing_vid(npc, from_lvid, dir:set(math_cos(angle), 0, math_sin(angle)), step, enemy_pos)
        if vid then return vid end
    end
    return nil
end

-- Sweep rings of increasing radius around a centre vertex for the nearest free vertex with a clear shot.
-- @cost O(r*d) | up to (rings*PROBE_DIRS) raycasts
local function _find_shot_vid(npc, from_lvid, enemy_pos)
    local step = PROBE_MIN_M
    while step <= PROBE_MAX_M do
        local vid = _find_ring_vid(npc, from_lvid, step, enemy_pos)
        if vid then return vid end
        step = step + PROBE_STEP_M
    end
    return nil
end

-- True when the baked cover point at `vid` is walled toward `dir` - hides from an enemy in that direction.
-- @cost O(1) | 2 baked cover reads
local function _is_concealed(vid, dir)
    local hi = xcombat.get_stand_openness(vid, dir)
    local lo = xcombat.get_crouch_openness(vid, dir)
    return (hi < lo and hi or lo) < CONCEAL_THRESH
end

-- True when reaching cover_pos means moving toward enemy_pos (best_cover's threat_on_the_way, cover_evaluators.cpp:172).
-- @cost O(1) | pure vector math
local function _is_toward_enemy(npc_pos, cover_pos, enemy_pos)
    local cx, cy, cz = cover_pos.x - npc_pos.x, cover_pos.y - npc_pos.y, cover_pos.z - npc_pos.z
    local cover_mag = math_sqrt(cx*cx + cy*cy + cz*cz)
    local ex, ey, ez = enemy_pos.x - npc_pos.x, enemy_pos.y - npc_pos.y, enemy_pos.z - npc_pos.z
    local threat_mag = math_sqrt(ex*ex + ey*ey + ez*ez)
    if cover_mag < 0.1 or threat_mag < 0.1 then return false end
    local proj = (cx*ex + cy*ey + cz*ez) / cover_mag
    if proj / threat_mag < COS_30 then return false end
    return proj <= cover_mag * 1.5
end

-- The fire/hide terminal check for a cover point that already passed the loop guards.
-- Returns a firing vertex beside it when shooting, the cover itself when hiding, or nil.
-- @cost O(rings) shoot / O(1) hide | _find_shot_vid or _is_concealed
local function _resolve_cover_vid(npc, enemy_pos, vid, cpos, firing, dir)
    if firing then return _find_shot_vid(npc, vid, enemy_pos) end
    dir:set(enemy_pos.x - cpos.x, enemy_pos.y - cpos.y, enemy_pos.z - cpos.z)
    return _is_concealed(vid, dir) and vid or nil
end

-- Best-hidden reachable cover (best_cover, distance-blind, with the engine's own floor/threat/distance guards).
-- firing=true sweeps for a firing vertex beside it; firing=false returns the cover point itself.
-- @cost O(covers-in-radius) + O(rings) when firing | 1 best_cover heavy, then the sweep only when firing
local function _find_best_cover(npc, enemy_pos, radius, search_pos, firing)
    local cover = npc:best_cover(search_pos, enemy_pos, radius, COVER_MIN_ENEMY_DIST, COVER_MAX_ENEMY_DIST)
    if not cover then return nil end
    local vid = cover:level_vertex_id()
    if firing then return _find_shot_vid(npc, vid, enemy_pos) end
    return vid
end

-- Nearest reachable cover (get_nearby_covers walk), guarded to his floor and never toward the enemy.
-- firing=true keeps the nearest whose firing vertex is clear; firing=false keeps the nearest that hides him.
-- @cost O(covers-in-radius) walk | per nearer candidate: _cover_candidate
local function _find_nearest_cover(npc, enemy_pos, radius, search_pos, firing)
    local covers = level.get_nearby_covers(search_pos, radius)
    local dir = vector()
    local best_vid, best_dist_sqr = nil, radius * radius + 1
    for vid in pairs(covers) do
        local cpos = level.vertex_position(vid)
        local dist_sqr = search_pos:distance_to_sqr(cpos)
        local dy = cpos.y - search_pos.y
        local chosen = dist_sqr < best_dist_sqr and dy < 3 and dy > -3
            and not _is_toward_enemy(search_pos, cpos, enemy_pos) and npc:accessible(vid)
            and _resolve_cover_vid(npc, enemy_pos, vid, cpos, firing, dir)
        if chosen then best_vid, best_dist_sqr = chosen, dist_sqr end
    end
    return best_vid
end

--- Find a cover vertex, four ways from two flags: opts.selection picks the search ("nearest" walk / "best" best_cover), opts.firing the purpose.
--- firing=true returns a vertex to SHOOT from (a positional ray check - the fire gates read only the current position), false one that HIDES.
--- @safety SAFE - nil when nothing qualifies; asserts on a missing opt
--- @cost see _find_best_cover / _find_nearest_cover | no raycasts on a hide search, ring-sweep raycasts on a shoot search
--- @src xray/script_game_object3.cpp:68 (best_cover), xray/level_script.cpp:329 (get_nearby_covers)
--- @param npc game_object
--- @param enemy_pos vector the enemy to fight or hide from
--- @param opts table { selection = "nearest"|"best", firing = boolean, radius = number, search_pos = vector }
--- @return number|nil cover vertex id, or nil
function xcombat.find_cover(npc, enemy_pos, opts)
    assert(opts and opts.firing ~= nil and opts.radius and opts.search_pos
        and (opts.selection == "nearest" or opts.selection == "best"),
        "xcombat.find_cover requires opts.selection ('nearest'|'best'), opts.firing (boolean), opts.radius, opts.search_pos")
    if opts.selection == "best" then
        return _find_best_cover(npc, enemy_pos, opts.radius, opts.search_pos, opts.firing)
    end
    return _find_nearest_cover(npc, enemy_pos, opts.radius, opts.search_pos, opts.firing)
end

-- One flee-lane probe: a free reachable vertex the full distance_m along dir AND a clear straight run lane out to it.
-- Unlike _find_firing_vid the ray is the NPC's own run lane, it tests objects too, and the vertex must reach the full distance.
-- @cost O(1) | 1 vertex_in_direction trivial + accessible medium + 1 raycast
local function _find_flee_lane(npc, own_lvid, npc_pos, dir, distance_m)
    local vid = level.vertex_in_direction(own_lvid, dir, distance_m)
    if not vid or vid >= INVALID_LVID or vid == own_lvid or not _is_free(npc, vid) then return nil end
    if xcombat.has_obstacle_between(npc_pos, level.vertex_position(vid)) then return nil end
    return vid
end

-- The validated flee fallback: the farthest reachable partial along dir whose run lane is ALSO clear, at decreasing lengths.
-- An accessibility-only fallback could send a flee straight into a tree trunk or crate the navmesh routes around.
-- @cost O(s/2) steps | up to step/2 (vertex_in_direction + accessible + raycast) each
local function _find_toward_clear(npc, own_lvid, npc_pos, dir, step)
    local step_m = step
    while step_m >= STEP_DECREMENT_M do
        local vid = _find_flee_lane(npc, own_lvid, npc_pos, dir, step_m)
        if vid then return vid end
        step_m = step_m - STEP_DECREMENT_M
    end
    return nil
end

-- Try one fan offset to both sides of away_dir (straight-away when offset is 0); the first side with a clear full-distance lane wins.
-- The XZ rotation of away_dir by +-offset is the 2D rotation matrix, no atan2.
-- @cost O(1) | up to 2 (vertex_in_direction + accessible + raycast)
local function _find_flee_lane_at(npc, own_lvid, npc_pos, away_dir, offset_deg, distance_m)
    local dir = vector()
    for side = 1, (offset_deg == 0 and 1 or 2) do
        local angle = (side == 1 and offset_deg or -offset_deg) * DEG_TO_RAD
        local cos_a, sin_a = math_cos(angle), math_sin(angle)
        dir:set(away_dir.x * cos_a - away_dir.z * sin_a, 0, away_dir.x * sin_a + away_dir.z * cos_a)
        local vid = _find_flee_lane(npc, own_lvid, npc_pos, dir, distance_m)
        if vid then return vid end
    end
    return nil
end

--- Flee destination: the heading nearest away_dir whose run lane is clear for the full distance_m.
--- Fans headings at full length, re-fans at half length (the boxed-in case), then takes the farthest CLEAR partial; nil when fully walled.
--- @safety SAFE - nil when no clear lane validates along away_dir at all
--- @cost O(n) headings | up to 2*(2*max_spread/arc + 1) (vertex_in_direction + accessible + raycast)
--- @src xray/level_script.cpp:410 (vertex_in_direction)
--- @param npc game_object
--- @param away_dir vector unit direction away from the danger
--- @param distance_m number required clear-lane length in metres
--- @param arc_deg number heading step between fanned candidates, degrees (>0)
--- @param max_spread_deg number maximum fan to either side of away_dir, degrees
--- @return number|nil flee destination vertex id, or nil when fully walled
function xcombat.find_flee_lane(npc, away_dir, distance_m, arc_deg, max_spread_deg)
    local own = npc:level_vertex_id()
    if not arc_deg or arc_deg <= 0 then
        return _find_toward(npc, own, away_dir, distance_m)
    end
    local npc_pos = npc:position()
    local offset_deg = 0
    while offset_deg <= max_spread_deg do
        local vid = _find_flee_lane_at(npc, own, npc_pos, away_dir, offset_deg, distance_m)
        if vid then return vid end
        offset_deg = offset_deg + arc_deg
    end
    local half_m = distance_m * 0.5
    if half_m >= STEP_DECREMENT_M then
        offset_deg = 0
        while offset_deg <= max_spread_deg do
            local vid = _find_flee_lane_at(npc, own, npc_pos, away_dir, offset_deg, half_m)
            if vid then return vid end
            offset_deg = offset_deg + arc_deg
        end
    end
    return _find_toward_clear(npc, own, npc_pos, away_dir, distance_m)
end

--- Move the NPC toward vid, routing to the nearest accessible node if vid itself is blocked.
--- Always sets a reachable destination and never fails, so a move maneuver never stalls on tight or indoor geometry.
--- @safety SAFE - always sets a valid dest (own node when vid invalid)
--- @cost O(1) | 1-2 luabind (accessible medium, accessible_nearest medium on miss, set_dest trivial)
--- @src anomaly/utils_obj.script(514) (send_to_nearest_accessible_vertex); accessible_nearest returns u32(-1) on an already-accessible position too
--- @param npc game_object
--- @param vid number desired destination vertex id
--- @return number the vertex the NPC was actually sent to
function xcombat.set_destination(npc, vid)
    if not vid or vid >= INVALID_LVID then
        local own = npc:level_vertex_id()
        npc:set_dest_level_vertex_id(own)
        return own
    end
    if not npc:accessible(vid) then
        local nvid = npc:accessible_nearest(level.vertex_position(vid), VEC_ZERO)
        if not nvid or nvid >= INVALID_LVID then
            local own = npc:level_vertex_id()
            npc:set_dest_level_vertex_id(own)
            return own
        end
        npc:set_dest_level_vertex_id(nvid)
        return nvid
    end
    npc:set_dest_level_vertex_id(vid)
    return vid
end

--- True when the NPC has reached its movement destination - the committed-maneuver arrival check.
--- The actual() term self-guards the new-destination race; meaningless for a hold maneuver (dest == own node reads trivially true).
--- @safety SAFE - path_completed is SAFE_WRAPped, returns false on a torn-down object
--- @cost O(1) | 1 luabind trivial (path_completed: m_path_state compare + actual flag read)
--- @src xray/script_game_object_script3.cpp:63 (binding), xray/movement_manager_inline.h:32 (m_path_state==ePathStatePathCompleted && actual)
--- @param npc game_object
--- @return boolean true when the path is complete and current
function xcombat.is_arrived(npc)
    return npc:path_completed()
end

--- Health as a 0..1 fraction (1 = full, 0 = dead) - the combat need's hurt input.
--- Wrapped so maneuver rows read health through xcombat; the "how low is hurt" threshold stays with the caller.
--- @safety SAFE - nil npc reads as full health (1), so a phantom object never trips a hurt-gated maneuver
--- @cost O(1) | 1 luabind trivial (health property read)
--- @src xray/script_game_object_script2.cpp:74 (.property("health", GetHealth/SetHealth) - 0..1 normalized condition health)
--- @param npc game_object
--- @return number health fraction 0..1
function xcombat.get_health_frac(npc)
    if not npc then return 1 end
    return npc.health
end

--- Add a signed delta to an NPC's 0..1 health fraction, clamped to [0,1] - the realized-damage correction seam.
--- A consumer reapplies a resist or boost to damage another system already dealt; no-op on a nil npc or zero delta.
--- @safety SAFE - nil/zero guarded, clamps to [0,1]; caller guards liveness (a positive delta would raise a 0-health object above dead)
--- @cost O(1) | 1 luabind trivial (set_health_ex)
--- @src xray/script_game_object_script2.cpp:74 (.property("health", GetHealth/SetHealth); set_health_ex the mutable write)
--- @param npc game_object
--- @param delta number signed health fraction to add (heal > 0, harm < 0)
function xcombat.add_health_frac(npc, delta)
    if not npc or delta == 0 then return end
    local frac = npc.health + delta
    if frac < 0 then frac = 0 elseif frac > 1 then frac = 1 end
    npc:set_health_ex(frac)
end

--- True while this combatant is losing blood - the deteriorating-target input, the vanilla bleeding > 0 convention.
--- NPC receivers mid-heal read true (the self-heal ticks park small residual rates); the actor's field carries no residue.
--- @safety SAFE - nil reads as not bleeding
--- @cost O(1) | 1 luabind trivial (bleeding property read)
--- @src xray/script_game_object_script2.cpp (.property("bleeding") - normalized bleed rate); anomaly dialogs.script:2275 (the > 0 convention)
--- @param obj game_object combatant (stalker or actor)
--- @return boolean true while the bleed rate is above zero
function xcombat.is_bleeding(obj)
    if not obj then return false end
    return obj.bleeding > 0
end

--- True while an engine hit flinch (the additive PlayHitMotion blend) is playing on this NPC.
--- Probed per compatibility standards; false on exes without the bind, so the term drops out of is_body_busy on release engines.
--- @safety SAFE - nil-guarded, no-op probe below the bind
--- @cost O(1) | 1 luabind trivial (clock compare in the engine) after the first probe
--- @src n037 HIT_ANIM_READ_VETO_AND_MOVE_HOLD (todo-demonized-exes.md); character_hit_animations stamp
--- @param npc game_object stalker
--- @return boolean true while a hit flinch is blending
function xcombat.is_flinching(npc)
    if not npc or not _has_bind(npc, "is_hit_anim_playing") then return false end
    return npc:is_hit_anim_playing()
end

--- True exactly while the critical-hit stagger animation plays (critically_wounded is NOT the wounded-down state IsWounded).
--- Consumers PAUSE on it (animation plays, action waits); only IsWounded justifies ending work.
--- @safety SAFE - nil-guarded
--- @cost O(1) | 1 luabind trivial
--- @src xray/ai_stalker_fire.cpp:1244-1320 (set/clear lifecycle), xray/stalker_animation_global.cpp:42-96 (the global-channel stagger)
--- @param npc game_object stalker
--- @return boolean true while the stagger animation is playing
function xcombat.is_staggering(npc)
    if not npc then return false end
    return npc:critically_wounded()
end

--- True while a transient animation OWNS this body - the "never act on an animating body" gate.
--- Three terms, cheapest first: the stagger, a script animation overlay (animation_count), the probed hit flinch; gate BODY WRITERS on it.
--- @safety SAFE - nil-guarded
--- @cost O(1) | 2 luabind trivial + 1 probed read, worst case
--- @param npc game_object stalker
--- @return boolean true while the body is owned by a transient animation
--- @return string|nil which term tripped ("stagger"/"overlay"/"flinch"), nil when free - the consumer's trace breakdown
function xcombat.is_body_busy(npc)
    if not npc then return false end
    if xcombat.is_staggering(npc) then return true, "stagger" end
    if npc:animation_count() > 0 then return true, "overlay" end
    if xcombat.is_flinching(npc) then return true, "flinch" end
    return false
end

-- CWeapon::eReload = 7 (Weapon.h:183-185); NOT 5 - the vanilla actor_effects.script "== 5" compare is eFire.
local WPN_STATE_RELOAD = 7

--- True while the NPC's active weapon is in the reload state - the authoritative reload read.
--- Polls the weapon state machine, so it works on every exe (the reload edge events are the cheap signal this truth bounds).
--- @safety SAFE - nil-guarded active item, IsWeapon-typed before get_state
--- @cost O(1) | 2-3 luabind trivial (active_item: inventory field read; get_state: state field read)
--- @src xray/script_game_object_script3.cpp:511 (get_state bind), xray/Weapon.h:185 (eReload), xray/HudItem.h:50-55 (base states)
--- @param npc game_object stalker
--- @return boolean true when the active weapon is reloading
function xcombat.is_reloading(npc)
    local wpn = npc:active_item()
    return wpn ~= nil and IsWeapon(wpn) and wpn:get_state() == WPN_STATE_RELOAD
end

--- True when the combatant has no usable firearm in hands - a strapped, absent, or non-weapon active item cannot shoot.
--- A held knife counts as armed (w_melee is a fightable kind); how much a knife threatens at range stays a caller judgement.
--- @safety SAFE - nil-guarded; false only when a real weapon is in hands
--- @cost O(1) | 1-2 luabind trivial (active_item field read + IsWeapon class check)
--- @src xray/script_game_object2.cpp (active_item all-class)
--- @param obj game_object combatant (stalker or actor)
--- @return boolean true when no usable weapon is in hands
function xcombat.is_unarmed(obj)
    if not obj then return false end
    local wpn = obj:active_item()
    return not wpn or not IsWeapon(wpn)
end

--- True while the active weapon's magazine is empty - no round to fire until a reload completes.
--- False when unarmed: no weapon means no magazine to be empty, is_unarmed owns that case.
--- @safety SAFE - nil/non-weapon guarded to false
--- @cost O(1) | 2-3 luabind trivial (active_item, get_ammo_in_magazine)
--- @src xray/script_game_object_script2.cpp:184 (get_ammo_in_magazine bind), xray/object_property_evaluators.cpp:112-119 (the ready triple)
--- @param obj game_object combatant (stalker or actor)
--- @return boolean true when the magazine is empty
function xcombat.is_magazine_empty(obj)
    if not obj then return false end
    local wpn = obj:active_item()
    if not wpn or not IsWeapon(wpn) then return false end
    return wpn:get_ammo_in_magazine() == 0
end

--- True while the actor sprints - a weapon-down locomotion state, so he cannot fire until he drops out of it.
--- INSTANT-EXIT: cancelled the frame the player decides to fire, so never treat it as a multi-second window.
--- @safety SAFE - a pure engine state read, boolean by construction
--- @cost O(1) | 1 luabind trivial (actor_moving_state field read) + pure Lua bit test
--- @src xray/level_script.cpp:2617 (actor_moving_state), anomaly/_g.script actor_move_states (mcSprint)
--- @return boolean true while the actor sprints
function xcombat.is_actor_sprinting()
    return bit_and(level.actor_moving_state(), actor_move_states.mcSprint) ~= 0
end

--- True while the actor climbs a ladder - the weapon is away for the whole climb, and there is no instant exit.
--- @safety SAFE - a pure engine state read, boolean by construction
--- @cost O(1) | 1 luabind trivial (actor_moving_state field read) + pure Lua bit test
--- @src xray/level_script.cpp:2617 (actor_moving_state), anomaly/_g.script actor_move_states (mcClimb)
--- @return boolean true while the actor climbs
function xcombat.is_actor_climbing()
    return bit_and(level.actor_moving_state(), actor_move_states.mcClimb) ~= 0
end

--- The weapon-state reason this combatant cannot fire right now, or nil when the weapon is ready.
--- The ordered single-read form of is_unarmed / is_reloading / is_magazine_empty; extra terms stay the caller's business rule.
--- @safety SAFE - nil/non-weapon guarded; no error-log path on any receiver
--- @cost O(1) | 2-3 luabind trivial (active_item once, then state/ammo field reads)
--- @src xray/object_property_evaluators.cpp:112-119 (the ready triple), xray/script_game_object_script2.cpp:184 (get_ammo_in_magazine)
--- @param obj game_object combatant (stalker or actor)
--- @return string|nil "unarmed" | "reloading" | "magazine_empty", nil when the weapon can fire
function xcombat.get_weapon_block_term(obj)
    if not obj then return nil end
    local wpn = obj:active_item()
    if not wpn or not IsWeapon(wpn) then return "unarmed" end
    if wpn:get_state() == WPN_STATE_RELOAD then return "reloading" end
    if wpn:get_ammo_in_magazine() == 0 then return "magazine_empty" end
    return nil
end

-- Environment detection (indoor / outdoor)

xcombat.INDOOR_LEVELS = {
    labx8                 = true,
    jupiter_underground   = true,
    l03u_agr_underground  = true,
    l04u_labx18           = true,
    l08u_brainlab         = true,
    l10u_bunker           = true,
    l12u_sarcofag         = true,
    l12u_control_monolith = true,
    l13u_warlab           = true,
}

-- Indoor raycast geometry: rqtStatic only, so a crate or passing stalker never reads as a wall; cast from chest height.
local INDOOR_PROBE_Y     = BODY_Y.CHEST
-- Roof within 4m and >=2 of 4 cardinals walled within 5m; MIN_WALLS 1 false-flagged a spot under a tree branch beside a single wall.
local INDOOR_ROOF_M      = 4
local INDOOR_WALL_M      = 5
local INDOOR_MIN_WALLS   = 2
-- get_enclosure reach, probe-crystallized (31 snapshots 2026-08-08): a high hall ceiling still hits, open sky/ground reads no hit.
local ENC_ROOF_RANGE     = 18
local ENC_WALL_RANGE     = 40
-- a wall within this counts toward "building" (>=3) vs "tunnel" (2)
local ENC_BUILD_M        = 8

-- Distance to the first static-mesh hit from pos along dir within range, or nil.
-- @cost O(1) | 1 luabind (ray_pick ctor + query spatial scan + get_distance)
local function _get_static_dist(pos, dir, range)
    local ray = ray_pick()
    ray:set_flags(RQ_STATIC)
    ray:set_position(pos)
    ray:set_direction(dir)
    ray:set_range(range)
    ray:query()
    local hit = ray:get_distance()
    return (hit > 0 and hit <= range) and hit or nil
end

--- Measure enclosure geometry at pos: a roof up-ray plus 4 cardinal wall-rays, returning hit DISTANCES (nil = open).
--- The caller classifies from the raw distances and MUST cache by a position cell - never call it per frame.
--- @safety SAFE - world positions only, nil on a bad position
--- @cost O(1) | up to 5 ray_pick queries
--- @src AlifeSpooks probe 2026-08-08 (31 snapshots) - the ranges and thresholds
--- @param pos vector world position
--- @return table|nil { roof=dist|nil, walls={4 dists|nil}, nearest_wall=dist|nil, wall_count=int }
function xcombat.get_enclosure(pos)
    if not xmath.check_pos(pos) then return nil end
    local chest = vector():set(pos.x, pos.y + INDOOR_PROBE_Y, pos.z)
    local roof = _get_static_dist(chest, vector():set(0, 1, 0), ENC_ROOF_RANGE)
    local walls = {
        _get_static_dist(chest, vector():set( 1, 0,  0), ENC_WALL_RANGE),
        _get_static_dist(chest, vector():set(-1, 0,  0), ENC_WALL_RANGE),
        _get_static_dist(chest, vector():set( 0, 0,  1), ENC_WALL_RANGE),
        _get_static_dist(chest, vector():set( 0, 0, -1), ENC_WALL_RANGE),
    }
    local nearest, count = nil, 0
    for i = 1, 4 do
        local dist = walls[i]
        if dist and (not nearest or dist < nearest) then nearest = dist end
        if dist and dist <= ENC_BUILD_M then count = count + 1 end
    end
    return { roof = roof, walls = walls, nearest_wall = nearest, wall_count = count }
end

--- True if pos is inside tight geometry: an underground level, or a spot with a roof overhead AND enclosing walls.
--- A roof alone is not enough (a tree canopy is baked into the static mesh); a lone tree, awning, or rock overhang reads outdoor.
--- @safety SAFE - up to 5 ray_pick queries, no engine object required (world positions only)
--- @cost O(1) | 1 luabind on open ground (up-ray misses), up to 5 under a roof; seize-path only, never per frame
--- @src xray/xr_collide_defs.h:73 (rqtStatic = baked level mesh), xray/GamePersistent.cpp:285 (hemi rejected)
--- @param pos vector world position
--- @return boolean true if enclosed (underground level, or roofed-and-walled outdoor spot)
function xcombat.is_indoor(pos)
    if xcombat.INDOOR_LEVELS[level.name()] then return true end
    local enc = xcombat.get_enclosure(pos)
    if not enc or not enc.roof or enc.roof > INDOOR_ROOF_M then return false end
    local walls = 0
    for i = 1, 4 do
        local dist = enc.walls[i]
        if dist and dist <= INDOOR_WALL_M then walls = walls + 1 end
    end
    return walls >= INDOOR_MIN_WALLS
end

--- Enclosure state at a position: "underground" (the engine's whole-level flag), else "indoor" (is_indoor raycast), else "outdoor".
--- A below-ground spot on a surface level reads "indoor", not "underground" - no per-spot depth signal exists.
--- @safety SAFE - GetEvent nil-safe (returns nil when unset), is_indoor nil-safe on pos
--- @cost O(1) | 1 luabind (GetEvent) on an underground level; + the is_indoor raycast (<=5 ray_pick) on surface
--- @src anomaly/level_weathers.script(129) SetEvent("underground", level not in the atmosfear-weather set)
--- @src xray via xcombat.is_indoor (rqtStatic roof+wall raycast)
--- @param pos vector world position
--- @return string "outdoor" | "indoor" | "underground"
function xcombat.get_enclosure_state(pos)
    if GetEvent("underground") then return "underground" end
    if xcombat.is_indoor(pos) then return "indoor" end
    return "outdoor"
end

-- Cover graph reservation (wraps db.used_level_vertex_ids)

--- Reserve a level vertex for an owner in the shared cover table; false if already held by another.
--- Mirrors the vanilla cover-occupancy convention so AT NPCs do not stack on one vertex.
--- @safety SAFE - rejects invalid lvid and contested ownership
--- @cost O(1) | 0 luabind (db table write)
--- @src anomaly/db.script (used_level_vertex_ids)
--- @param lvid number level vertex id
--- @param owner_id number reserving NPC id
--- @return boolean true if reserved by this owner
function xcombat.register_cover(lvid, owner_id)
    if not lvid or lvid >= INVALID_LVID then return false end
    local owner = db.used_level_vertex_ids[lvid]
    if owner and owner ~= owner_id then return false end
    db.used_level_vertex_ids[lvid] = owner_id
    return true
end

--- Release a vertex reservation, but only if this owner holds it. Ownership-checked so a stale release never frees another NPC's cover.
--- @safety SAFE - no-op when nil or not owned
--- @cost O(1) | 0 luabind (db table write)
--- @src anomaly/db.script (used_level_vertex_ids)
--- @param lvid number level vertex id
--- @param owner_id number releasing NPC id
function xcombat.release_cover(lvid, owner_id)
    if not lvid then return end
    if db.used_level_vertex_ids[lvid] == owner_id then
        db.used_level_vertex_ids[lvid] = nil
    end
end

-- Squad spread

--- 0-based position of an NPC within its squad's member iteration order, stable per combat session.
--- Gives each member a distinct spread bucket instead of the global-id modulo, which clashed on shared id % bucket_count.
--- @safety SAFE - returns 0 for nil/absent squad or member not found
--- @cost O(m) members | alife_object + iter per call (called once per NPC at state init)
--- @src anomaly/sim_squad_scripted.script (squad_members)
--- @param squad_id number squad server id
--- @param npc_id number member id
--- @return number 0-based ordinal, 0 when unresolved
function xcombat.get_squad_ordinal(squad_id, npc_id)
    if not squad_id then return 0 end
    local squad = alife_object(squad_id)
    if not squad then return 0 end
    local i = 0
    for member_id in xsquad.iterate_member_ids(squad) do
        if member_id == npc_id then return i end
        i = i + 1
    end
    return 0
end
